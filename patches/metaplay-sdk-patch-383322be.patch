+            if (baseType == null)
+                throw new ArgumentNullException(nameof(baseType));
+            #if UNITY_EDITOR
+            // GetTypesDerivedFrom returns also implemented interfaces. Filter them out.
+            return UnityEditor.TypeCache.GetTypesDerivedFrom(baseType)
