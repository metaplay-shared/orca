diff --git a/MetaplaySDK/Client/Metaplay.Core.Tests/SimpleCsvReaderTests.cs b/MetaplaySDK/Client/Metaplay.Core.Tests/SimpleCsvReaderTests.cs
new file mode 100644
index 00000000..7e3e652a
--- /dev/null
+++ b/MetaplaySDK/Client/Metaplay.Core.Tests/SimpleCsvReaderTests.cs
@@ -0,0 +1,213 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core.Config;
+using NUnit.Framework;
+using System.Collections.Generic;
+using System.Text;
+
+namespace Metaplay.Core.Tests
+{
+    public class SimpleCsvReaderTests
+    {
+        List<List<string>> ParseCsv(string input, char separator = '\0')
+        {
+            byte[] bytes = Encoding.UTF8.GetBytes(input);
+            List<List<string>> rows = SimpleCsvReader.ReadAllRows(bytes, separator);
+            return rows;
+        }
+
+        [Test]
+        public void BasicSyntax()
+        {
+            List<List<string>> rows = ParseCsv(
+                "Foo,Bar\n" +
+                "123,456,\n" +
+                ",,\n");
+
+            Assert.That(rows, Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "Foo", "Bar" },
+                new List<string>{ "123", "456", "" },
+                new List<string>{ "", "", "" },
+            }));
+        }
+
+        [Test]
+        public void QuotedSyntax()
+        {
+            List<List<string>> rows = ParseCsv(
+                "\"Fo\"\"o\"\n" +
+                "\"\"\"Foo\"\n" +
+                "\"B\"\"ar\"\"\"\n" +
+                "\"123\",\"456,7\",\"\"\n");
+
+            Assert.That(rows, Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "Fo\"o" },
+                new List<string>{ "\"Foo" },
+                new List<string>{ "B\"ar\"" },
+                new List<string>{ "123", "456,7", "" },
+            }));
+        }
+
+        [Test]
+        public void QuotedNewline()
+        {
+            List<List<string>> rows = ParseCsv(
+                "\"\"\"Foo\",\"B\"\"\n" +
+                "\"\"\"\n" +
+                "123,456\n");
+
+            Assert.That(rows, Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "\"Foo", "B\"\n\"" },
+                new List<string>{ "123", "456" },
+            }));
+        }
+
+        [Test]
+        public void TestMissingTrailingQuote()
+        {
+            Assert.Throws<ParseError>(() =>
+            {
+                ParseCsv("A;\"B");
+            });
+            Assert.Throws<ParseError>(() =>
+            {
+                ParseCsv("A;\"B\n");
+            });
+        }
+
+        [Test]
+        public void TestDataBetweenQuotedCellAndSeparator()
+        {
+            Assert.Throws<ParseError>(() => ParseCsv("A;B;C\n1;\"data\" ;"));
+            Assert.Throws<ParseError>(() => ParseCsv("A;B\n1;\"data\" "));
+            Assert.Throws<ParseError>(() => ParseCsv("A;B\n1;\"data\" \n"));
+        }
+
+        [Test]
+        public void TestQuoteInUnQuotedCell()
+        {
+            Assert.Throws<ParseError>(() =>
+            {
+                ParseCsv("A;QuoteIn\"UnquotedCell");
+            });
+        }
+
+        [Test]
+        public void TestNewlines()
+        {
+            Assert.That(ParseCsv("A;B\n\n"), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "A", "B" },
+                new List<string>{ "" },
+            }));
+
+            Assert.That(ParseCsv("\nA;B\n"), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "" },
+                new List<string>{ "A", "B" },
+            }));
+
+            Assert.That(ParseCsv("\r\n", separator: ';'), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "" },
+            }));
+
+            Assert.That(ParseCsv("A;B\n\n1;\n"), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "A", "B" },
+                new List<string>{ "" },
+                new List<string>{ "1", "" },
+            }));
+        }
+
+        [Test]
+        public void TestSeparatorDetectionComma()
+        {
+            Assert.That(ParseCsv("A,B,C\n1,2,3"), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "A", "B", "C" },
+                new List<string>{ "1", "2", "3" },
+            }));
+        }
+
+        [Test]
+        public void TestSeparatorDetectionSemicolon()
+        {
+            Assert.That(ParseCsv("A;B;C\n1;2;3"), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "A", "B", "C" },
+                new List<string>{ "1", "2", "3" },
+            }));
+        }
+
+        [Test]
+        public void TestSeparatorDetectionNoSeparators()
+        {
+            // No separators at all (single-column CSV) should default to comma
+            Assert.That(ParseCsv("A\n1\n2"), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "A" },
+                new List<string>{ "1" },
+                new List<string>{ "2" },
+            }));
+        }
+
+        [Test]
+        public void TestExplicitSeparator()
+        {
+            // Explicit separator overrides auto-detection; input has more commas but we force semicolon
+            Assert.That(ParseCsv("A,B;C,D\n1,2;3,4", separator: ';'), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "A,B", "C,D" },
+                new List<string>{ "1,2", "3,4" },
+            }));
+        }
+
+        [Test]
+        public void TestUtf8Content()
+        {
+            Assert.That(ParseCsv("Name;City\nAlice;Zürich\n日本;東京"), Is.EqualTo(new List<List<string>>
+            {
+                new List<string>{ "Name", "City" },
+                new List<string>{ "Alice", "Zürich" },
+                new List<string>{ "日本", "東京" },
+            }));
+        }
+
+        [Test]
+        public void TestUtf8Bom()
+        {
+            // UTF-8 BOM should be stripped and not appear in the first cell
+            byte[] csv = Encoding.UTF8.GetBytes("A;B\n1;2");
+            byte[] withBom = new byte[csv.Length + 3];
+            withBom[0] = 0xEF;
+            withBom[1] = 0xBB;
+            withBom[2] = 0xBF;
+            csv.CopyTo(withBom, 3);
+
+            List<List<string>> rows = SimpleCsvReader.ReadAllRows(withBom);
+            Assert.That(rows[0][0], Is.EqualTo("A"));
+            Assert.That(rows[0][1], Is.EqualTo("B"));
+        }
+
+        [Test]
+        public void TestRejectsUnsupportedFormats()
+        {
+            Assert.That(Assert.Throws<ParseError>(() => SimpleCsvReader.ReadAllRows(new byte[] { 0xFF, 0xFE, 0x00, 0x00 })).Message, Does.Contain("UTF-32 LE"));
+            Assert.That(Assert.Throws<ParseError>(() => SimpleCsvReader.ReadAllRows(new byte[] { 0x00, 0x00, 0xFE, 0xFF })).Message, Does.Contain("UTF-32 BE"));
+            Assert.That(Assert.Throws<ParseError>(() => SimpleCsvReader.ReadAllRows(new byte[] { 0xFF, 0xFE, 0x41, 0x00 })).Message, Does.Contain("UTF-16 LE"));
+            Assert.That(Assert.Throws<ParseError>(() => SimpleCsvReader.ReadAllRows(new byte[] { 0xFE, 0xFF, 0x00, 0x41 })).Message, Does.Contain("UTF-16 BE"));
+            Assert.That(Assert.Throws<ParseError>(() => SimpleCsvReader.ReadAllRows(new byte[] { 0x50, 0x4B, 0x03, 0x04 })).Message, Does.Contain("ZIP/XLSX"));
+            Assert.That(Assert.Throws<ParseError>(() => SimpleCsvReader.ReadAllRows(new byte[] { 0xD0, 0xCF, 0x11, 0xE0 })).Message, Does.Contain(".xls"));
+        }
+
+        [Test]
+        public void TestEmptyInput()
+        {
+            Assert.Throws<ParseError>(() => SimpleCsvReader.ReadAllRows(new byte[0]));
+        }
+    }
+}
