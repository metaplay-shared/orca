+        #region Tests about removing and restoring offers and offer groups from the config
+
+        // These tests focus on testing the behavior of removing offers/groups from the game config
+        // and then restoring them. The existing player states for those offers/groups should not
+        // be removed (and state should be restored upon restoration to config) until a "purge"
+        // operation is done. In normal server operation, the purge happens after the current config
+        // has been active for a certain amount of time, but in these tests we do it explicitly.
+
+        [Test]
+        public void RemoveAndRestoreOffer()
+        {
+            (PlayerModel player, MetaOfferTestsGameConfig gameConfig) = CreateInitial(new MetaOfferTestsGameConfig(
+                offers: new() { new("OfferX"), new("OfferY") },
+                offerGroups: new() { new("GroupA", new() { "OfferX", "OfferY" }) }
+            ));
+
+            // Purchase one offer (to have non-trivial offer state)
+            player.MetaOfferGroups.OnPurchasedOffer(gameConfig.OfferGroups[MetaOfferGroupId.FromString("GroupA")], gameConfig.Offers[MetaOfferId.FromString("OfferX")], player);
+
+            // Expected state: state exists for the group (containing the offers) and the offers individually
+            AssertOfferGroup(player, "GroupA", new() { ("OfferX", 1), ("OfferY", 0) });
+            AssertOffersPerPlayer(player, new() { ("OfferX", 1), ("OfferY", 0) });
+
+            // Remove OfferX from config
+            (player, gameConfig) = ChangeConfig(player, new MetaOfferTestsGameConfig(
+                offers: new() { new("OfferY") },
+                offerGroups: new() { new("GroupA", new() { "OfferY" }) }
+            ));
+
+            // Expected state: same as earlier except OfferX is gone
+            AssertOfferGroup(player, "GroupA", new() { ("OfferX", null), ("OfferY", 0) });
+            AssertOffersPerPlayer(player, new() { ("OfferX", null), ("OfferY", 0) });
+
+            // Restore OfferX to config
+            (player, gameConfig) = ChangeConfig(player, new MetaOfferTestsGameConfig(
+                offers: new() { new("OfferX"), new("OfferY") },
+                offerGroups: new() { new("GroupA", new() { "OfferX", "OfferY" }) }
+            ));
+
+            // Expected state: OfferX is back with same state as previously
+            AssertOfferGroup(player, "GroupA", new() { ("OfferX", 1), ("OfferY", 0) });
+            AssertOffersPerPlayer(player, new() { ("OfferX", 1), ("OfferY", 0) });
+        }
