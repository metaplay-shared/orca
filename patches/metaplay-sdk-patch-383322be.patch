+        /// <summary>
+        /// Check that state for group <paramref name="groupId"/> either exists (if <paramref name="offersMaybe"/> is not null)
+        /// or doesn't exist (if <paramref name="offersMaybe"/> is null) in the player state.
+        /// If <paramref name="offersMaybe"/> is not null, each offer in it is checked similarly:
+        /// for each listed offer, check that per-group state either exists and has the given per-group purchase count (if numPurchased is not null)
+        /// or doesn't exist.
+        /// </summary>
+        static void AssertOfferGroup(PlayerModel player, string groupId, List<(string offerId, int? numPurchased)> offersMaybe)
+        {
+            if (offersMaybe != null)
+            {
+                Assert.That(player.MetaOfferGroups.TryGetState(MetaOfferGroupId.FromString(groupId)), Is.Not.Null);
+
+                foreach ((string offerId, int? numPurchased) in offersMaybe)
+                {
+                    if (numPurchased.HasValue)
+                    {
+                        Assert.That(player.MetaOfferGroups.TryGetState(MetaOfferGroupId.FromString(groupId)).OfferStates, Does.ContainKey(MetaOfferId.FromString(offerId)));
+                        Assert.That(player.MetaOfferGroups.TryGetState(MetaOfferGroupId.FromString(groupId)).OfferStates[MetaOfferId.FromString(offerId)].NumPurchasedInGroup, Is.EqualTo(numPurchased.Value));
+                    }
+                    else
+                    {
+                        Assert.That(player.MetaOfferGroups.TryGetState(MetaOfferGroupId.FromString(groupId)).OfferStates, Does.Not.ContainKey(MetaOfferId.FromString(offerId)));
+                    }
+                }
+            }
+            else
+                Assert.That(player.MetaOfferGroups.TryGetState(MetaOfferGroupId.FromString(groupId)), Is.Null);
+        }
+
+        /// <summary>
+        /// Check that per-player state for each listed offer either exists and has the given per-player purchase count (if numPurchased is not null)
+        /// or doesn't exist.
+        /// </summary>
+        static void AssertOffersPerPlayer(PlayerModel player, List<(string offerId, int? numPurchased)> offers)
+        {
+            foreach ((string offerId, int? numPurchased) in offers)
+            {
+                if (numPurchased.HasValue)
+                {
+                    Assert.That(player.MetaOfferGroups.OfferStates, Does.ContainKey(MetaOfferId.FromString(offerId)));
+                    Assert.That(player.MetaOfferGroups.OfferStates[MetaOfferId.FromString(offerId)].NumPurchasedByPlayer, Is.EqualTo(numPurchased.Value));
+                }
+                else
+                {
+                    Assert.That(player.MetaOfferGroups.OfferStates, Does.Not.ContainKey(MetaOfferId.FromString(offerId)));
+                }
+            }
+        }
