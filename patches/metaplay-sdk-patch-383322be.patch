diff --git a/MetaplaySDK/Backend/Cloud/ProcFs/ProcFsMemInfoReader.cs b/MetaplaySDK/Backend/Cloud/ProcFs/ProcFsMemInfoReader.cs
new file mode 100644
index 00000000..35efe5fd
--- /dev/null
+++ b/MetaplaySDK/Backend/Cloud/ProcFs/ProcFsMemInfoReader.cs
@@ -0,0 +1,61 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+#nullable enable
+
+using System;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Text;
+
+namespace Metaplay.Cloud.ProcFs
+{
+    struct MemInfo
+    {
+        /// <summary>
+        /// MemTotal in /proc/meminfo. Converted to number of bytes.
+        /// </summary>
+        public ulong? MemTotal;
+    }
+
+    class MemInfoReader
+    {
+        public static MemInfo? TryRead()
+        {
+            if (!RuntimeInformation.IsOSPlatform(OSPlatform.Linux))
+                return null;
+
+            try
+            {
+                using FileStream file = new FileStream("/proc/meminfo", FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+                using StreamReader reader = new StreamReader(file, encoding: Encoding.ASCII, leaveOpen: true);
+                MemInfo memInfo = new MemInfo();
+
+                for (;;)
+                {
+                    string? line = reader.ReadLine();
+                    if (line == null)
+                        break;
+
+                    if (line.StartsWith("MemTotal:", StringComparison.Ordinal) && line.EndsWith(" kB", StringComparison.Ordinal))
+                    {
+                        string value = line.Substring("MemTotal:".Length, line.Length - "MemTotal:".Length - " kB".Length).Trim();
+                        if (ulong.TryParse(value, out ulong result))
+                        {
+                            checked
+                            {
+                                // KB to bytes
+                                memInfo.MemTotal = result * 1024;
+                            }
+                        }
+                    }
+                }
+
+                return memInfo;
+            }
+            catch
+            {
+                return null;
+            }
+        }
+    }
+}
