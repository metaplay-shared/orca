index 00000000..277be6b8
--- /dev/null
+++ b/MetaplaySDK/Frontend/EslintConfig/tests/component-name-casing-autofix.test.js
@@ -0,0 +1,88 @@
+import { readdir, readFile } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { ESLint } from 'eslint'
+import { describe, expect, it } from 'vitest'
+import pluginVue from 'eslint-plugin-vue'
+import pluginVuePug from 'eslint-plugin-vue-pug'
+import tsParser from '@typescript-eslint/parser'
+
+import disableAutofix from '../plugin/disableAutofix.js'
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url))
+const fixturesRoot = path.join(__dirname, 'fixtures', 'component-name-casing-autofix')
+
+/**
+ * The built-in vue/component-name-in-template-casing fixer emits HTML open/close tags
+ * (`<PascalCase>...</PascalCase>`) which destroys Pug templates.
+ *
+ * We wrap the rule with `disableAutofix` to keep the error report but strip the fixer.
+ * This test verifies that `--fix` does not modify the input (no broken output).
+ */
+
+const originalRule = pluginVue.rules['component-name-in-template-casing']
+
+const eslint = new ESLint({
+  fix: true,
+  ignore: false,
+  overrideConfigFile: true,
+  overrideConfig: [
+    ...pluginVue.configs['flat/recommended'],
+    ...pluginVuePug.configs['flat/recommended'],
+    {
+      files: ['**/*.vue'],
+      languageOptions: {
+        parserOptions: {
+          parser: tsParser,
+          extraFileExtensions: ['.vue'],
+        },
+      },
+      plugins: {
+        'vue-nf': {
+          rules: {
+            'component-name-in-template-casing': disableAutofix(originalRule),
+          },
+        },
+      },
+      rules: {
+        'vue/component-name-in-template-casing': 'off',
+        'vue-nf/component-name-in-template-casing': ['error', 'PascalCase', { registeredComponentsOnly: false }],
+        'vue/multi-word-component-names': 'off',
+        'vue/attribute-hyphenation': 'off',
+      },
+    },
+  ],
+})
+
+function normalize(text) {
+  return text.replace(/\r\n/g, '\n').trimEnd()
+}
+
+const caseDirs = (await readdir(fixturesRoot, { withFileTypes: true }))
+  .filter((entry) => entry.isDirectory())
+  .map((entry) => entry.name)
+  .sort()
+
+describe('vue/component-name-in-template-casing with disableAutofix', () => {
+  it.each(caseDirs)('%s: --fix should not modify input', async (caseName) => {
+    const inputPath = path.join(fixturesRoot, caseName, 'input.vue')
+    const input = await readFile(inputPath, 'utf8')
+
+    const results = await eslint.lintText(input, { filePath: inputPath })
+    const actual = results[0]?.output ?? input
+
+    expect(normalize(actual)).toBe(normalize(input))
+  })
+
+  it.each(caseDirs)('%s: should still report errors', async (caseName) => {
+    const inputPath = path.join(fixturesRoot, caseName, 'input.vue')
+    const input = await readFile(inputPath, 'utf8')
+
+    const results = await eslint.lintText(input, { filePath: inputPath })
