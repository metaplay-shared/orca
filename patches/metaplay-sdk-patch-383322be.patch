+ * ```pug
+ * //- Default size
+ * MInputSingleSelectDropdown(
+ *   v-model="selected"
+ *   label="Default Dropdown"
+ *   :options="options"
+ *   )
+ *
+ * //- Small size
+ * MInputSingleSelectDropdown(
+ *   v-model="selected"
+ *   label="Small Dropdown"
+ *   size="small"
+ *   :options="options"
+ *   )
+ * ```
+ *
+ * ```typescript
+ * import { ref } from 'vue'
+ * import type { MInputSelectOption } from '@metaplay/meta-ui-next'
+ *
+ * // Define a list of options to pick from.
+ * const options = [
+ *   { label: 'Option 1', value: 'option1' },
+ *   { label: 'Option 2', value: 'option2' },
+ *   { label: 'Option 3', value: 'option3' },
+ * ] as const satisfies MInputSelectOption[]
+ *
+ * // Keep track of the current selection in a reactive reference.
+ * const selected = ref<string>('option1')
+ * ```
+ * </details>
+ */
+export const Size: Story = {
+  render: (args) => ({
+    components: { MInputSingleSelectDropdown },
+    setup: () => {
+      const selected = ref(args.modelValue)
+      watch(
+        () => args.modelValue,
+        (value) => {
+          selected.value = value
+        }
+      )
+      return { args, selected }
+    },
+    template: `
+      <div class="tw-space-y-4">
+        <MInputSingleSelectDropdown v-model="selected" label="Default Dropdown" :options="args.options" placeholder="Default size dropdown" />
+        <MInputSingleSelectDropdown v-model="selected" label="Small Dropdown" size="small" :options="args.options" placeholder="Small size dropdown" />
+        <pre class="tw-mt-2">Selected: {{ selected }}</pre>
+      </div>
+    `,
+  }),
+  args: {
+    modelValue: 'option1',
+    options: [
+      { label: 'Option 1', value: 'option1' },
+      { label: 'Option 2', value: 'option2' },
+      { label: 'Option 3', value: 'option3' },
+    ],
+  },
+}
