@@ -437,3 +437,59 @@ export const NoLabel: Story = {
     label: undefined,
   },
 }
+
+/**
+ * Adjust the size of the input using the size prop. Use the 'small' size for more compact layouts.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * //- Default size
+ * MInputText(
+ *   model-value="content"
+ *   @update:model-value="(newValue) => content = newValue"
+ *   label="Default Input"
+ *   )
+ *
+ * //- Small size
+ * MInputText(
+ *   model-value="content"
+ *   @update:model-value="(newValue) => content = newValue"
+ *   label="Small Input"
+ *   size="small"
+ *   )
+ * ```
+ *
+ * ```typescript
+ * import { ref } from 'vue'
+ *
+ * // Keep track of the input value as a reactive reference.
+ * const content = ref('Sample text')
+ * ```
+ * </details>
+ */
+export const Size: Story = {
+  render: (args) => ({
+    components: { MInputText },
+    setup: () => {
+      const content = ref(args.modelValue)
+      watch(
+        () => args.modelValue,
+        (value) => {
+          content.value = value
+        }
+      )
+      return { args, content }
+    },
+    template: `
+      <div class="tw-space-y-4">
+        <MInputText v-model="content" label="Default Input" placeholder="Default size input" />
+        <MInputText v-model="content" label="Small Input" size="small" placeholder="Small size input" />
+        <pre class="tw-mt-2">Output: {{ content }}</pre>
+      </div>
+    `,
+  }),
+  args: {
+    modelValue: 'Sample text',
+  },
+}
