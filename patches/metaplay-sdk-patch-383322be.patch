diff --git a/MetaplaySDK/Frontend/MetaUiNext/src/composites/MNoSeatbelts.stories.ts b/MetaplaySDK/Frontend/MetaUiNext/src/composites/MNoSeatbelts.stories.ts
new file mode 100644
index 00000000..1ca53314
--- /dev/null
+++ b/MetaplaySDK/Frontend/MetaUiNext/src/composites/MNoSeatbelts.stories.ts
@@ -0,0 +1,148 @@
+import type { Meta, StoryObj } from '@storybook/vue3-vite'
+
+import MNoSeatbelts from './MNoSeatbelts.vue'
+
+/**
+ * Displays a standard warning/disclaimer for dangerous or irreversible actions.
+ *
+ * Use this component to alert users before destructive operations like deleting data,
+ * resetting configurations, or performing irreversible administrative actions.
+ * The warning includes a bold title and target name highlighting.
+ *
+ * The default slot allows you to add custom content in place of the default warning message.
+ */
+const meta: Meta<typeof MNoSeatbelts> = {
+  component: MNoSeatbelts,
+  tags: ['autodocs'],
+  argTypes: {
+    targetName: {
+      control: 'text',
+    },
+    default: {
+      control: false,
+    },
+  },
+  parameters: {
+    docs: {
+      canvas: {
+        sourceState: 'none',
+      },
+    },
+  },
+}
+
+export default meta
+type Story = StoryObj<typeof MNoSeatbelts>
+
+/**
+ * Default warning with the standard irreversible action message.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * MNoSeatbelts(target-name="Player123")
+ * ```
+ *
+ * ```typescript
+ * import { MNoSeatbelts } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
+export const Default: Story = {
+  args: {
+    targetName: 'Player123',
+  },
+}
+
+/**
+ * Custom warning message for a specific dangerous action.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * MNoSeatbelts
+ *   p This will reset the game configuration.
+ *   p Make sure you have exported a backup before proceeding.
+ * ```
+ *
+ * ```typescript
+ * import { MNoSeatbelts } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
+export const CustomMessage: Story = {
+  render: (args: Story['args']) => ({
+    components: { MNoSeatbelts },
+    setup: () => ({ args }),
+    template: `
+    <MNoSeatbelts v-bind="args">
+      <p>This will reset the game configuration.</p>
+      <p>Make sure you have exported a backup before proceeding.</p>
+    </MNoSeatbelts>
+    `,
+  }),
+  args: {},
+}
+
+/**
+ * Warning that highlights the specific target being affected.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * MNoSeatbelts(target-name="Player123") This player will be permanently banned.
+ * ```
+ *
+ * ```typescript
+ * import { MNoSeatbelts } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
+export const WithTargetName: Story = {
+  render: (args: Story['args']) => ({
+    components: { MNoSeatbelts },
+    setup: () => ({ args }),
+    template: `
+    <MNoSeatbelts v-bind="args">
+      This player will be permanently banned.
+    </MNoSeatbelts>
+    `,
+  }),
+  args: {
+    targetName: 'Player123',
+  },
+}
+
+/**
+ * Demonstrates that the component accepts class and style attributes for custom styling.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * MNoSeatbelts(
+ *   class="tw-mx-auto tw-mt-4 tw-max-w-xl"
+ *   target-name="your UI designer"
+ *   ) This demonstrates that class attributes work correctly.
+ * ```
+ *
+ * ```typescript
+ * import { MNoSeatbelts } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
