+
+  if (filterDescriptions.length > 0) {
+    const verb = displayMode === 'highlight' ? 'Highlighting' : 'Only showing'
+    if (filterDescriptions.length === 1) {
+      parts.push(`${verb} items that match ${filterDescriptions[0]}.`)
+    } else if (filterCondition === 'and') {
+      parts.push(`${verb} items that match all filters: ${filterDescriptions.join(', ')}.`)
+    } else {
+      parts.push(`${verb} items that match any filter: ${filterDescriptions.join(', ')}.`)
