+
+/**
+ * Long page titles are truncated with an ellipsis. Hover over the title to see the full text.
+ */
+export const TitleOverflow: Story = {
+  render: (args) => ({
+    components: {
+      MRootLayout,
+      MViewContainer,
+      MCard,
+      MSidebarSection,
+      MSidebarLink,
+    },
+    setup: () => {
+      const { title } = useHeaderbar()
+      title.value =
+        'This Is A Very Long Page Title That Should Be Truncated With An Ellipsis When It Exceeds The Available Width'
+
+      return {
+        args,
+      }
+    },
+    template: `
+      <MRootLayout v-bind="args">
+        <template #sidebar>
+          <div>
+            <MSidebarSection title="Section 1">
+              <MSidebarLink label="Link 1"></MSidebarLink>
+            </MSidebarSection>
+          </div>
+        </template>
+
+        <MViewContainer>
+          <MCard title="Example content">
+            <p>Long page titles are truncated with an ellipsis. Hover over the title in the header bar to see the full text.</p>
+          </MCard>
+        </MViewContainer>
+      </MRootLayout>
+    `,
+  }),
+  args: {
+    projectName: 'Project Name',
+    headerBadgeLabel: 'Anonymous Moomin',
+  },
+}
