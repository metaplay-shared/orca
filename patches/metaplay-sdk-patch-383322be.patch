+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Dapper;
+using Metaplay.Cloud.Persistence;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using NUnit.Framework;
+using System;
+using System.Collections.Generic;
+using System.ComponentModel.DataAnnotations;
+using System.Linq;
+using static System.FormattableString;
+
+namespace Metaplay.Cloud.Tests
+{
+    /// <summary>
+    /// Tests for bulk insert functionality including DatabaseItemSpec template generation
+    /// and ExtractMembers functionality.
+    /// </summary>
+    [TestFixture]
+    public class BulkInsertTests
+    {
+        #region Test Infrastructure
+
+        /// <summary>
+        /// Minimal mock DatabaseBackend for testing DatabaseItemSpec.
+        /// Uses SQLite SQL syntax. Only implements methods required for template construction.
+        /// </summary>
+        class TestDatabaseBackend : DatabaseBackend
+        {
+            public TestDatabaseBackend()
+                : base(numActiveShards: 1, shardSpecs: Array.Empty<DatabaseShardSpec>(), createGameDbContext: null)
+            {
+            }
+
+            public override DatabaseBackendType BackendType => DatabaseBackendType.Sqlite;
+
+            // SQL generation methods - must match DatabaseBackendSqlite to produce valid SQL
+            public override string GetInsertOrIgnoreSql() => "INSERT OR IGNORE";
+            public override string GetInsertOrReplaceSql() => "INSERT OR REPLACE";
+            public override string GetInsertOnConflictSetSql(string primaryKeyName, string setValuesSqlFragment) =>
+                $"ON CONFLICT({primaryKeyName}) DO UPDATE SET {setValuesSqlFragment} WHERE true";
+
+            // Not used for template generation
+            protected override Action<DbContextOptionsBuilder> ConfigureDbContext(DatabaseReplica replica, int shardNdx) => throw new NotImplementedException();
+            public override System.Threading.Tasks.Task<System.Data.Common.DbConnection> CreateConnectionAsync(DatabaseReplica replica, int shardNdx) => throw new NotImplementedException();
+            public override System.Threading.Tasks.Task<string[]> GetTableNamesAsync(int shardNdx) => throw new NotImplementedException();
+            public override System.Threading.Tasks.Task<bool> TableExistsAsync(string tableName) => throw new NotImplementedException();
+            public override System.Threading.Tasks.Task<int> EstimateItemCountInTableAsync(int shardNdx, string tableName) => throw new NotImplementedException();
+            public override bool SupportsDeleteOrderBy() => throw new NotImplementedException();
+            public override bool SupportsDeleteLimit() => throw new NotImplementedException();
+            public override string GetShardingSql(string keyName) => throw new NotImplementedException();
+        }
+
+        /// <summary>
+        /// Test persisted item with primary key and partition key.
+        /// </summary>
+        class TestPersistedItem : IPersistedItem
+        {
+            [Key]
+            [PartitionKey]
+            public string ItemId { get; set; }
+            public string Name { get; set; }
+            public int Value { get; set; }
+            public DateTime CreatedAt { get; set; }
+        }
+
+        /// <summary>
+        /// Test item without a primary key.
+        /// </summary>
+        [NoPrimaryKey]
+        class NoPrimaryKeyItem : IPersistedItem
+        {
+            [PartitionKey]
+            public string PartitionId { get; set; }
+            public string Data { get; set; }
+        }
+
+        static readonly DateTime TestDate = new DateTime(2024, 6, 15, 12, 0, 0, DateTimeKind.Utc);
+
+        TestDatabaseBackend _sqliteBackend;
+
+        [SetUp]
+        public void SetUp()
+        {
+            _sqliteBackend = new TestDatabaseBackend();
+        }
+
+        [TearDown]
+        public void TearDown()
+        {
+            _sqliteBackend?.Dispose();
+        }
+
+        #endregion
+
+        #region CreateBulkInsertValuesString Tests
+
+        [Test]
+        public void CreateBulkInsertValuesString_SingleItemSingleMember()
+        {
+            string result = MetaDatabase.CreateBulkInsertValuesString(numItems: 1, numMembersPerItem: 1);
+            Assert.That(result, Is.EqualTo("(@_0)"));
+        }
+
+        [Test]
+        public void CreateBulkInsertValuesString_SingleItemMultipleMembers()
+        {
+            string result = MetaDatabase.CreateBulkInsertValuesString(numItems: 1, numMembersPerItem: 3);
+            Assert.That(result, Is.EqualTo("(@_0,@_1,@_2)"));
+        }
+
+        [Test]
+        public void CreateBulkInsertValuesString_MultipleItemsMultipleMembers()
+        {
+            string result = MetaDatabase.CreateBulkInsertValuesString(numItems: 2, numMembersPerItem: 3);
+            Assert.That(result, Is.EqualTo("(@_0,@_1,@_2),(@_3,@_4,@_5)"));
+        }
+
+        [Test]
+        public void CreateBulkInsertValuesString_ThreeItemsFourMembers()
+        {
+            string result = MetaDatabase.CreateBulkInsertValuesString(numItems: 3, numMembersPerItem: 4);
+            Assert.That(result, Is.EqualTo("(@_0,@_1,@_2,@_3),(@_4,@_5,@_6,@_7),(@_8,@_9,@_10,@_11)"));
+        }
+
+        [Test]
+        public void CreateBulkInsertValuesString_ZeroItems_ReturnsEmpty()
+        {
+            string result = MetaDatabase.CreateBulkInsertValuesString(numItems: 0, numMembersPerItem: 4);
+            Assert.That(result, Is.EqualTo(""));
+        }
+
+        #endregion
+
+        #region BulkInsertTemplate Tests
+
+        [Test]
+        public void BulkInsertOrIgnoreTemplate_ContainsExpectedElements()
+        {
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "TestItems", typeof(TestPersistedItem));
+
+            // Template should contain placeholder and all column names
+            Assert.That(spec.BulkInsertOrIgnoreTemplate, Does.Contain(DatabaseItemSpec.BulkValuesPlaceholder));
+            Assert.That(spec.BulkInsertOrIgnoreTemplate, Does.Contain("ItemId"));
+            Assert.That(spec.BulkInsertOrIgnoreTemplate, Does.Contain("Name"));
+            Assert.That(spec.BulkInsertOrIgnoreTemplate, Does.Contain("Value"));
+            Assert.That(spec.BulkInsertOrIgnoreTemplate, Does.Contain("CreatedAt"));
+        }
+
+        [Test]
+        public void BulkInsertOrUpdateTemplate_ContainsPlaceholder()
+        {
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "TestItems", typeof(TestPersistedItem));
+
+            Assert.That(spec.BulkInsertOrUpdateTemplate, Does.Contain(DatabaseItemSpec.BulkValuesPlaceholder));
+        }
+
+        [Test]
+        public void BulkInsertOrUpdateTemplate_NoPrimaryKey_IsNull()
+        {
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "NoPkItems", typeof(NoPrimaryKeyItem));
+
+            // Items without primary key cannot use upsert
+            Assert.That(spec.BulkInsertOrUpdateTemplate, Is.Null);
+        }
+
+        #endregion
+
+        #region MemberInfos Tests
+
+        [Test]
+        public void MemberInfos_ContainsAllPersistedMembers()
+        {
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "TestItems", typeof(TestPersistedItem));
+
+            Assert.That(spec.MemberInfos.Length, Is.EqualTo(4));
+
+            string[] memberNames = spec.MemberInfos.Select(mi => mi.Name).ToArray();
+            Assert.That(memberNames, Does.Contain("ItemId"));
+            Assert.That(memberNames, Does.Contain("Name"));
+            Assert.That(memberNames, Does.Contain("Value"));
+            Assert.That(memberNames, Does.Contain("CreatedAt"));
+        }
+
+        [Test]
+        public void MemberNamesStr_MatchesMemberInfosOrder()
+        {
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "TestItems", typeof(TestPersistedItem));
+
+            // MemberNamesStr should be comma-separated names in same order as MemberInfos
+            string expectedNamesStr = string.Join(", ", spec.MemberInfos.Select(mi => mi.Name));
+            Assert.That(spec.MemberNamesStr, Is.EqualTo(expectedNamesStr));
+        }
+
+        #endregion
+
+        #region ExtractMembers Tests
+
+        [Test]
+        public void ExtractMembers_ReturnsValuesInMemberInfosOrder()
+        {
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "TestItems", typeof(TestPersistedItem));
+
+            TestPersistedItem item = new TestPersistedItem
+            {
+                ItemId = "test-123",
+                Name = "Test Item",
+                Value = 42,
+                CreatedAt = TestDate
+            };
+
+            object[] members = spec.ExtractMembers(item);
+
+            // Verify count matches
+            Assert.That(members.Length, Is.EqualTo(spec.MemberInfos.Length));
+
+            // Verify each value is at the correct position matching MemberInfos order
+            for (int i = 0; i < spec.MemberInfos.Length; i++)
+            {
+                string memberName = spec.MemberInfos[i].Name;
+                object expectedValue = memberName switch
+                {
+                    "ItemId" => "test-123",
+                    "Name" => "Test Item",
+                    "Value" => 42,
+                    "CreatedAt" => TestDate,
+                    _ => throw new Exception($"Unexpected member: {memberName}")
+                };
+                Assert.That(members[i], Is.EqualTo(expectedValue), Invariant($"Value mismatch at index {i} for member '{memberName}'"));
+            }
+        }
+
+        [Test]
+        public void ExtractMembers_PreservesNullValues()
+        {
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "TestItems", typeof(TestPersistedItem));
+
+            TestPersistedItem item = new TestPersistedItem
+            {
+                ItemId = "test-456",
+                Name = null,
+                Value = 0,
+                CreatedAt = default
+            };
+
+            object[] members = spec.ExtractMembers(item);
+
+            // Find the index of Name in MemberInfos
+            int nameIndex = Array.FindIndex(spec.MemberInfos, mi => mi.Name == "Name");
+            Assert.That(nameIndex, Is.GreaterThanOrEqualTo(0), "Name member not found");
+            Assert.That(members[nameIndex], Is.Null, "Null value should be preserved");
+        }
+
+        [Test]
+        public void ExtractMembers_NoPrimaryKeyItem_ExtractsCorrectly()
+        {
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "NoPkItems", typeof(NoPrimaryKeyItem));
+
+            NoPrimaryKeyItem item = new NoPrimaryKeyItem
+            {
+                PartitionId = "partition-1",
+                Data = "some data"
+            };
+
+            object[] members = spec.ExtractMembers(item);
+
+            Assert.That(members.Length, Is.EqualTo(2));
+
+            // Verify values are at correct positions
+            int partitionIndex = Array.FindIndex(spec.MemberInfos, mi => mi.Name == "PartitionId");
+            int dataIndex = Array.FindIndex(spec.MemberInfos, mi => mi.Name == "Data");
+
+            Assert.That(members[partitionIndex], Is.EqualTo("partition-1"));
+            Assert.That(members[dataIndex], Is.EqualTo("some data"));
+        }
+
+        #endregion
+
+        #region SQLite Integration Tests
+
+        /// <summary>
+        /// Creates an in-memory SQLite connection with test table.
+        /// </summary>
+        static SqliteConnection CreateTestDatabase()
+        {
+            SqliteConnection conn = new SqliteConnection("Data Source=:memory:");
+            conn.Open();
+            conn.Execute(@"
+                CREATE TABLE TestItems (
+                    ItemId TEXT PRIMARY KEY,
+                    Name TEXT,
+                    Value INTEGER,
+                    CreatedAt TEXT
+                )");
+            return conn;
+        }
+
+        /// <summary>
+        /// Executes bulk insert using the same pattern as MetaDatabaseBase.MultiBulkInsertAsync.
+        /// </summary>
+        int ExecuteBulkInsert(SqliteConnection conn, IList<TestPersistedItem> items, bool isUpsert)
+        {
+            if (items.Count == 0)
+                return 0;
+
+            DatabaseItemSpec spec = new DatabaseItemSpec(_sqliteBackend, "TestItems", typeof(TestPersistedItem));
+            string template = isUpsert ? spec.BulkInsertOrUpdateTemplate : spec.BulkInsertOrIgnoreTemplate;
+            string valuesStr = MetaDatabase.CreateBulkInsertValuesString(items.Count, spec.MemberInfos.Length);
+            string sql = template.Replace(DatabaseItemSpec.BulkValuesPlaceholder, valuesStr);
+
+            DynamicParameters parameters = new DynamicParameters();
+            int paramNdx = 0;
+            foreach (TestPersistedItem item in items)
+            {
+                object[] members = spec.ExtractMembers(item);
+                for (int memberNdx = 0; memberNdx < members.Length; memberNdx++)
+                {
+                    parameters.Add(Invariant($"_{paramNdx}"), members[memberNdx]);
+                    paramNdx++;
+                }
+            }
+
+            return conn.Execute(sql, parameters);
+        }
+
+        [Test]
+        public void SQLite_BulkInsertOrIgnore_InsertsMultipleRows()
+        {
+            using SqliteConnection conn = CreateTestDatabase();
+
+            List<TestPersistedItem> items = new List<TestPersistedItem>
+            {
+                new TestPersistedItem { ItemId = "id-1", Name = "Item 1", Value = 10, CreatedAt = TestDate },
