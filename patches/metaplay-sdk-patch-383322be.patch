+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+import { describe, expect, test } from 'vitest'
+
+import type { OptionFilterState } from '../../src/unstable/mlistcard/MListCardTypes'
+import {
+  applyOptionFilter,
+  combineFilterMatches,
+  makeOptionsFilter,
+  makeRangeFilter,
+  makeSearchFilter,
+} from '../../src/unstable/mlistcard/MListCardUtils'
+
+interface TestItem {
+  name: string
+  status: 'active' | 'inactive' | 'refunded'
+  price: number
+}
+
+const searchFilter = makeSearchFilter<TestItem>((item) => [item.name])
+
+const statusFilter = makeOptionsFilter<TestItem, TestItem['status']>('Status', (item) => item.status, [
+  { label: 'Active', value: 'active' },
+  { label: 'Inactive', value: 'inactive' },
+  { label: 'Refunded', value: 'refunded' },
+])
+
+const priceFilter = makeRangeFilter<TestItem>('Price', (item) => item.price)
+
+describe('filter isActive', () => {
+  test('search filter: active only when search term is non-empty', () => {
+    expect(searchFilter.isActive({ type: 'search', searchTerm: '' })).toBe(false)
+    expect(searchFilter.isActive({ type: 'search', searchTerm: 'dragon' })).toBe(true)
+  })
+
+  test('options filter: active only when at least one option is selected', () => {
+    expect(statusFilter.isActive({ type: 'options', activeOptions: [] })).toBe(false)
+    expect(statusFilter.isActive({ type: 'options', activeOptions: ['Active'] })).toBe(true)
+  })
+
+  test('range-number filter: active when min or max is set', () => {
+    expect(priceFilter.isActive({ type: 'range-number', min: undefined, max: undefined })).toBe(false)
+    expect(priceFilter.isActive({ type: 'range-number', min: 0, max: undefined })).toBe(true)
+    expect(priceFilter.isActive({ type: 'range-number', min: undefined, max: 50 })).toBe(true)
+  })
+})
+
+describe('combineFilterMatches', () => {
+  test('returns true when there are no active filters in either mode', () => {
+    expect(combineFilterMatches([], 'and')).toBe(true)
+    expect(combineFilterMatches([], 'or')).toBe(true)
+  })
+
+  test('AND mode requires all filters to match', () => {
+    expect(combineFilterMatches([true, true], 'and')).toBe(true)
+    expect(combineFilterMatches([true, false], 'and')).toBe(false)
+  })
+
+  test('OR mode requires any filter to match', () => {
+    expect(combineFilterMatches([true, false], 'or')).toBe(true)
+    expect(combineFilterMatches([false, false], 'or')).toBe(false)
+  })
+})
+
+describe('options filter semantics', () => {
+  const activeOrInactiveState: OptionFilterState = {
+    type: 'options',
+    activeOptions: ['Active', 'Inactive'],
+  }
+
+  test('selected options remain OR within a single options filter', () => {
+    const activeItem: TestItem = { name: 'Alice', status: 'active', price: 10 }
+    const inactiveItem: TestItem = { name: 'Bob', status: 'inactive', price: 20 }
+    const refundedItem: TestItem = { name: 'Carol', status: 'refunded', price: 30 }
+
+    expect(applyOptionFilter(statusFilter, activeOrInactiveState, activeItem)).toBe(true)
+    expect(applyOptionFilter(statusFilter, activeOrInactiveState, inactiveItem)).toBe(true)
+    expect(applyOptionFilter(statusFilter, activeOrInactiveState, refundedItem)).toBe(false)
+  })
+
+  test('cross-filter combination still depends on AND/OR mode', () => {
+    const activeItemMatch = applyOptionFilter(statusFilter, activeOrInactiveState, {
+      name: 'Alice',
+      status: 'active',
+      price: 10,
+    })
+    const secondFilterMatch = false
+
+    expect(combineFilterMatches([activeItemMatch, secondFilterMatch], 'and')).toBe(false)
+    expect(combineFilterMatches([activeItemMatch, secondFilterMatch], 'or')).toBe(true)
+  })
+})
