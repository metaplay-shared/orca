+        /// <summary>
+        /// Returns the node name on which the entity is sharded on, for example 'logic-1'.
+        /// <para>
+        /// Node name is not the hostname, and the return type does not depend on clustering mode.
+        /// </para>
+        /// </summary>
+        public static string GetClusterNodeNameForEntity(EntityId entityId)
+        {
+            EntityConfigBase entityConfig = EntityConfigRegistry.Instance.GetConfig(entityId.Kind);
+
+            EntityShardId shardId;
+            try
+            {
+                // \note: May throw if the entityId is not valid within the Strategy's own rules.
+                shardId = entityConfig.ShardingStrategy.ResolveShardId(entityId);
+            }
+            catch
+            {
+                return "error";
+            }
+            if (shardId == default)
+                return "none";
+
+            ClusterConfig cc = RuntimeOptionsRegistry.Instance.GetCurrent<ClusteringOptions>().ClusterConfig;
+            NodeSetConfig nodeset;
+            try
+            {
+                nodeset = cc.GetNodeSetConfigForShardId(shardId);
+            }
+            catch
+            {
+                return "not-in-cluster";
+            }
+            return Invariant($"{nodeset.ShardName}-{shardId.NodeIndex}");
+        }
