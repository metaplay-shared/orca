diff --git a/MetaplaySDK/Client/Core/Offers/MetaOfferGroup.ErroneousOfferStates.cs b/MetaplaySDK/Client/Core/Offers/MetaOfferGroup.ErroneousOfferStates.cs
new file mode 100644
index 00000000..7c548960
--- /dev/null
+++ b/MetaplaySDK/Client/Core/Offers/MetaOfferGroup.ErroneousOfferStates.cs
@@ -0,0 +1,144 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core.Config;
+using Metaplay.Core.Model;
+using Metaplay.Core.Serialization;
+
+namespace Metaplay.Core.Offers
+{
+    partial class PlayerMetaOfferGroupsModelBase<TOfferGroupInfo>
+    {
+        // This arranges "erroneous" offers to be stored in collections separate from normal non-erroneous offers.
+        // "Erroneous" means an offer that is not found in the game config (because it was removed from there after becoming active).
+        // By not simply removing such offer states, this allows restoring the state of offers that were accidentally removed from the config.
+        // However, removed offers are permanently removed after a safety period (runtime option Player:PurgeStateForRemovedConfigItemsDelay).
+        //
+        // This is similar to the _erroneousActivableStates mechanism implemented for activables by MetaActivableSet.
+        // Offer groups are activables, and are thus served by said _erroneousActivableStates,
+        // but individual offers are not activables and thus have their own implementation here.
+        //
+        // Compared to activables, there's the extra complication that an offer has two kinds of state: per-player state (OfferStates[offerId])
+        // and per-group state (in _activableStates[groupId].OfferStates[offerId]).
+        // The per-player state for erroneous offers is in _erroneousPerPlayerOfferStates.
+        // The per-group state for erroneous offers is in _erroneousPerGroupOfferStates[groupId][offerId].
+        // An alternative valid implementation would be to have the per-group state inside the offer group model,
+        // say _activableStates[groupId].ErroneousOfferStates[offerId], but since we expect erroneous offers to
+        // be rare, we've instead hoisted them to this top-level _erroneousPerGroupOfferStates to avoid the
+        // size overhead in the offer group model with the usually-empty ErroneousOfferStates collection.
+
+        [MetaMember(201), ServerOnly] protected MetaDictionary<MetaOfferId, MetaOfferPerPlayerStateBase> _erroneousPerPlayerOfferStates = new MetaDictionary<MetaOfferId, MetaOfferPerPlayerStateBase>();
+        [MetaMember(202), ServerOnly] protected MetaDictionary<MetaOfferGroupId, MetaDictionary<MetaOfferId, MetaOfferPerGroupStateBase>> _erroneousPerGroupOfferStates = new MetaDictionary<MetaOfferGroupId, MetaDictionary<MetaOfferId, MetaOfferPerGroupStateBase>>();
+
+        static bool IsValidOffer(MetaOfferId offerId, IGameConfigDataResolver configResolver)
+        {
+            return configResolver.TryResolveReference(typeof(MetaOfferInfoBase), offerId) != null;
+        }
+
+        [MetaOnDeserialized]
+        void OrganizeOfferStatesByValidityOnDeserialization(MetaOnDeserializedParams onDeserializedParams)
+        {
+            IGameConfigDataResolver configResolver = onDeserializedParams.Resolver;
+            OrganizePerPlayerOfferStatesByValidity(configResolver);
+            OrganizePerGroupOfferStatesByValidity(configResolver);
+        }
+
+        void OrganizePerPlayerOfferStatesByValidity(IGameConfigDataResolver configResolver)
+        {
+            // Move erroneous states from OfferStates to _erroneousPerPlayerOfferStates.
+            bool anyErroneousStates = false;
+            foreach ((MetaOfferId id, MetaOfferPerPlayerStateBase state) in OfferStates)
+            {
+                if (!IsValidOffer(id, configResolver))
+                {
+                    anyErroneousStates = true;
+                    _erroneousPerPlayerOfferStates.AddOrReplace(id, state); // \note Shouldn't clash, but be safe.
+                }
+            }
+            if (anyErroneousStates)
+                OfferStates.RemoveWhere(kv => !IsValidOffer(kv.Key, configResolver));
+
+            // Move valid states from _erroneousPerPlayerOfferStates to OfferStates.
+            bool anyNewlyValidStates = false;
+            foreach ((MetaOfferId id, MetaOfferPerPlayerStateBase state) in _erroneousPerPlayerOfferStates)
+            {
+                if (IsValidOffer(id, configResolver))
+                {
+                    anyNewlyValidStates = true;
+                    OfferStates.AddIfAbsent(id, state); // \note Shouldn't clash, but be safe. Note AddIfAbsent, different from AddOrReplace for the reverse case above.
+                }
+            }
+            if (anyNewlyValidStates)
+                _erroneousPerPlayerOfferStates.RemoveWhere(kv => IsValidOffer(kv.Key, configResolver));
+        }
+
+        void OrganizePerGroupOfferStatesByValidity(IGameConfigDataResolver configResolver)
+        {
+            // Move erroneous offer states from within offer groups (in _activableStates and _erroneousActivableStates) to _erroneousPerGroupOfferStates.
+            // Note that we indeed do this not only for the valid groups in _activableStates, but also the erroneous groups in _erroneousActivableStates.
+            // This way, if a previously erroneous group becomes non-erroneous, it will only contain the valid offers.
+            OrganizeToErroneousPerGroupOfferStates(configResolver, _activableStates);
+            OrganizeToErroneousPerGroupOfferStates(configResolver, _erroneousActivableStates);
+
+            // Move valid offer states from _erroneousPerGroupOfferStates to offer groups (in _activableStates or _erroneousActivableStates).
+            // As above, we do this for not only _activableStates but also for _erroneousActivableStates,
+            // so that if a previously erroneous group becomes non-erroneous, it will already contain all the valid offers in it.
+            bool anyEmptyErroneousPerGroupOfferStates = false;
+            foreach ((MetaOfferGroupId groupId, MetaDictionary<MetaOfferId, MetaOfferPerGroupStateBase> groupOfferStates) in _erroneousPerGroupOfferStates)
+            {
+                if (!_activableStates.TryGetValue(groupId, out MetaOfferGroupModelBase groupModel)
+                 && !_erroneousActivableStates.TryGetValue(groupId, out groupModel))
+                {
+                    // Offer group state was not found?
+                    // Shouldn't happen, because we delete erroneous offer states
+                    // at the same time as erroneous offer group states (called by PlayerModelBase.PurgeStateForRemovedConfigItems).
+                    // Ignore to be defensive.
+                    continue;
+                }
+
+                bool anyNewlyValidStates = false;
+                foreach ((MetaOfferId offerId, MetaOfferPerGroupStateBase offerState) in groupOfferStates)
+                {
+                    if (IsValidOffer(offerId, configResolver))
+                    {
+                        anyNewlyValidStates = true;
+                        groupModel.OfferStates.AddIfAbsent(offerId, offerState); // \note Shouldn't clash, but be safe. Note AddIfAbsent, different from AddOrReplace for the reverse case in OrganizeToErroneousPerGroupOfferStates.
+                    }
+                }
+                if (anyNewlyValidStates)
+                {
+                    groupOfferStates.RemoveWhere(kv => IsValidOffer(kv.Key, configResolver));
+                    if (groupOfferStates.Count == 0)
+                        anyEmptyErroneousPerGroupOfferStates = true;
+                }
+            }
+            // Prune _erroneousPerGroupOfferStates to remove entries for groups that have no erroneous offers.
+            if (anyEmptyErroneousPerGroupOfferStates)
+                _erroneousPerGroupOfferStates.RemoveWhere(kv => kv.Value.Count == 0);
+        }
+
+        void OrganizeToErroneousPerGroupOfferStates(IGameConfigDataResolver configResolver, MetaDictionary<MetaOfferGroupId, MetaOfferGroupModelBase> offerGroupStates)
+        {
+            // Move erroneous states from offerGroupStates to _erroneousPerGroupOfferStates.
+            foreach ((MetaOfferGroupId groupId, MetaOfferGroupModelBase groupModel) in offerGroupStates)
+            {
+                bool anyErroneousStates = false;
+                foreach ((MetaOfferId offerId, MetaOfferPerGroupStateBase offerState) in groupModel.OfferStates)
+                {
+                    if (!IsValidOffer(offerId, configResolver))
+                    {
+                        anyErroneousStates = true;
+                        _erroneousPerGroupOfferStates.GetOrAddDefaultConstructed(groupId).AddOrReplace(offerId, offerState); // \note Shouldn't clash, but be safe.
+                    }
+                }
+                if (anyErroneousStates)
+                    groupModel.OfferStates.RemoveWhere(kv => !IsValidOffer(kv.Key, configResolver));
+            }
+        }
+
+        public void ClearErroneousOfferStates()
+        {
+            _erroneousPerPlayerOfferStates.Clear();
+            _erroneousPerGroupOfferStates.Clear();
+        }
+    }
+}
