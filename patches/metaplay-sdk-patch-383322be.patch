+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+#if UNITY_EDITOR
+
+using Metaplay.Unity;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+
+namespace Metaplay.Core.Tests
+{
+    public static class TestHelper
+    {
+        /// <summary>
+        /// Path to the Metaplay specific Temp folder on Editor. Does not have a trailing /.
+        /// </summary>
+        public const string UnityTempDirectory = "Temp/Metaplay"; // Use Unity's Temp/ directory
+
+        static void ConfigureServicesForTests(IServiceInitializers init)
+        {
+            init.ConfigureMetaSerialization(applicationName: "UnityEditModeTest", outputDirectory: MetaplayUnityDirectories.UnityTempDirectory, isMono: true, useMemberAccessTrampolines: true, generateRuntimeTypeInfo: true);
+        }
+
+        public static IMetaplayServiceProvider SetupForTests()
+        {
+            return Reinitialize(IntegrationConfig.FromAssembly(Assembly.GetCallingAssembly()), null);
+        }
+
+        public static IMetaplayServiceProvider SetIntegrationContext(IEnumerable<string> scopeIds, Action<IServiceInitializers> additionalConfig = null)
+        {
+            return Reinitialize(MetaplayServices.Get<IntegrationConfig>().WithIntegrationScopes(scopeIds.Prepend("")), additionalConfig);
+        }
+
+        static IMetaplayServiceProvider Reinitialize(IntegrationConfig config, Action<IServiceInitializers> additionalConfig)
+        {
+            return MetaplayCore.Reinitialize(
+                services =>
+                {
+                    services.ConfigureIntegration(config);
+                    ConfigureServicesForTests(services);
+                    additionalConfig?.Invoke(services);
+                });
+        }
+    }
+}
+
+#endif
