+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core;
+using Metaplay.Core.Network;
+using Metaplay.Core.Message;
+using Metaplay.Core.Player;
+using System;
+using UnityEngine;
+using UnityEditor;
+
+namespace Metaplay.Unity
+{
+    /// <summary>
+    /// Controller for the MetaplaySDK Editor Window. Manages the state and provides
+    /// access to SDK status in the editor.
+    /// </summary>
+    public class MetaplaySDKEditorController
+    {
+        const string PlayerPrefsKey = "Metaplay.SDKEditorController.PersistedState";
+
+        public static MetaplaySDKEditorController Instance { get; private set; }
+
+        /// <summary>
+        /// Persisted state of the window that survives domain reload.
+        /// These fields are saved to PlayerPrefs as JSON.
+        /// </summary>
+        [Serializable]
+        public class PersistedState
+        {
+            public bool EnableLatencySimulation = false;
+            public int ArtificialAddedLatency = 0;
+            public int SimulatedLinkQuality = 0; // LinkQualitySetting enum
+            public string AppearAsPlatformString = "";
+            public string OverrideLocationString = "";
+
+            public ClientPlatform AppearAsPlatform
+            {
+                get
+                {
+                    if (Enum.TryParse(AppearAsPlatformString, out ClientPlatform platform))
+                        return platform;
+                    else
+                        return ClientPlatform.UnityEditor;
+                }
+                set
+                {
+                    AppearAsPlatformString = EnumToStringCache<ClientPlatform>.ToString(value);
+                }
+            }
+
+            public PlayerLocation? OverrideLocation
+            {
+                get
+                {
+                    if (string.IsNullOrEmpty(OverrideLocationString))
+                        return null;
+                    string[] parts = OverrideLocationString.Split("-");
+                    return new PlayerLocation(new CountryId(parts[1]), parts[0]);
+                }
+                set
+                {
+                    if (value is PlayerLocation loc)
+                        OverrideLocationString = $"{loc.ContinentCodeMaybe}-{loc.Country.IsoCode}";
+                    else
+                        OverrideLocationString = "";
+                }
+            }
+
+            public static PersistedState LoadState()
+            {
+                string json = PlayerPrefs.GetString(PlayerPrefsKey, "");
+                if (!string.IsNullOrEmpty(json))
+                {
+                    try
+                    {
+                        return JsonUtility.FromJson<PersistedState>(json);
+                    }
+                    catch
+                    {
+                        return new PersistedState();
+                    }
+                }
+                else
+                {
+                    return new PersistedState();
+                }
+            }
+
+            public void SaveState()
+            {
+                string json = JsonUtility.ToJson(this);
+                PlayerPrefs.SetString(PlayerPrefsKey, json);
+                PlayerPrefs.Save();
+            }
+        }
+
+        /// <summary>
+        /// Link quality simulation settings.
+        /// </summary>
+        public enum LinkQualitySetting
+        {
+            Perfect = 0,
+            Spotty = 1,
+            NoReplies = 2,
+            AllRejected = 3,
+        }
+
+        // Persisted state
+        PersistedState _state;
+
+        // Transport state
+        LatencySimulationMessageTransport _latencySimulationTransport;
+        FaultInjectingMessageTransport _faultInjectingTransport;
+        DateTime _nextSpottyLinkUpdate;
+        bool _spottyLinkIsHalted;
+
+        // Events
+        public event Action EditorHookOnLocalizationUpdatedEvent;
+
+        [InitializeOnLoadMethod]
+        public static void StaticInit()
+        {
+            MetaplayCoreEditor.RunAfterMetaplayEditorInit(() =>
+            {
+                Instance = new MetaplaySDKEditorController();
+                EditorApplication.update += Instance.Update;
+                MetaplaySDK.EditorHookSdkEditorWindowOnAfterSDKInit = Instance.AfterSDKInit;
+            });
+        }
+
+        MetaplaySDKEditorController()
+        {
+            _state = PersistedState.LoadState();
+            EditorApplication.playModeStateChanged += OnPlayModeStateChanged;
+        }
+
+        void OnPlayModeStateChanged(PlayModeStateChange state)
+        {
+            if (state == PlayModeStateChange.ExitingPlayMode)
+            {
+                // Reset transport state
+                _latencySimulationTransport = null;
+                _faultInjectingTransport = null;
+                _spottyLinkIsHalted = false;
+            }
+        }
+
+        #region Persisted State Properties
+
+        public bool EnableLatencySimulation
+        {
+            get => _state.EnableLatencySimulation;
+            set
+            {
+                if (_state.EnableLatencySimulation != value)
+                {
+                    _state.EnableLatencySimulation = value;
+                    _state.SaveState();
+                }
+            }
+        }
+
+        public int ArtificialAddedLatency
+        {
+            get => _state.ArtificialAddedLatency;
+            set
+            {
+                if (_state.ArtificialAddedLatency != value)
+                {
+                    _state.ArtificialAddedLatency = value;
+                    _state.SaveState();
+                }
+            }
+        }
+
+        public LinkQualitySetting SimulatedLinkQuality
+        {
+            get => (LinkQualitySetting)_state.SimulatedLinkQuality;
+            set
+            {
+                if (_state.SimulatedLinkQuality != (int)value)
+                {
+                    _state.SimulatedLinkQuality = (int)value;
+                    _state.SaveState();
+                }
+            }
+        }
+
+        public ClientPlatform AppearAsPlatform
+        {
+            get => _state.AppearAsPlatform;
+            set
+            {
+                _state.AppearAsPlatform = value;
+                _state.SaveState();
+            }
+        }
+
+        public PlayerLocation? OverrideLocation
+        {
+            get => _state.OverrideLocation;
+            set
+            {
+                if (_state.OverrideLocation != value)
+                {
+                    _state.OverrideLocation = value;
+                    _state.SaveState();
+                }
+            }
+        }
+
+        #endregion
+
+        #region SDK Hooks
+
+        /// <summary>
+        /// Called after SDK initialization to set up hooks.
+        /// </summary>
+        void AfterSDKInit()
+        {
+            if (EnableLatencySimulation)
+                MetaplaySDK.Connection.CreateTransportHooks.Add(CreateLatencySimulationTransport);
+
+            MetaplaySDK.Connection.CreateTransportHooks.Add(CreateFaultInjectingTransport);
+            ClientPlatformUnityUtil.EditorHookGetClientPlatform = () => _state.AppearAsPlatform;
+            MetaplaySDK.LocalizationManager.EditorHookLocalizationUpdatedEvent = OnLocalizationChanged;
+            ClientLocationOverrideProvider.EditorHookGetOverrideLocation = () => _state.OverrideLocation;
+        }
+
+        void OnLocalizationChanged()
+        {
+            try
+            {
+                EditorHookOnLocalizationUpdatedEvent?.Invoke();
+            }
+            catch
+            {
+            }
+        }
+
+        #endregion
