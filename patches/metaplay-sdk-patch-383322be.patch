+                _actor._nextOverloadWarningEarliestAt = DateTime.UtcNow + TimeSpan.FromSeconds(5);
+            }
+
+            public void WarnForOperation(string operation)
+            {
+                _actor._log.Warning("{Operation} was delayed by {Delay} because the actor was busy. Actor is overloaded, or slow operations such as long awaits on actor context are slowing down the processing.", operation, _latency);
+                _actor._nextOverloadWarningEarliestAt = DateTime.UtcNow + TimeSpan.FromSeconds(5);
+            }
+        }
+
+        bool CheckInboxLatency(IHasCommandEnqueuedToInboxAt enqueuedToInboxAt, out OverloadWarningContext ctx) => CheckInboxLatency(enqueuedToInboxAt.EnqueuedToInboxAt, out ctx);
+
+        bool CheckInboxLatency(DateTime enqueuedToInboxAt, out OverloadWarningContext ctx)
+        {
+            DateTime now = DateTime.UtcNow;
+            if (now < _nextOverloadWarningEarliestAt)
+            {
+                ctx = default;
+                return false;
+            }
+
+            TimeSpan latency = now - enqueuedToInboxAt;
+            if (latency < TimeSpan.FromSeconds(5))
+            {
+                ctx = default;
+                return false;
+            }
+
+            ctx = new OverloadWarningContext(this, latency);
+            return true;
+        }
+    }
+}
