--- /dev/null
+++ b/MetaplaySDK/Frontend/MetaUiNext/src/primitives/MLazyLoader.stories.ts
@@ -0,0 +1,226 @@
+import type { Meta, StoryObj } from '@storybook/vue3-vite'
+
+import MLazyLoader from './MLazyLoader.vue'
+
+/**
+ * The `MLazyLoader` component is a wrapper that optimizes performance by deferring rendering of child content until it
+ * enters the viewport. It uses the IntersectionObserver API to detect visibility changes and can delay showing/hiding
+ * content to avoid flickering during rapid scrolling.
+ *
+ * We use this internally in very long lists to lazy-load list entries. However, the component still has a performance
+ * impact and a better strategy is to load less data initially to create fewer lazy-loaded elements in the first place.
+ */
+const meta: Meta<typeof MLazyLoader> = {
+  component: MLazyLoader,
+  tags: ['autodocs'],
+  argTypes: {
+    placeholderHeight: {
+      control: 'text',
+    },
+    margin: {
+      control: 'number',
+    },
+    remainVisible: {
+      control: 'boolean',
+    },
+    showAfterDelayInMs: {
+      control: 'number',
+    },
+    hideAfterDelayInMs: {
+      control: 'number',
+    },
+  },
+  parameters: {
+    docs: {
+      canvas: {
+        sourceState: 'none',
+      },
+    },
+  },
+}
+
+export default meta
+type Story = StoryObj<typeof MLazyLoader>
+type StoryArgs = Story['args']
+
+/**
+ * The default lazy loader shows content after a 250ms delay when entering the viewport and hides it after a 10 second
+ * delay when leaving. The placeholder has a default height of 100px.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * MLazyLoader
+ *   div(class="tw-p-4 tw-border")
+ *     p This content is lazy-loaded when it enters the viewport
+ * ```
+ *
+ * ```typescript
+ * import { MLazyLoader } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
+export const Default: Story = {
+  args: {},
+  render: (args: StoryArgs) => ({
+    components: { MLazyLoader },
+    setup: () => ({ args }),
+    template: `
+    <MLazyLoader v-bind="args">
+      <div class="tw-p-4 tw-border">
+        <p>This content is lazy-loaded when it enters the viewport</p>
+      </div>
+    </MLazyLoader>
+    `,
+  }),
+}
+
+/**
+ * Use the `placeholderHeight` prop to customize the height of the placeholder div shown when content is hidden.
+ * This should match the expected height of your content to prevent layout shift.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * MLazyLoader(placeholder-height="200px")
+ *   div(class="tw-h-48 tw-border tw-p-4")
+ *     p Taller content with a matching placeholder
+ * ```
+ *
+ * ```typescript
+ * import { MLazyLoader } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
+export const CustomPlaceholder: Story = {
+  args: {
+    placeholderHeight: '200px',
+  },
+  render: (args: StoryArgs) => ({
+    components: { MLazyLoader },
+    setup: () => ({ args }),
+    template: `
+    <MLazyLoader v-bind="args">
+      <div class="tw-h-48 tw-border tw-p-4">
+        <p>Taller content with a matching placeholder</p>
+      </div>
+    </MLazyLoader>
+    `,
+  }),
+}
+
+/**
+ * Set `remainVisible` to `true` to keep content rendered forever once it has been shown. This is useful when you want
+ * to avoid re-rendering content as users scroll back up, but be aware that it can increase memory usage.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * MLazyLoader(:remain-visible="true")
+ *   div(class="tw-p-4 tw-border")
+ *     p This content stays rendered once shown
+ *     p Scroll away and back to confirm
+ * ```
+ *
+ * ```typescript
+ * import { MLazyLoader } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
+export const RemainVisible: Story = {
+  args: {
+    remainVisible: true,
+  },
+  render: (args: StoryArgs) => ({
+    components: { MLazyLoader },
+    setup: () => ({ args }),
+    template: `
+    <MLazyLoader v-bind="args">
+      <div class="tw-p-4 tw-border">
+        <p>This content stays rendered once shown</p>
+        <p>Scroll away and back to confirm</p>
+      </div>
+    </MLazyLoader>
+    `,
+  }),
+}
+
+/**
+ * Set both delay props to 0 for instant show/hide behavior without any delay. This is useful for testing or when you
+ * want immediate visibility changes.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * MLazyLoader(
+ *   :show-after-delay-in-ms="0"
+ *   :hide-after-delay-in-ms="0"
+ *   )
+ *   div(class="tw-p-4 tw-border")
+ *     p Instant visibility changes
+ *     p No delays: content toggles immediately
+ * ```
+ *
+ * ```typescript
+ * import { MLazyLoader } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
+export const NoDelays: Story = {
+  args: {
+    showAfterDelayInMs: 0,
+    hideAfterDelayInMs: 0,
+  },
+  render: (args: StoryArgs) => ({
+    components: { MLazyLoader },
+    setup: () => ({ args }),
+    template: `
+    <MLazyLoader v-bind="args">
+      <div class="tw-p-4 tw-border">
+        <p>Instant visibility changes</p>
+        <p>No delays: content toggles immediately</p>
+      </div>
+    </MLazyLoader>
+    `,
+  }),
+}
+
+/**
+ * A real-world example showing multiple lazy-loaded items in a scrollable container. This demonstrates the typical
+ * usage pattern for long lists where each item is wrapped with MLazyLoader.
+ *
+ * <details>
+ * <summary>Sample Code</summary>
+ * ```pug
+ * div(class="tw-h-96 tw-overflow-y-auto tw-border tw-p-4")
+ *   p Scroll to see lazy loading in action
+ *   div(v-for="i in 20" :key="i" class="tw-mt-2")
+ *     MLazyLoader(placeholder-height="80px")
+ *       div(class="tw-h-20 tw-border tw-p-4")
+ *         p Item {{ i }}
+ * ```
+ *
+ * ```typescript
+ * import { MLazyLoader } from '@metaplay/meta-ui-next'
+ * ```
+ * </details>
+ */
+export const ScrollingList: Story = {
+  args: {},
+  render: (args: StoryArgs) => ({
+    components: { MLazyLoader },
+    setup: () => ({ args }),
+    template: `
+    <div class="tw-h-96 tw-overflow-y-auto tw-border tw-p-4">
+      <p>Scroll to see lazy loading in action</p>
+      <div v-for="i in 20" :key="i" class="tw-mt-2">
+        <MLazyLoader v-bind="args" placeholder-height="80px">
+          <div class="tw-h-20 tw-border tw-p-4">
+            <p>Item {{ i }}</p>
+          </div>
+        </MLazyLoader>
+      </div>
+    </div>
+    `,
+  }),
+}
