diff --git a/MetaplaySDK/Frontend/EslintConfig/plugin/disableAutofix.js b/MetaplaySDK/Frontend/EslintConfig/plugin/disableAutofix.js
new file mode 100644
index 00000000..6fb029f9
--- /dev/null
+++ b/MetaplaySDK/Frontend/EslintConfig/plugin/disableAutofix.js
@@ -0,0 +1,38 @@
+/**
+ * @file Wraps an ESLint rule to strip its auto-fixer while keeping reports intact.
+ *
+ * Some rules (e.g. vue/component-name-in-template-casing) produce correct reports
+ * but their auto-fix destroys Pug templates by emitting HTML tags into Pug source.
+ * This wrapper keeps the lint error without the dangerous fix.
+ *
+ * Same technique as eslint-rule-composer's mapReports: shadow context.report
+ * via Object.create so the frozen context object is not mutated.
+ */
+
+/**
+ * @param {import('eslint').Rule.RuleModule} rule
+ * @returns {import('eslint').Rule.RuleModule}
+ */
+export default function disableAutofix(rule) {
+  const create = typeof rule === 'function' ? rule : rule.create
+
+  return {
+    ...rule,
+    meta: {
+      ...rule.meta,
+      fixable: undefined,
+    },
+    create(context) {
+      // Shadow context.report with a version that strips the `fix` property.
+      const wrappedContext = Object.create(context, {
+        report: {
+          enumerable: true,
+          value(descriptor) {
+            context.report({ ...descriptor, fix: undefined })
+          },
+        },
+      })
+      return create(wrappedContext)
+    },
+  }
+}
