+            player.MetaOfferGroups.OnPurchasedOffer(gameConfig.OfferGroups[MetaOfferGroupId.FromString("GroupB")], gameConfig.Offers[MetaOfferId.FromString("OfferX")], player);
+
+            // Expected: OfferX has 2 purchases in GroupA, 1 in GroupB, 3 total per-player
+            AssertOfferGroup(player, "GroupA", new() { ("OfferX", 2), ("OfferY", 0) });
+            AssertOfferGroup(player, "GroupB", new() { ("OfferX", 1), ("OfferZ", 0) });
+            AssertOffersPerPlayer(player, new() { ("OfferX", 3), ("OfferY", 0), ("OfferZ", 0) });
+
+            // Remove OfferX from config
+            (player, gameConfig) = ChangeConfig(player, new MetaOfferTestsGameConfig(
+                offers: new() { new("OfferY"), new("OfferZ") },
+                offerGroups: new() { new("GroupA", new() { "OfferY" }), new("GroupB", new() { "OfferZ" }) }
+            ));
+
+            // Expected: OfferX gone from both groups and per-player
+            AssertOfferGroup(player, "GroupA", new() { ("OfferX", null), ("OfferY", 0) });
+            AssertOfferGroup(player, "GroupB", new() { ("OfferX", null), ("OfferZ", 0) });
+            AssertOffersPerPlayer(player, new() { ("OfferX", null), ("OfferY", 0), ("OfferZ", 0) });
+
+            // Restore OfferX to config
+            (player, gameConfig) = ChangeConfig(player, new MetaOfferTestsGameConfig(
+                offers: new() { new("OfferX"), new("OfferY"), new("OfferZ") },
+                offerGroups: new() { new("GroupA", new() { "OfferX", "OfferY" }), new("GroupB", new() { "OfferX", "OfferZ" }) }
+            ));
+
+            // Expected: OfferX restored with original per-group counts preserved
+            AssertOfferGroup(player, "GroupA", new() { ("OfferX", 2), ("OfferY", 0) });
+            AssertOfferGroup(player, "GroupB", new() { ("OfferX", 1), ("OfferZ", 0) });
+            AssertOffersPerPlayer(player, new() { ("OfferX", 3), ("OfferY", 0), ("OfferZ", 0) });
+        }
+
+        #endregion
+    }
+}
