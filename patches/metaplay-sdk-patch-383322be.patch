+    if (warningMessagesToIgnore.some((warning) => msg.includes(warning))) {
+      return
+    }
+    // eslint-disable-next-line @typescript-eslint/no-non-null-assertion -- Split always has a first entry.
+    const firstTraceLine = trace.split('\n')[0]!
+    if (traceItemsToIgnore.some((warning) => firstTraceLine.includes(warning))) {
+      return
+    }
+
+    console.warn(`${msg}\n${trace}`)
+    showWarningNotification(msg, 'Frontend Warning')
+  }
 }
