@@ -0,0 +1,212 @@
+<!-- This file is part of Metaplay SDK which is released under the Metaplay SDK License. -->
+
+<template lang="pug">
+MTextButton(
+  v-if="playerData"
+  permission="api.players.edit_experiment_groups"
+  :disabled-tooltip="actionButtonDisabledReason"
+  @click="setVariantModal?.open()"
+  :data-testid="`set-action-variant-${experimentId}`"
+  ) Variant: {{ isPlayerEnrolled ? `${enrolledVariantId}` : 'None' }}
+  //- Set variant modal.
+  MActionModal(
+    ref="setVariantModal"
+    title="Manage Experiment Variant"
+    :action="updateVariant"
+    ok-button-label="Update Variant"
+    :ok-button-disabled-tooltip="okButtonDisabledTooltip"
+    @show="resetModal"
+    :data-testid="`set-action-variant-modal-${experimentId}`"
+    )
+    div(class="tw-space-y-3")
+      span(v-if="isPlayerEnrolled") #[MBadge {{ playerData.model.playerName }}] is enrolled in the #[span(class="tw-font-semibold") {{ enrolledVariantId }}] variant of the #[span(class="tw-font-semibold") {{ experimentName }}] experiment.
+      div(class="tw-text-xs+ tw-text-neutral-500") Select a new variant to move the player to a different group within the experiment. Moving a player to the control group has the same effect as removing a player from an experiment.
+
+      MInputSingleSelectDropdown(
+        label="Variant"
+        :model-value="variantId"
+        :options="variantOptions"
+        placeholder="Select a variant"
+        :hint-message="phaseHintMessage"
+        @update:model-value="(selectedVariant) => (variantId = selectedVariant ?? 'Control')"
+        data-testid="select-variant-dropdown"
+        )
+</template>
+
+<script lang="ts" setup>
+import type { ExperimentPhase } from '../../../experimentTypes'
+import { computed, ref, useTemplateRef } from 'vue'
+
+import { useGameServerApi } from '@metaplay/game-server-api'
+import {
+  MActionModal,
+  MBadge,
+  MTextButton,
+  useNotifications,
+  MInputSingleSelectDropdown,
+  type MInputSelectOption,
+} from '@metaplay/meta-ui-next'
+import { useSubscription } from '@metaplay/subscriptions'
+
+import { getSingleExperimentSubscriptionOptions } from '../../../subscription_options/experiments'
+import { getSinglePlayerSubscriptionOptions } from '../../../subscription_options/players'
+
+const props = defineProps<{
+  /**
+   * Id of the player to target.
+   */
+  playerId: string
+  /**
+   * Id of the experiment to target.
+   */
+  experimentId: string
+}>()
+
+const { showSuccessNotification } = useNotifications()
+
+const gameServerApi = useGameServerApi()
+
+/**
+ * Subscription data for the target player.
+ */
+const { data: playerData, refresh: playerRefresh } = useSubscription(getSinglePlayerSubscriptionOptions(props.playerId))
+
+/**
+ * Subscription data for the target experiment.
+ */
+const { data: experimentInfoData } = useSubscription(getSingleExperimentSubscriptionOptions(props.experimentId))
+
+/**
+ * Selected player's experiment data for the given experiment ID.
+ */
+const playerExperimentData = computed(() => playerData.value?.experiments?.[props.experimentId])
+
+/**
+ * Name of the target experiment.
+ */
+const experimentName = computed(() => experimentInfoData.value?.stats.displayName ?? props.experimentId)
+
+/**
+ * Reference to the modal for setting the experiment variant.
+ */
+const setVariantModal = useTemplateRef('setVariantModal')
+
+/**
+ * Check if the target player is enrolled in the experiment.
+ */
+const isPlayerEnrolled = computed((): boolean => playerExperimentData.value?.isPlayerEnrolled)
+
+/**
+ * The variant ID selected by the user in the dropdown.
+ * Note: Initialized empty and set properly via resetModal on @show.
+ */
+const variantId = ref<string>('Control')
+
+/**
+ * ID of the variant the player is currently enrolled in for the selected experiment.
+ */
+const enrolledVariantId = computed(() => {
+  return playerData.value?.model.experiments.experimentGroupAssignment?.[props.experimentId]?.variantId ?? 'Control'
+})
+
+/**
+ * Variant options for the selected experiment.
+ */
+const variantOptions = computed(() => {
+  const variants = experimentInfoData.value?.state.variants
+  const options: MInputSelectOption[] = []
+
+  // Add control option
+  options.push({
+    value: 'Control',
+    label: enrolledVariantId.value === 'Control' ? 'Control (current)' : 'Control',
+  })
+
+  // Add variant options
+  if (variants) {
+    for (const item of Object.keys(variants)) {
+      options.push({
+        value: item,
+        label: enrolledVariantId.value === item ? `${item} (current)` : item,
+      })
+    }
+  }
+
+  return options
+})
+
+/**
+ * Function to update the player's experiment variant.
+ */
+async function updateVariant(): Promise<void> {
+  const message = `${playerData.value?.model.playerName ?? 'Player'} changed experiment variant.`
+  const newVariantId = variantId.value === 'Control' ? null : variantId.value
+  await gameServerApi.post(`/players/${playerData.value?.id}/changeExperiment`, {
+    ExperimentId: props.experimentId,
+    VariantId: newVariantId,
+    IsTester: playerData.value?.experiments?.[props.experimentId]?.isPlayerTester ?? false,
+  })
+  showSuccessNotification(message)
+  playerRefresh()
+}
+
+/**
+ * Warning message shown when experiment is not active.
+ */
+const phaseHintMessage = computed(() => {
+  const isTester: boolean | undefined = playerExperimentData.value?.isPlayerTester
+  const experimentPhase: ExperimentPhase | undefined = experimentInfoData.value?.state.lifecyclePhase
+
+  if (experimentPhase && experimentPhase === 'Concluded') {
+    return "This experiment has concluded. Changes to the player's variant will take effect once the experiment is restarted."
+  } else if (!isTester) {
+    if (experimentPhase === 'Testing') {
+      return `This experiment is currently in the testing phase and is only active for testers. The player is not a tester in this experiment.`
+    } else if (experimentPhase === 'Paused') {
+      return `This experiment is currently paused and is only active for testers. The player is not a tester in this experiment.`
+    }
+  }
+  if (experimentPhase !== 'Ongoing') {
+    return 'The experiment is active for test players. Changes to the variant will force the player to reconnect!'
+  }
+  return 'The experiment is active. Changes to the variant will force the player to reconnect!'
+})
+
+/**
+ * Tooltip message for when the action is disabled.
+ */
+const actionButtonDisabledReason = computed(() => {
+  const invalid = experimentInfoData.value?.stats.whyInvalid
+  if (invalid) {
+    return `${invalid.isConfigDataMissing ? 'The experiment is' : 'Experiment variants are'} missing from the current game config.`
+  } else if (!isPlayerEnrolled.value) {
+    return `${playerData.value?.model.playerName ?? 'The Player'} is not enrolled in this experiment.`
+  }
+  return undefined
+})
+
+/**
+ * Check if target player is already enrolled in the currently selected variant.
+ */
+const isPlayerEnrolledInSelectedVariant = computed((): boolean => {
+  const currentVariant = playerData.value?.model.experiments.experimentGroupAssignment?.[props.experimentId]?.variantId
+  return (variantId.value === 'Control' && !currentVariant) || variantId.value === currentVariant
+})
+
+/**
+ * Tooltip message for the disabled "Update Variant" button.
+ */
+const okButtonDisabledTooltip = computed<string | undefined>(() => {
+  if (isPlayerEnrolledInSelectedVariant.value) {
+    return 'Select a new variant to proceed.'
+  }
+  return undefined
+})
+
+/**
+ * Resets the modal state when it is shown.
+ */
+function resetModal(): void {
+  variantId.value = enrolledVariantId.value
+}
+</script>
