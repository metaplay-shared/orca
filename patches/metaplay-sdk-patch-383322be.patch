diff --git a/MetaplaySDK/Client/Unity/Editor/BuiltinLocalizationBuildValidation.cs b/MetaplaySDK/Client/Unity/Editor/BuiltinLocalizationBuildValidation.cs
new file mode 100644
index 00000000..533046c2
--- /dev/null
+++ b/MetaplaySDK/Client/Unity/Editor/BuiltinLocalizationBuildValidation.cs
@@ -0,0 +1,81 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core;
+using Metaplay.Core.Localization;
+using Metaplay.Unity.Localization;
+using System;
+using System.IO;
+using UnityEditor.Build;
+using UnityEditor.Build.Reporting;
+using UnityEngine;
+
+namespace Metaplay.Unity
+{
+    /// <summary>
+    /// Validates the localization files that get baked in the client build
+    /// to guard against file corruption (such as CRLF mangling by git if
+    /// it mistakenly detects the localization file as a text file).
+    /// Broken baked-in localization files can prevent client startup
+    /// so it's important we catch those.
+    /// </summary>
+    public class BuiltinLocalizationBuildValidation : IPreprocessBuildWithReport
+    {
+        public int callbackOrder { get; } = -1;
+
+        public void OnPreprocessBuild(BuildReport report)
+        {
+            // Note: `Validate` produces dedicated BuildFailedException for per-language-loading errors,
+            // but for other unexpected errors we still have a catch-all here to fail the build.
+            try
+            {
+                Validate();
+            }
+            catch (Exception ex) when (ex is not BuildFailedException)
+            {
+                throw new BuildFailedException($"Metaplay: localizations failed to be loaded. Stopping the build, because broken localization files can cause the client SDK to be unusable. Exception was: {ex}");
+            }
+        }
+
+        void Validate()
+        {
+            if (!MetaplayCore.Options.FeatureFlags.EnableLocalizations)
+                return;
+
+            BuiltinLanguageRepository.Initialize();
+
+            MetaDictionary<LanguageId, ContentHash> languages = BuiltinLanguageRepository.GetBuiltinLanguages();
+
+            int numFailedLocalizations = 0;
+
+            foreach ((LanguageId languageId, ContentHash localizationVersion) in languages)
+            {
+                try
+                {
+                    string filePath = BuiltinLanguageRepository.GetBuiltinLocalizationFilePath(languageId);
+                    byte[] bytes = FileUtil.ReadAllBytes(filePath);
+                    _ = LocalizationLanguage.FromBytes(languageId, localizationVersion, bytes);
+                }
+                catch (Exception ex)
+                {
+                    string explanation;
+                    if (ex is FileNotFoundException)
+                        explanation = $"Please make sure localizations have been built and the files exist in {BuiltinLanguageRepository.GetBuiltinLocalizationsDir()} .";
+                    else
+                    {
+                        explanation =
+                            $"The localization file {BuiltinLanguageRepository.GetBuiltinLocalizationFilePath(languageId)} may be corrupted. " +
+                            $"This can happen if git detects it as a text file, instead of binary, and performs automatic newline conversion. " +
+                            $"Please build the localizations and make sure to add them to the repository without newline conversion. " +
+                            $"In git, put lines '*.mpc binary' and '*.mpa binary' (without the quotes) in your .gitattributes file to ensure git treats the files as binary.";
+                    }
+
+                    Debug.LogError($"Metaplay: failed to load localization '{languageId}'. {explanation} Exception was: {ex}");
+                    numFailedLocalizations++;
+                }
+            }
+
+            if (numFailedLocalizations != 0)
+                throw new BuildFailedException($"Metaplay: {numFailedLocalizations} localization(s) failed to be loaded. Please see logged errors above. Stopping the build, because broken localization files can cause the client SDK to be unusable.");
+        }
+    }
+}
