diff --git a/MetaplaySDK/Client/Core/Config/SimpleCsvReader.cs b/MetaplaySDK/Client/Core/Config/SimpleCsvReader.cs
new file mode 100644
index 00000000..492958d4
--- /dev/null
+++ b/MetaplaySDK/Client/Core/Config/SimpleCsvReader.cs
@@ -0,0 +1,232 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using System;
+using System.Collections.Generic;
+using System.Text;
+
+namespace Metaplay.Core.Config
+{
+    /// <summary>
+    /// In-memory CSV parser. Takes a <c>byte[]</c> of UTF-8 (or ASCII) encoded data
+    /// as input and converts it into unescaped cell values.
+    /// </summary>
+    public static class SimpleCsvReader
+    {
+        static void ThrowIfUnsupportedFormat(ReadOnlySpan<byte> input)
+        {
+            if (input.Length >= 4 && input[0] == 0xFF && input[1] == 0xFE && input[2] == 0x00 && input[3] == 0x00)
+                throw new ParseError("CSV data appears to be UTF-32 LE encoded. Re-save the file as UTF-8.");
+            if (input.Length >= 4 && input[0] == 0x00 && input[1] == 0x00 && input[2] == 0xFE && input[3] == 0xFF)
+                throw new ParseError("CSV data appears to be UTF-32 BE encoded. Re-save the file as UTF-8.");
+            if (input.Length >= 2 && input[0] == 0xFF && input[1] == 0xFE)
+                throw new ParseError("CSV data appears to be UTF-16 LE encoded. Re-save the file as UTF-8.");
+            if (input.Length >= 2 && input[0] == 0xFE && input[1] == 0xFF)
+                throw new ParseError("CSV data appears to be UTF-16 BE encoded. Re-save the file as UTF-8.");
+            if (input.Length >= 4 && input[0] == 0x50 && input[1] == 0x4B && input[2] == 0x03 && input[3] == 0x04)
+                throw new ParseError("Data appears to be a ZIP/XLSX file, not a CSV file.");
+            if (input.Length >= 4 && input[0] == 0xD0 && input[1] == 0xCF && input[2] == 0x11 && input[3] == 0xE0)
+                throw new ParseError("Data appears to be an Excel .xls file, not a CSV file.");
+        }
+
+        static char DetectSeparator(ReadOnlySpan<byte> input)
+        {
+            // Check if there's more commas or semicolons at end of each line
+            int commaCount = 0;
+            int semicolonCount = 0;
+            for (int ndx = 0; ndx < input.Length; ndx++)
+            {
+                byte c = input[ndx];
+                commaCount += (c == ',') ? 1 : 0;
+                semicolonCount += (c == ';') ? 1 : 0;
+
+                // At each newline, check for a winner
+                if (c == '\n')
+                {
+                    if (commaCount > semicolonCount)
+                        return ',';
+                    else if (semicolonCount > commaCount)
+                        return ';';
+                }
+            }
+
+            // Final check
+            if (commaCount > semicolonCount)
+                return ',';
+            else if (semicolonCount > commaCount)
+                return ';';
+            else
+                return ','; // Default to comma when separator cannot be determined (e.g. single-column CSV)
+        }
+
+        /// <summary>
+        /// Takes a <c>byte[]</c> representing UTF-8 data of a CSV file and converts it into unescaped cell values.
+        /// <para>
+        /// This parser deviates from RFC4180 by allowing rows to have differing number of fields.
+        /// </para>
+        /// </summary>
+        /// <param name="separator">Separator used in CSV. If no separator is given, it is autodetected</param>
+        /// <exception cref="ParseError">if content is malformed CSV</exception>
+        public static List<List<string>> ReadAllRows(ReadOnlySpan<byte> input, char separator = '\0')
+        {
+            if (input.Length == 0)
+                throw new ParseError("No data to parse");
+
+            ThrowIfUnsupportedFormat(input);
+
+            // Skip UTF-8 BOM if present
+            if (input.Length >= 3 && input[0] == 0xEF && input[1] == 0xBB && input[2] == 0xBF)
+                input = input.Slice(3);
+
+            // Auto-detect separator (if not specified)
+            separator = (separator != '\0') ? separator : DetectSeparator(input);
+
+            // Parse all rows
+            List<List<string>>  outRows         = new List<List<string>>();
+            int                 rowStartOffset  = 0;
+            while (true)
+            {
+                // Parse a single row (can span multiple lines)
+                List<string>    rowCells        = new List<string>();
+                int             offset          = rowStartOffset;
+
+                while (true)
+                {
+                    // Check if we have a quoted input (skip over initial quote if yes)
+                    bool isQuoted = offset < input.Length && input[offset] == '"';
+                    int lineNum = outRows.Count + 1;
+                    int cellNum = rowCells.Count + 1;
+                    int cellStart, cellEnd;
+
+                    if (isQuoted)
+                    {
+                        cellStart = offset + 1;
+                        cellEnd = FindQuotedCellEnd(offset + 1, input, cellNum, lineNum, rowStartOffset);
+                        offset = cellEnd + 1;
+                    }
+                    else
+                    {
+                        cellStart = offset;
+                        cellEnd = FindUnquotedCellEnd(offset, input, separator, cellNum, lineNum, rowStartOffset);
+                        offset = cellEnd;
+                    }
+
+                    // Add cell to row
+                    string unescaped = Unescape(isQuoted, input.Slice(cellStart, cellEnd - cellStart));
+                    rowCells.Add(unescaped);
+
+                    // After a cell, there must be a separator, line-separator or end-of-file
+                    // * Line-separator and end-of-file terminate the row
+                    // * Separator continues the row
+
+                    if (offset >= input.Length)
+                        break;
+                    if (input[offset] == '\r' && offset + 1 < input.Length && input[offset + 1] == '\n')
+                    {
+                        offset += 2;
+                        break;
+                    }
+                    if (input[offset] == '\n' || input[offset] == '\r')
+                    {
+                        offset += 1;
+                        break;
+                    }
+
+                    if (input[offset] == (byte)separator)
+                    {
+                        offset += 1;
+                        continue;
+                    }
+
+                    throw new ParseError(FormattableString.Invariant($"On line {lineNum} column {offset - rowStartOffset + 1} has invalid data between cell content and separator: '{(char)input[offset]}'"));
+                }
+
+                // Add row to output
+                outRows.Add(rowCells);
+
+                // If at end, we're done
+                if (offset >= input.Length)
+                    return outRows;
+
+                // Skip to next line
+                rowStartOffset = offset;
+            }
+        }
+
+        /// <summary>
+        /// Returns the cell end. End is immediately before the single doublequote character.
+        /// </summary>
+        static int FindQuotedCellEnd(int offset, ReadOnlySpan<byte> input, int cellNum, int lineNum, int rowStartOffset)
+        {
+            int cursor = offset;
+
+            for (;;)
+            {
+                ReadOnlySpan<byte> tail = input.Slice(cursor);
+
+                int nextDoubleQuote = tail.IndexOf((byte)'\"');
+                if (nextDoubleQuote == -1)
+                    throw new ParseError(FormattableString.Invariant($"On line {lineNum} column {cursor - rowStartOffset + 1}, cell {cellNum} is missing the ending quote"));
+
+                if (nextDoubleQuote == tail.Length - 1 || tail[nextDoubleQuote + 1] != '"')
+                {
+                    // single quote.
+                    return cursor + nextDoubleQuote;
+                }
+                else
+                {
+                    // double quote. Not cell end, keep looking
+                    cursor += nextDoubleQuote + 2;
+                }
+            }
+        }
+
+        /// <summary>
+        /// Returns the cell end. End is at the next separator, line separator, or end-of-file.
+        /// </summary>
+        static int FindUnquotedCellEnd(int offset, ReadOnlySpan<byte> input, char separator, int cellNum, int lineNum, int rowStartOffset)
+        {
+            int cursor = offset;
+
+            for (;;)
+            {
+                if (cursor == input.Length)
+                    return cursor;
+
+                byte c = input[cursor];
+                if (c == (byte)separator || c == (byte)'\r' || c == (byte)'\n')
+                    return cursor;
+                else if (c == (byte)'\"')
+                    throw new ParseError(FormattableString.Invariant($"On line {lineNum} column {cursor - rowStartOffset + 1}, cell has unquoted \" character."));
+
+                cursor++;
+            }
+        }
+
+        static string Unescape(bool isQuoted, ReadOnlySpan<byte> input)
+        {
+            if (isQuoted)
+            {
+                // \todo Optimize
+                string str = Encoding.UTF8.GetString(input);
+                char[] dst = new char[str.Length];
+                int dstNdx = 0;
+                for (int srcNdx = 0; srcNdx < str.Length; srcNdx++)
+                {
+                    char c = str[srcNdx];
+                    if (c == '"' && srcNdx + 1 < str.Length && str[srcNdx + 1] == '"')
+                    {
+                        dst[dstNdx++] = '"';
+                        srcNdx++; // skip double quote
+                    }
+                    else
+                        dst[dstNdx++] = c;
+                }
+                return new string(dst, 0, dstNdx);
+            }
+            else
+            {
+                return Encoding.UTF8.GetString(input);
+            }
+        }
+    }
+}
