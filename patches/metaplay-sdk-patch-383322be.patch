+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core;
+using Metaplay.Core.Message;
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Metaplay.Unity
+{
+    partial class MetaplayConnection
+    {
+        class Marker
+        {
+            public enum MarkerKind
+            {
+                UpdateComplete,
+                Call,
+                DispatchMessage
+            }
+            public MetaMessage Message;
+            public SessionMessageDispatcher SessionMessageDispatcher;
+            ICaller _caller;
+
+            Marker() { }
+            Marker(MetaMessage message, SessionMessageDispatcher sessionMessageDispatcher)
+            {
+                Message = message;
+                SessionMessageDispatcher = sessionMessageDispatcher;
+            }
+            Marker(ICaller caller) { _caller = caller; }
+
+            public MarkerKind GetKind()
+            {
+                if (Message != null)
+                    return MarkerKind.DispatchMessage;
+                if (_caller != null)
+                    return MarkerKind.Call;
+                return MarkerKind.UpdateComplete;
+            }
+
+            public void Call()
+            {
+                _caller?.Call();
+            }
+
+            public bool PollComplete()
+            {
+                if (_caller != null)
+                    return _caller.PollComplete();
+                return true;
+            }
+
+            interface ICaller
+            {
+                public void Call();
+                public bool PollComplete();
+            }
+
+            class AsyncCaller<T> : ICaller
+            {
+                public Func<Task<T>> Factory;
+                public CancellationToken Ct;
+                public DateTime Deadline;
+                public CallResult<T> Result;
+
+                public AsyncCaller(Func<Task<T>> factory, CancellationToken ct, DateTime deadline, CallResult<T> result)
+                {
+                    Factory = factory;
+                    Ct = ct;
+                    Deadline = deadline;
+                    Result = result;
+                }
+
+                public void Call()
+                {
+                    if (Ct.IsCancellationRequested)
+                    {
+                        Result.Task = Task.FromCanceled<T>(Ct);
+                        return;
+                    }
+
+                    // Capture synchronous exceptions
+                    try
+                    {
+                        Task<T> task = Factory();
+
+                        // Synchronous call Closed the loop?
+                        if (Ct.IsCancellationRequested)
+                            Result.Task = Task.FromCanceled<T>(Ct);
+                        else
+                            Result.Task = task;
+                    }
+                    catch (Exception ex)
+                    {
+                        Result.Task = Task.FromException<T>(ex);
+                    }
+                }
+
+                public bool PollComplete()
+                {
+                    // \note: Not a cooperative cancel. After cancel, even sync calls
+                    //        cancel. This is important for recursive calls to Close.
+                    if (Ct.IsCancellationRequested)
+                    {
+                        // Switch the return value to a canceled Task to avoid
+                        // accessing the contents.
+                        Result.Task = Task.FromCanceled<T>(Ct);
+                        return true;
+                    }
+                    if (Result.Task == null)
+                    {
+                        // Result.Task is be null if we got here synchronously from Call().
+                        // We are still in the Call() so we cant be Complete.
+                        return false;
+                    }
+                    if (Result.Task.IsCompleted)
+                        return true;
+                    if (Deadline != default && DateTime.UtcNow >= Deadline)
+                        return true;
+                    return false;
+                }
+            }
+            public class CallResult<T>
+            {
+                public Task<T> Task;
+
+                public bool IsCompletedSuccessfully => Task.IsCompletedSuccessfully;
+                public T Result => Task.GetCompletedResult();
+                public Exception Exception => Task.Exception.InnerException;
+            }
+
+            class AsyncCaller : ICaller
+            {
+                public Func<Task> Factory;
+                public CancellationToken Ct;
+                public DateTime Deadline;
+                public CallResult Result;
+
+                public AsyncCaller(Func<Task> factory, CancellationToken ct, DateTime deadline, CallResult result)
+                {
+                    Factory = factory;
+                    Ct = ct;
+                    Deadline = deadline;
+                    Result = result;
+                }
+
+                public void Call()
+                {
+                    if (Ct.IsCancellationRequested)
+                    {
+                        Result.Task = Task.FromCanceled(Ct);
+                        return;
+                    }
+
+                    // Capture synchronous exceptions
+                    try
+                    {
+                        Task task = Factory();
+
+                        // Synchronous call Closed the loop?
+                        if (Ct.IsCancellationRequested)
+                            Result.Task = Task.FromCanceled(Ct);
+                        else
+                            Result.Task = task;
+                    }
+                    catch (Exception ex)
+                    {
+                        Result.Task = Task.FromException(ex);
+                    }
+                }
+
+                public bool PollComplete()
+                {
+                    // \note: Not a cooperative cancel. After cancel, even sync calls
+                    //        cancel. This is important for recursive calls to Close.
+                    if (Ct.IsCancellationRequested)
+                    {
+                        // Switch the return value to a canceled Task to avoid
+                        // accessing the contents.
+                        Result.Task = Task.FromCanceled(Ct);
+                        return true;
+                    }
+                    if (Result.Task == null)
+                    {
+                        // Result.Task is be null if we got here synchronously from Call().
+                        // We are still in the Call() so we cant be Complete.
+                        return false;
+                    }
+                    if (Result.Task.IsCompleted)
+                        return true;
+                    if (Deadline != default && DateTime.UtcNow >= Deadline)
+                        return true;
+                    return false;
+                }
+            }
+            public class CallResult
+            {
+                public Task Task;
+
+                public bool IsCompletedSuccessfully => Task.IsCompletedSuccessfully;
+                public Exception Exception => Task.Exception.InnerException;
+            }
+
+            /// <summary>
+            /// Calls async method and awaits it to complete. In case of a cancellation,
+            /// the task completes as Canceled.
+            /// If a deadline is specified, the yielded execution continues when the
+            /// deadline is reached, regardless if the method is complete or not.
+            /// </summary>
+            public static Marker CallAsync<T>(Func<Task<T>> factory, CancellationToken ct, out CallResult<T> result) => CallAsync(factory, ct, default(DateTime), out result);
+
+            /// <inheritdoc cref="CallAsync{T}(Func{Task{T}}, CancellationToken, out CallResult{T})"/>
+            public static Marker CallAsync<T>(Func<Task<T>> factory, CancellationToken ct, DateTime deadline, out CallResult<T> result)
+            {
+                if (!ct.CanBeCanceled)
+                {
+                    // Cancellation must always be set. We need cancel to exit due to Close(),
+                    // and Close might be called anywhere, even from a sync method.
+                    throw new ArgumentException("Cancellation token must be set.");
+                }
+                result = new CallResult<T>();
+                return new Marker(new AsyncCaller<T>(factory, ct, deadline, result));
+            }
+
+            /// <inheritdoc cref="CallAsync{T}(Func{Task{T}}, CancellationToken, out CallResult{T})"/>
+            public static Marker CallAsync(Func<Task> factory, CancellationToken ct, out CallResult result) => CallAsync(factory, ct, default(DateTime), out result);
+
+            /// <inheritdoc cref="CallAsync{T}(Func{Task{T}}, CancellationToken, out CallResult{T})"/>
+            public static Marker CallAsync(Func<Task> factory, CancellationToken ct, DateTime deadline, out CallResult result)
+            {
+                if (!ct.CanBeCanceled)
+                {
+                    // Cancellation must always be set. We need cancel to exit due to Close(),
+                    // and Close might be called anywhere, even from a sync method.
+                    throw new ArgumentException("Cancellation token must be set.");
+                }
+                result = new CallResult();
+                return new Marker(new AsyncCaller(factory, ct, deadline, result));
+            }
+
+            /// <summary>
+            /// Calls sync method. In case of a cancellation, the task completes as Canceled.
+            /// </summary>
+            public static Marker CallSync<T>(Func<T> factory, CancellationToken ct, out CallResult<T> result)
+            {
+                if (!ct.CanBeCanceled)
+                {
+                    // Cancellation must always be set. We need cancel to exit due to Close(),
+                    // and Close might be called anywhere, even from a sync method.
+                    throw new ArgumentException("Cancellation token must be set.");
+                }
+                result = new CallResult<T>();
+                return new Marker(new AsyncCaller<T>(() => Task.FromResult<T>(factory()), ct, default(DateTime), result));
+            }
+
+            /// <inheritdoc cref="CallSync{T}(Func{T}, CancellationToken, out CallResult{T})"/>
+            public static Marker CallSync(Action factory, CancellationToken ct, out CallResult result)
+            {
+                if (!ct.CanBeCanceled)
+                {
+                    // Cancellation must always be set. We need cancel to exit due to Close(),
+                    // and Close might be called anywhere, even from a sync method.
+                    throw new ArgumentException("Cancellation token must be set.");
+                }
+                result = new CallResult();
+                return new Marker(new AsyncCaller(() => { factory(); return Task.CompletedTask; }, ct, default(DateTime), result));
+            }
+
+            /// <summary>
+            /// Awaits given task it to complete before continuing execution.
+            /// If a deadline is specified, the yielded execution continues when the
+            /// deadline is reached, regardless if the task is complete or not.
+            /// </summary>
+            public static Marker WaitTask(Task task, CancellationToken ct, DateTime deadline = default)
+            {
+                return CallAsync(() => task, ct, deadline, out CallResult _);
+            }
+
+            /// <summary>
+            /// Dispatches the message and returns
+            /// </summary>
+            public static Marker DispatchMessage(MetaMessage message, SessionMessageDispatcher sessionMessageDispatcher)
+            {
+                return new Marker(message, sessionMessageDispatcher);
+            }
+
+            /// <summary>
+            /// Signals the supervisor loops is done for this frame.
+            /// </summary>
+            public static Marker UpdateComplete()
+            {
+                return new Marker();
+            }
+
+        }
+    }
+}
