@@ -0,0 +1,60 @@
+<!-- This file is part of Metaplay SDK which is released under the Metaplay SDK License. -->
+
+<template lang="pug">
+ReferenceBaseCard(
+  :reference-data="segmentReferenceData"
+  data-testid="player-segment-detail-references-card"
+  )
+</template>
+
+<script setup lang="ts">
+import { computed } from 'vue'
+
+import { useSubscription } from '@metaplay/subscriptions'
+
+import { getSinglePlayerSegmentSubscriptionOptions } from '../../subscription_options/general'
+import ReferenceBaseCard from '../global/ReferenceBaseCard.vue'
+import type { ReferenceData } from '../global/ReferenceBaseCard.vue'
+
+const props = defineProps<{
+  segmentId: string
+}>()
+
+/**
+ * Subscribe to the selected segment's data.
+ */
+const { data: singlePlayerSegmentData } = useSubscription(getSinglePlayerSegmentSubscriptionOptions(props.segmentId))
+
+interface SegmentReferenceData {
+  $type: string
+  type: string
+  subtype?: string
+  id: string
+  displayName: string
+  activableCategoryId?: string
+}
+
+/**
+ * List of places where this segment is referenced.
+ */
+const segmentReferenceData = computed((): ReferenceData[] => {
+  const references = singlePlayerSegmentData.value?.details.usedBy ?? []
+  return references.map((referenceSource: SegmentReferenceData) => {
+    if (referenceSource.type === 'Activable') {
+      return {
+        type: referenceSource.type,
+        subtype: referenceSource.subtype,
+        displayName: referenceSource.displayName,
+        id: referenceSource.id,
+      }
+    } else {
+      return {
+        type: referenceSource.type,
+        subtype: referenceSource.subtype,
+        displayName: referenceSource.displayName,
+        id: referenceSource.id,
+      }
+    }
+  })
+})
+</script>
