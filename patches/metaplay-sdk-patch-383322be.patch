+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core.Network;
+
+namespace Metaplay.Core.Message
+{
+    /// <summary>
+    /// A message dispatcher that lives only for the duration of the session.
+    /// </summary>
+    public class SessionMessageDispatcher : BasicMessageDispatcher
+    {
+        ServerConnection _sessionServerConnection;
+        public override ServerConnection ServerConnection => _sessionServerConnection;
+
+        public SessionMessageDispatcher(LogChannel log, ServerConnection sessionServerConnection) : base(log)
+        {
+            _sessionServerConnection = sessionServerConnection;
+        }
+
+        protected override bool SendMessageInternal(MetaMessage message)
+        {
+            return _sessionServerConnection?.EnqueueSendMessage(message) ?? false;
+        }
+
+        internal new bool DispatchMessage(MetaMessage message) => base.DispatchMessage(message);
+
+        internal void EndSession()
+        {
+            _sessionServerConnection = null;
+        }
+    }
+}
