@@ -0,0 +1,58 @@
+<!-- This file is part of Metaplay SDK which is released under the Metaplay SDK License. -->
+<template lang="pug">
+ReferenceBaseCard(
+  :reference-data="referenceData"
+  data-testid="offer-reference-list-card"
+  )
+</template>
+
+<script setup lang="ts">
+import { computed } from 'vue'
+
+import { useSubscription } from '@metaplay/subscriptions'
+
+import { getSingleOfferSubscriptionOptions } from '../../subscription_options/offers'
+import type { ReferenceData } from '../global/ReferenceBaseCard.vue'
+import ReferenceBaseCard from '../global/ReferenceBaseCard.vue'
+
+const props = defineProps<{
+  offerId: string
+}>()
+
+/**
+ * Subscribe to the selected offer's data.
+ */
+const { data: singleOfferData } = useSubscription(getSingleOfferSubscriptionOptions(props.offerId))
+
+interface OfferReferenceData {
+  $type: string
+  type: string
+  id: string
+  displayName: string
+}
+
+/**
+ * List of places where this offer is referenced.
+ */
+const referenceData = computed((): ReferenceData[] => {
+  return (
+    singleOfferData.value?.usedBy.map((reference: OfferReferenceData) => {
+      if (reference.type === 'OfferGroup') {
+        return {
+          type: 'Activable',
+          subtype: reference.type,
+          displayName: reference.displayName,
+          id: reference.id,
+        }
+      } else {
+        return {
+          type: reference.type,
+          subtype: reference.type,
+          displayName: reference.displayName,
+          id: reference.id,
+        }
+      }
+    }) ?? []
+  )
+})
+</script>
