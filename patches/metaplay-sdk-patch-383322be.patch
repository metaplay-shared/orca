+    internal static class SpreadsheetParser
+    {
+        /// <summary>
+        /// Parses CSV data into a spreadsheet.
+        /// <para>
+        /// All comment rows and columns are removed. A comment row/column is a row/column
+        /// where the first cell has a value starting with "//".
+        /// </para>
+        /// </summary>
+        /// <param name="name">Name set in SpreadsheetContent.Name</param>
+        /// <param name="data">CSV data as bytes</param>
+        /// <param name="sourceInfo">Source info for SpreadsheetContent.SourceInfo</param>
+        /// <param name="stripTrailingEmptyCells">true if empty cells should be removed at the end of each row</param>
+        /// <exception cref="ParseError">On invalid CSV</exception>
+        internal static SpreadsheetContent Parse(string name, byte[] data, SpreadsheetFileSourceInfo sourceInfo, bool stripTrailingEmptyCells)
+        {
+            if (sourceInfo == null)
+                throw new ArgumentNullException(nameof(sourceInfo));
+
+            List<List<SpreadsheetCell>> rows = SpreadsheetContent.ContentToCells(SimpleCsvReader.ReadAllRows(data));
+
+            // Remove comment rows
+            for (int row = 0; row < rows.Count;)
+            {
+                if (rows[row].Count > 0 && rows[row][0].Value.StartsWith("//", StringComparison.Ordinal))
+                    rows.RemoveAt(row);
+                else
+                    row++;
+            }
+
+            // Remove comment columns
+            for (int col = 0; col < (rows.Count > 0 ? rows[0].Count : 0);)
+            {
+                if (rows[0][col].Value.StartsWith("//", StringComparison.Ordinal))
+                {
+                    for (int row = 0; row < rows.Count; ++row)
+                    {
+                        if (rows[row].Count > col)
+                            rows[row].RemoveAt(col);
+                    }
+                }
+                else
+                    ++col;
+            }
+
+            // Strip trailing empty cells
+            if (stripTrailingEmptyCells)
+            {
+                foreach (List<SpreadsheetCell> row in rows)
+                {
+                    int numCells = row.Count;
+                    while (numCells > 0 && row[numCells - 1].Value == "")
+                        numCells--;
+                    row.RemoveRange(numCells, row.Count - numCells);
+                }
+            }
+
+            return new SpreadsheetContent(name, rows, sourceInfo);
+        }
     }
 }
