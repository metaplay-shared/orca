+        [Test]
+        public void TestMultiLineCell()
+        {
+            string content = "A;\"B\nC\";D\r\n1;\"2\r\n2\n2\n\n2\"";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells.Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheet.Cells[0][1].Value, Is.EqualTo("B\nC"));
+            Assert.That(spreadsheet.Cells[0][2].Value, Is.EqualTo("D"));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo("1"));
+            Assert.That(spreadsheet.Cells[1][1].Value, Is.EqualTo("2\r\n2\n2\n\n2"));
+        }
+
+        [Test]
+        public void TestTrailingEmptyCells()
+        {
+            string content = "A;B\n\n// This is a comment\n1;2;;\n\n";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content), stripTrailingEmptyCells: false);
+
+            Assert.That(spreadsheet.Cells.Count, Is.EqualTo(4)); // There is no empty row after the \n and file end, but comment line is stripped
+            Assert.That(spreadsheet.Cells[0].Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[1].Count, Is.EqualTo(1)); // empty line -> single empty cell
+            Assert.That(spreadsheet.Cells[2].Count, Is.EqualTo(4));
+            Assert.That(spreadsheet.Cells[3].Count, Is.EqualTo(1)); // empty line -> single empty cell
+
+            Assert.That(spreadsheet.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheet.Cells[0][1].Value, Is.EqualTo("B"));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo(""));
+            Assert.That(spreadsheet.Cells[2][0].Value, Is.EqualTo("1"));
+            Assert.That(spreadsheet.Cells[2][1].Value, Is.EqualTo("2"));
+            Assert.That(spreadsheet.Cells[2][2].Value, Is.EqualTo(""));
+            Assert.That(spreadsheet.Cells[2][3].Value, Is.EqualTo(""));
+            Assert.That(spreadsheet.Cells[3][0].Value, Is.EqualTo(""));
+
+            // Skipped comment line
+            Assert.That(spreadsheet.Cells[1][0].Row, Is.EqualTo(1)); // before comment line
+            Assert.That(spreadsheet.Cells[2][0].Row, Is.EqualTo(3)); // after comment line
+        }
+
+        [Test]
+        public void TestTrailingEmptyCellsStripped()
+        {
+            string content = "A;B\n1;2;;\n3;";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells[0].Count, Is.EqualTo(2)); // "A", "B"
+            Assert.That(spreadsheet.Cells[1].Count, Is.EqualTo(2)); // "1", "2" — trailing empties stripped
+            Assert.That(spreadsheet.Cells[2].Count, Is.EqualTo(1)); // "3" — trailing empty stripped
+        }
+
+        [Test]
+        public void TestRaggedRows()
+        {
+            string content = "A;B;C\n1\n2;3";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells.Count, Is.EqualTo(3));
+            Assert.That(spreadsheet.Cells[0].Count, Is.EqualTo(3));
+            Assert.That(spreadsheet.Cells[1].Count, Is.EqualTo(1));
+            Assert.That(spreadsheet.Cells[2].Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo("1"));
+            Assert.That(spreadsheet.Cells[2][0].Value, Is.EqualTo("2"));
+            Assert.That(spreadsheet.Cells[2][1].Value, Is.EqualTo("3"));
+        }
+
+        [Test]
+        public void TestGameConfigHelperParseCsv()
+        {
+            string content = "Id;Value\n1;hello";
+            SpreadsheetContent spreadsheet = GameConfigHelper.ParseCsvToSpreadsheet("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells.Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[0][0].Value, Is.EqualTo("Id"));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo("1"));
+            Assert.That(spreadsheet.Cells[1][1].Value, Is.EqualTo("hello"));
+            Assert.That(spreadsheet.Name, Is.EqualTo("test.csv"));
+        }
+    }
+}
