diff --git a/MetaplaySDK/Client/Metaplay.Core.Tests/GameConfigOverlappingEntryNamesTests.cs b/MetaplaySDK/Client/Metaplay.Core.Tests/GameConfigOverlappingEntryNamesTests.cs
new file mode 100644
index 00000000..6e3f5458
--- /dev/null
+++ b/MetaplaySDK/Client/Metaplay.Core.Tests/GameConfigOverlappingEntryNamesTests.cs
@@ -0,0 +1,52 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core.Config;
+using Metaplay.Core.Model;
+using NUnit.Framework;
+using System;
+using System.Collections.Generic;
+
+namespace Metaplay.Core.Tests
+{
+    /// <summary>
+    /// Tests that SharedGameConfig and ServerGameConfig cannot have overlapping entry names.
+    /// </summary>
+    public class GameConfigOverlappingEntryNamesTests : IsolatedIntegrationTest
+    {
+        // Disable automatic MetaplayCore initialization, we'll call it manually.
+        protected override IEnumerable<string> IntegrationScopeIds => Array.Empty<string>();
+
+        [MetaSerializable]
+        public class TestKeyValue : GameConfigKeyValue<TestKeyValue>
+        {
+            [MetaMember(1)] public int Value;
+        }
+
+        public class OverlappingSharedGameConfig : SharedGameConfigBase
+        {
+            [GameConfigEntry("OverlappingEntry")] TestKeyValue SharedEntry { get; set; }
+        }
+
+        public class OverlappingServerGameConfig : ServerGameConfigBase
+        {
+            [GameConfigEntry("OverlappingEntry")] TestKeyValue ServerEntry { get; set; }
+        }
+
+        [Test]
+        public void TestOverlappingEntryNamesThrows()
+        {
+            InvalidOperationException ex = Assert.Throws<InvalidOperationException>(() =>
+            {
+                TestHelper.SetIntegrationContext(new[] { nameof(GameConfigOverlappingEntryNamesTests) });
+            });
+
+            // The outer exception is from MetaplayCore initialization
+            Assert.That(ex.InnerException, Is.InstanceOf<InvalidOperationException>());
+
+            // The inner exception contains the actual validation error
+            InvalidOperationException innerEx = (InvalidOperationException)ex.InnerException;
+            Assert.That(innerEx.Message, Does.Contain("overlapping entry names"));
+            Assert.That(innerEx.Message, Does.Contain("OverlappingEntry"));
+        }
+    }
+}
