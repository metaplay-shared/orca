+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+// ===================================================================================
+// DATABASE SNAPSHOT INGESTER - DISASTER RECOVERY GUIDE
+// ===================================================================================
+//
+// This tool allows you to restore a database from an RDS snapshot that has been
+// exported to S3 as Parquet files. This is useful for disaster recovery scenarios.
+//
+// PREREQUISITES:
+// --------------
+// 1. An RDS snapshot exported to S3 as Parquet files
+//    - In AWS Console: RDS > Snapshots > Select snapshot > Actions > Export to Amazon S3
+//    - Choose Parquet format
+//    - Note the S3 bucket, export name, and database name
+//
+// 2. The target database must be set up with the correct schema (migrations applied)
+//
+// 3. For best results, start with empty tables (or use InsertOrIgnore mode)
+//
+// 4. The server/pod must have IAM permissions to read from the S3 bucket
+//    (e.g., via IRSA in Kubernetes or EC2 instance role)
+//
+// CONFIGURATION:
+// --------------
+// Configure via environment variables or Options.yaml. Example Options.yaml:
+//
+//   DatabaseIngest:
+//     Mode: ForceIngestOnExisting
+//     S3Region: eu-west-1
+//     S3Bucket: my-rds-exports-bucket
+//     ExportNames:
+//       - my-export-shard-0
+//       - my-export-shard-1
+//     DatabaseName: myapp_production
+//     WorkersPerShard: 4
+//     BulkInsertMode: InsertOrIgnore
+//
+// Or via environment variables:
+//
+//   Metaplay_DatabaseIngest__Mode=ForceIngestOnExisting
+//   Metaplay_DatabaseIngest__S3Region=eu-west-1
+//   Metaplay_DatabaseIngest__S3Bucket=my-rds-exports-bucket
+//   Metaplay_DatabaseIngest__ExportNames__0=my-export-shard-0
+//   Metaplay_DatabaseIngest__ExportNames__1=my-export-shard-1
+//   Metaplay_DatabaseIngest__DatabaseName=myapp_production
+//
+// Or via command-line arguments (useful for one-off DR runs):
+//
+//   ./Server \
+//     --DatabaseIngest:Mode=ForceIngestOnExisting \
+//     --DatabaseIngest:S3Region=eu-west-1 \
+//     --DatabaseIngest:S3Bucket=my-rds-exports-bucket \
+//     --DatabaseIngest:ExportNames:0=my-export-shard-0 \
+//     --DatabaseIngest:ExportNames:1=my-export-shard-1 \
+//     --DatabaseIngest:DatabaseName=myapp_production \
+//     --DatabaseIngest:WorkersPerShard=4 \
+//     --Database:MaxConnectionsPerShard=1000 \
+//     --Database:Shards:0:ReadWriteHost=$DB_HOST \
+//     --Database:Shards:0:ReadOnlyHost=$DB_HOST \
+//     --Database:Shards:0:DatabaseName=$DB_NAME \
+//     --Database:Shards:0:UserId=$DB_USER \
+//     --Database:Shards:0:Password=$DB_PWD
+//
+// CONFIGURATION OPTIONS:
+// ----------------------
+// Mode              - Disable (default) or ForceIngestOnExisting
+// S3Region          - AWS region where the S3 bucket is located (e.g., "eu-west-1")
+// S3Bucket          - Name of the S3 bucket containing the Parquet export
+// S3BasePaths       - Optional base paths within bucket for each shard (array, defaults to empty)
+// ExportNames       - Array of export task names, one per shard (e.g., ["shard0-export", "shard1-export"])
+// DatabaseName      - Name of the database within the export (e.g., "myapp_production")
+// TableFilter       - Optional: only ingest a specific table (e.g., "Players")
+// SnapshotTableSuffix - Optional: suffix to strip from snapshot table names when mapping to target tables
+// WorkersPerShard   - Number of parallel workers per shard (default: 2, increase for faster ingestion)
+// BulkInsertMode    - InsertOrIgnore (skip existing) or InsertOrUpdate (overwrite existing)
+//
+// RUNNING THE INGESTER:
+// ---------------------
+// The ingester runs as part of server startup. To use it:
+//
+// 1. Configure the DatabaseIngest options as shown above
+//
+// 2. Start the server - the ingester will run after database migrations
+//
+// 3. Integration point (add to your ServerMain or startup code):
+//
+//    DatabaseIngestOptions ingestOpts = RuntimeOptionsRegistry.Instance.GetCurrent<DatabaseIngestOptions>();
+//    if (ingestOpts.Mode == DatabaseIngestMode.ForceIngestOnExisting)
+//    {
+//        MetaDatabase db = MetaDatabase.Get(QueryPriority.Normal);
+//        DatabaseSnapshotIngester ingester = new DatabaseSnapshotIngester(ingestOpts, db);
+//        await ingester.IngestAllSnapshotsFromS3Async();
+//        _logger.Information("Database ingest complete");
+//    }
+//
+// 4. Monitor progress via server logs - the ingester logs progress for each Parquet file
+//
+// MULTI-SHARD SETUP:
+// ------------------
+// For sharded databases, provide one export name per shard. The exports are processed
+// in parallel. Example for 2 shards:
+//
+//   ExportNames:
+//     - prod-rds-shard0-export-20240115
+//     - prod-rds-shard1-export-20240115
+//
+// S3 BUCKET STRUCTURE:
+// --------------------
+// The expected S3 structure matches RDS export format:
+//
+//   s3://bucket-name/
+//     export-name/
+//       export_info_export-name.json    <- Export metadata (validated)
+//       database-name/
+//         database-name.TableName/
+//           part-00000-xxxxx.parquet    <- Table data files
+//           part-00001-xxxxx.parquet
+//           ...
+//
+// PERFORMANCE TIPS:
+// -----------------
+// - Increase WorkersPerShard for faster ingestion (4-8 is usually good)
+// - Use InsertOrIgnore mode when target tables are empty
+// - Run on an instance close to the S3 bucket region
+// - Ensure adequate database connection pool size
+//
+// LIMITATIONS:
+// ------------
+// - Each Parquet file is loaded entirely into memory before processing. RDS export
+//   typically creates files around 100-200MB, but ensure adequate memory is available
+//   when running with multiple workers (memory usage = WorkersPerShard * max file size).
+//
+// TROUBLESHOOTING:
+// ----------------
+// - "RDS export job info not found" - Check S3BasePaths and ExportNames are correct
+// - "Invalid RDS export job status" - The export may still be in progress
+// - Permission errors - Ensure IAM role has s3:GetObject and s3:ListBucket permissions
+// - Missing columns - Schema mismatch between export and current database model
+//
+// ===================================================================================
+
+using Amazon.S3.Model;
+using Metaplay.Cloud.Persistence;
+using Metaplay.Cloud.RuntimeOptions;
+using Metaplay.Cloud.Services;
+using Metaplay.Core;
+using Metaplay.Core.Json;
+using Newtonsoft.Json;
+using Parquet;
+using Parquet.Data;
+using Parquet.Schema;
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Threading;
+using System.Threading.Tasks;
+using static System.FormattableString;
+
+namespace Metaplay.Server.Database
+{
+    public enum DatabaseIngestMode
+    {
+        /// <summary>
+        /// Ingesting is disabled, never do it.
+        /// </summary>
+        Disable,
+
+        /// <summary>
+        /// Force ingest on top of existing database (only intended for development/disaster recovery).
+        /// </summary>
+        ForceIngestOnExisting,
+    }
+
+    public enum DatabaseBulkInsertMode
+    {
+        /// <summary>
+        /// Only write values that don't yet exist in the database.
+        /// </summary>
+        InsertOrIgnore,
+
+        /// <summary>
+        /// Write all values, override any existing values.
+        /// </summary>
+        InsertOrUpdate,
+    }
+
+    /// <summary>
+    /// Configuration for database ingest operation from RDS snapshot exported to S3 as Parquet files.
+    /// See the file header comments for detailed usage instructions.
+    /// </summary>
+    [RuntimeOptions("DatabaseIngest", isStatic: true, "Configuration for database ingest operation from RDS snapshot exported to S3 as Parquet files")]
+    public class DatabaseIngestOptions : RuntimeOptionsBase
+    {
+        /// <summary>
+        /// Ingestion mode. Set to ForceIngestOnExisting to enable ingestion.
+        /// </summary>
+        public DatabaseIngestMode       Mode                { get; private set; } = DatabaseIngestMode.Disable;
+
+        /// <summary>
+        /// AWS region where the S3 bucket is located (e.g., "eu-west-1", "us-east-1").
+        /// </summary>
+        public string                   S3Region            { get; private set; } = null;
+
+        /// <summary>
+        /// Name of the S3 bucket containing the Parquet export.
+        /// </summary>
+        public string                   S3Bucket            { get; private set; } = null;
+
+        /// <summary>
+        /// Optional base paths within the S3 bucket for each shard export.
+        /// Array length must match ExportNames. Defaults to empty strings if not specified.
+        /// Example: ["exports/shard0", "exports/shard1"]
+        /// </summary>
+        public string[]                 S3BasePaths         { get; private set; } = null;
+
+        /// <summary>
+        /// Array of RDS export task names, one per database shard.
+        /// These are the export identifiers created when exporting RDS snapshots to S3.
+        /// Required when Mode is not Disable.
+        /// Example: ["prod-snapshot-export-shard0", "prod-snapshot-export-shard1"]
+        /// </summary>
+        public string[]                 ExportNames         { get; private set; } = null;
+
+        /// <summary>
+        /// Name of the database within the RDS export to ingest from.
+        /// This is the database name as it appears in the Parquet export structure.
+        /// Required when Mode is not Disable.
+        /// Example: "myapp_production"
+        /// </summary>
+        public string                   DatabaseName        { get; private set; } = null;
+
+        /// <summary>
+        /// Optional filter to only ingest a specific table.
+        /// When null, all tables are ingested. Useful for testing or partial recovery.
+        /// Example: "Players"
+        /// </summary>
+        public string                   TableFilter         { get; private set; } = null;
+
+        /// <summary>
+        /// Optional suffix to strip from snapshot table names when mapping to target tables.
+        /// Useful when snapshot tables have a suffix (e.g., "Players_backup" -> "Players").
+        /// </summary>
+        public string                   SnapshotTableSuffix { get; private set; } = null;
+
+        /// <summary>
+        /// Number of parallel workers per shard for ingesting Parquet files.
+        /// Higher values increase throughput but use more memory and connections.
+        /// </summary>
+        public int                      WorkersPerShard     { get; private set; } = 4;
+
+        /// <summary>
+        /// How to handle rows that already exist in the target database.
+        /// InsertOrIgnore: Skip rows that already exist (faster, use for empty tables).
+        /// InsertOrUpdate: Overwrite existing rows with values from the snapshot.
+        /// </summary>
+        public DatabaseBulkInsertMode   BulkInsertMode      { get; private set; } = DatabaseBulkInsertMode.InsertOrIgnore;
+
+        public override Task OnLoadedAsync()
+        {
+            // Default to empty base paths, if not specified
+            if (S3BasePaths == null && ExportNames != null)
+                S3BasePaths = Enumerable.Range(0, ExportNames.Length).Select(_ => "").ToArray();
+
+            return base.OnLoadedAsync();
+        }
+    }
+
+    /// <summary>
+    /// Class for seeding the database contents from an RDS snapshot exported to S3 as Parquet files.
+    /// </summary>
+    public class DatabaseSnapshotIngester
+    {
+        Serilog.ILogger         _log        = Serilog.Log.ForContext<DatabaseSnapshotIngester>();
+        MetaDatabase            _db;
+        DatabaseIngestOptions   _opts;
+        S3BlobStorage           _blobStore;
+
+        public DatabaseSnapshotIngester(DatabaseIngestOptions opts, MetaDatabase db)
+        {
+            _opts = opts ?? throw new ArgumentNullException(nameof(opts));
+            _db = db ?? throw new ArgumentNullException(nameof(db));
+
+            if (string.IsNullOrEmpty(opts.S3Region))
+                throw new ArgumentException("DatabaseIngestOptions.S3Region must be specified");
+            if (string.IsNullOrEmpty(opts.S3Bucket))
+                throw new ArgumentException("DatabaseIngestOptions.S3Bucket must be specified");
+            if (opts.ExportNames == null || opts.ExportNames.Length == 0)
+                throw new ArgumentException("DatabaseIngestOptions.ExportNames must be specified");
+            if (string.IsNullOrEmpty(opts.DatabaseName))
+                throw new ArgumentException("DatabaseIngestOptions.DatabaseName must be specified");
+
+            _blobStore = new S3BlobStorage(accessKey: null, secretKey: null, opts.S3Region, opts.S3Bucket, "");
+        }
+
+        async Task MultiInsertTypedAsyncImpl<TItem>(object[] items) where TItem : IPersistedItem
+        {
+            if (_opts.BulkInsertMode == DatabaseBulkInsertMode.InsertOrIgnore)
+                await _db.MultiInsertOrIgnoreAsync(items.AsEnumerable().Cast<TItem>()).ConfigureAwait(false);
+            else
+                await _db.MultiInsertOrUpdateAsync(items.AsEnumerable().Cast<TItem>()).ConfigureAwait(false);
+        }
+
+        async Task MultiInsertTypedAsync(Type itemType, object[] items)
+        {
+            MethodInfo methodInfo = this.GetType().GetMethod(nameof(MultiInsertTypedAsyncImpl), BindingFlags.Instance | BindingFlags.NonPublic);
+            MethodInfo specialized = methodInfo.MakeGenericMethod(itemType);
+            await ((Task)specialized.Invoke(this, new object[] { items })).ConfigureAwait(false);
+        }
+
+        class IngestFileStats
+        {
+            public int      TotalRows;
+            public TimeSpan TotalElapsed;
+            public TimeSpan FetchElapsed;
+            public TimeSpan ParseTotalElapsed   = TimeSpan.Zero;
+            public TimeSpan InsertTotalElapsed  = TimeSpan.Zero;
+        }
+
+        /// <summary>
+        /// Ingest a single Parquet file and write the contents into the specified database table.
+        /// </summary>
+        async Task<IngestFileStats> IngestParquetFileAsync(int shardNdx, string tableName, string fileName)
+        {
+            Stopwatch           swIngest = Stopwatch.StartNew();
+            DatabaseItemSpec    itemSpec = DatabaseTypeRegistry.GetItemSpecByTableName(tableName);
+            Type                itemType = itemSpec.ItemType;
+            IngestFileStats     stats = new IngestFileStats();
+
+            // Fetch file from S3 & initialize Parquet parsing
+            Stopwatch swFetch = Stopwatch.StartNew();
+            byte[] parquetBytes = await _blobStore.GetAsync(fileName).ConfigureAwait(false);
+            _log.Information("#{ShardNdx}: Ingesting file {FileName} ({FileSize} bytes)", shardNdx, fileName, parquetBytes.Length);
+            using MemoryStream ms = new MemoryStream(parquetBytes);
+            using ParquetReader parquetReader = await ParquetReader.CreateAsync(ms).ConfigureAwait(false);
+            stats.FetchElapsed = swFetch.Elapsed;
+
+            // Member mapping from Parquet to C# types
+            DataField[]                 dataFields                  = parquetReader.Schema.GetDataFields();
+            int                         numMembers                  = itemSpec.MemberInfos.Length;
+            int[]                       memberParquetColumnIndexes  = new int[numMembers];
+            Action<object, object>[]    memberSetters               = new Action<object, object>[numMembers];
+
+            for (int memberNdx = 0; memberNdx < numMembers; memberNdx++)
+            {
+                MemberInfo memberInfo = itemSpec.MemberInfos[memberNdx];
+                string memberName = memberInfo.Name;
+                int colNdx = Array.FindIndex(dataFields, f => f.Name == memberName);
+                if (colNdx < 0)
+                    throw new InvalidOperationException($"Unable to find column for {itemSpec.TableName}.{memberName} in Parquet file");
+                memberParquetColumnIndexes[memberNdx] = colNdx;
+                memberSetters[memberNdx] = memberInfo.GetDataMemberSetValueOnDeclaringType();
+            }
+
+            // Enumerate through row groups in this file
+            for (int rowGroupNdx = 0; rowGroupNdx < parquetReader.RowGroupCount; rowGroupNdx++)
+            {
+                using (ParquetRowGroupReader groupReader = parquetReader.OpenRowGroupReader(rowGroupNdx))
+                {
+                    Stopwatch swParse = Stopwatch.StartNew();
+                    int rowCount = (int)groupReader.RowCount;
+                    stats.TotalRows += rowCount;
+
+                    // Read all columns
+                    DataColumn[] columns = await Task.WhenAll(dataFields.Select(df => groupReader.ReadColumnAsync(df))).ConfigureAwait(false);
+                    object[] items = new object[rowCount];
+
+                    // Create items for all the rows in the rowGroup and populate their members
+                    for (int itemNdx = 0; itemNdx < rowCount; itemNdx++)
+                    {
+                        object item = Activator.CreateInstance(itemType, nonPublic: true);
+                        for (int memberNdx = 0; memberNdx < numMembers; memberNdx++)
+                        {
+                            DataColumn column = columns[memberParquetColumnIndexes[memberNdx]];
+                            object value = column.Data.GetValue(itemNdx);
+
+                            // Data mappings for known mismatches between Parquet and SQL
+                            MemberInfo memberInfo = itemSpec.MemberInfos[memberNdx];
+                            Type memberType = memberInfo.GetDataMemberType();
+
+                            // Handle nullable types by getting the underlying type
+                            Type underlyingType = Nullable.GetUnderlyingType(memberType) ?? memberType;
+
+                            // Only perform type conversions for non-null values
+                            if (value != null)
+                            {
+                                if (underlyingType == typeof(DateTime))
+                                {
+                                    if (value.GetType() == typeof(long))
+                                        value = MetaTime.DateTimeEpoch + new TimeSpan((long)value * 10L); // convert from microseconds to 100ns ticks
+                                    else
+                                        throw new InvalidOperationException($"Invalid Parquet data type for DateTime, got {value.GetType().ToGenericTypeString()}, expecting 'long'");
+                                }
+                                else if (underlyingType == typeof(bool))
+                                {
+                                    if (value.GetType() == typeof(int))
+                                        value = (int)value != 0;
+                                    else
+                                        throw new InvalidOperationException($"Invalid Parquet data type for bool, got {value.GetType().ToGenericTypeString()}, expecting 'int'");
+                                }
+                            }
+
+                            try
+                            {
+                                memberSetters[memberNdx].Invoke(item, value);
+                            }
+                            catch (Exception ex)
+                            {
+                                _log.Information("#{ShardNdx}: Unable to set value for {Table}.{Member}: {Exception}", shardNdx, itemSpec.TableName, memberInfo.Name, ex);
+                                throw;
+                            }
+                        }
+                        items[itemNdx] = item;
+                    }
+                    stats.ParseTotalElapsed += swParse.Elapsed;
+
+                    // Multi-insert using a typed call
+                    Stopwatch swInsert = Stopwatch.StartNew();
+                    await MultiInsertTypedAsync(itemType, items).ConfigureAwait(false);
+                    stats.InsertTotalElapsed += swInsert.Elapsed;
+                }
+            }
+
+            stats.TotalElapsed = swIngest.Elapsed;
+            return stats;
+        }
+
+        class RdsSnapshotExportInfo
+        {
+            [JsonProperty("snapshotTime")]      public string SnapshotTime      { get; set; }
+            [JsonProperty("taskStartTime")]     public string TaskStartTime     { get; set; }
+            [JsonProperty("taskEndTime")]       public string TaskEndTime       { get; set; }
+            [JsonProperty("status")]            public string Status            { get; set; }
+            [JsonProperty("percentProgress")]   public double PercentProgress   { get; set; }
+        }
+
+        void ValidateExportInfo(byte[] bytes)
+        {
+            RdsSnapshotExportInfo exportInfo = JsonSerialization.Deserialize<RdsSnapshotExportInfo>(bytes);
+            if (exportInfo.Status != "COMPLETE")
+                throw new InvalidOperationException($"Invalid RDS export job status: {exportInfo.Status}, expecting 'COMPLETE'");
+            if (exportInfo.PercentProgress != 100.0)
+                throw new InvalidOperationException($"Invalid RDS export job percentProgress: {exportInfo.PercentProgress}, expecting 100");
+        }
+
+        async Task<MetaDictionary<string, List<string>>> ResolveShardParquetFilesAsync(string s3BasePath, string exportName)
+        {
+            // Fetch and validate export_info_xyz.json
+            string exportInfoPath = FileUtil.NormalizePath(Path.Join(s3BasePath, exportName, $"export_info_{exportName}.json"));
+            byte[] exportInfoBytes = await _blobStore.GetAsync(exportInfoPath).ConfigureAwait(false);
+            if (exportInfoBytes == null)
+                throw new InvalidOperationException($"RDS export job info not found in S3 bucket {_opts.S3Bucket} path {exportInfoPath}");
+            ValidateExportInfo(exportInfoBytes);
+
+            // Resolve all database tables
+            MetaDictionary<string, List<string>> tableParquetFiles = new MetaDictionary<string, List<string>>();
+            foreach (DatabaseItemSpec itemSpec in DatabaseTypeRegistry.ItemSpecs)
+            {
+                // Skip non-targeted tables (if targeting enabled)
+                if (_opts.TableFilter != null && itemSpec.TableName != _opts.TableFilter)
+                    continue;
+
+                // Ignore meta-data tables (should not be copied)
+                if (itemSpec.TableName == "__EFMigrationsHistory" || itemSpec.TableName == "MetaInfo")
+                    continue;
+
+                tableParquetFiles.Add(itemSpec.TableName, new List<string>());
+            }
+
+            // Find all files related to the database/environment to be ingested
+            string dbPrefixPath = FileUtil.NormalizePath(Path.Join(s3BasePath, exportName, _opts.DatabaseName));
+            List<S3Object> objects = await _blobStore.ListObjectsAsync(dbPrefixPath).ConfigureAwait(false);
+            HashSet<string> loggedTableRemappings = new HashSet<string>();
+            foreach (S3Object obj in objects)
+            {
+                // Ignore the _SUCCESS files (status is parsed from the .json)
+                if (obj.Key.EndsWith("/_SUCCESS", StringComparison.Ordinal))
+                    continue;
+
+                // Handle .parquet files
+                if (obj.Key.EndsWith(".parquet", StringComparison.Ordinal))
+                {
+                    string relativeFileName = obj.Key;
+                    string tableName = relativeFileName.Replace($"{dbPrefixPath}/{_opts.DatabaseName}.", "").Split("/")[0];
+
+                    // If table name in snapshot ends with the specified suffix, remove it
+                    if (!string.IsNullOrEmpty(_opts.SnapshotTableSuffix))
+                    {
+                        // If table suffix specified, the snapshot table name must have it (ignore exactly matching tables)
+                        if (!tableName.EndsWith(_opts.SnapshotTableSuffix, StringComparison.Ordinal))
+                            continue;
+
+                        string snapshotTableName = tableName;
+                        tableName = tableName.Substring(0, tableName.Length - _opts.SnapshotTableSuffix.Length);
+
+                        // Only log remapping once per table
+                        if (loggedTableRemappings.Add(snapshotTableName))
+                            _log.Information("Remapping snapshot table {SnapshotTableName} to {RemappedTableName}", snapshotTableName, tableName);
+                    }
+
+                    if (tableParquetFiles.ContainsKey(tableName))
+                        tableParquetFiles[tableName].Add(relativeFileName);
+                }
+            }
+
+            return tableParquetFiles;
+        }
+
+        /// <summary>
+        /// Ingest the snapshot from a single RDS cluster. Multiple worker Tasks are used to speed up the process.
+        /// </summary>
+        async Task IngestShardSnapshotAsync(int shardNdx, MetaDictionary<string, List<string>> tableParquetFiles)
+        {
+            Stopwatch sw = Stopwatch.StartNew();
+
+            int numTotalFiles = tableParquetFiles.Values.SelectMany(v => v).Count();
+            int totalFilesProcessed = 0;
+            _log.Information("#{ShardNdx}: Ingesting snapshot with {FileCount} file(s)..", shardNdx, numTotalFiles);
+            foreach ((string tableName, List<string> parquetFiles) in tableParquetFiles)
+            {
+                // Push all work into a queue
+                int numTableFiles = parquetFiles.Count;
+                ConcurrentQueue<string> workQueue = new ConcurrentQueue<string>(parquetFiles);
+
+                // Use parallel workers to ingest the individual Parquet files.
+                int tableFilesProcessed = 0;
+                await Task.WhenAll(
+                    Enumerable.Range(0, _opts.WorkersPerShard).Select(async workerNdx =>
+                    {
+                        while (workQueue.TryDequeue(out string parquetFile))
+                        {
+                            IngestFileStats stats = await IngestParquetFileAsync(shardNdx, tableName, parquetFile).ConfigureAwait(false);
+                            int numTableFilesProcessed = Interlocked.Increment(ref tableFilesProcessed);
+                            int numTotalFilesProcessed = Interlocked.Increment(ref totalFilesProcessed);
+
+                            TimeSpan totalElapsed = sw.Elapsed;
+                            TimeSpan predictedTotal = numTotalFiles / (double)numTotalFilesProcessed * totalElapsed;
+                            TimeSpan predictedRemaining = predictedTotal - totalElapsed;
+
+                            _log.Information("#{ShardNdx} w{WorkerNdx}: Table {TableName} {TableFilesProcessed}/{NumTableFiles} files ({TotalFilesProcessed}/{NumTotalFiles} total, {PercentageComplete:0.0}% complete, {Elapsed} elapsed, {TotalPredicted} est. total, {PredictedRemaining} est. remaining) -- {TotalRows} rows in {TotalElapsed:0.0}s ({FetchElapsed:0.0}s fetch, {ParseElapsed:0.0}s parse, {InsertElapsed:0.0}s insert)",
+                                shardNdx, workerNdx, tableName, numTableFilesProcessed, numTableFiles, numTotalFilesProcessed, numTotalFiles, numTotalFilesProcessed * 100.0 / numTotalFiles, sw.Elapsed, predictedTotal, predictedRemaining,
+                                stats.TotalRows, stats.TotalElapsed.TotalSeconds, stats.FetchElapsed.TotalSeconds, stats.ParseTotalElapsed.TotalSeconds, stats.InsertTotalElapsed.TotalSeconds);
+                        }
+                    })
+                );
+            }
+        }
+
+        /// <summary>
+        /// Ingest all the S3/Parquet snapshots configured in the <see cref="DatabaseIngestOptions"/> into the active database.
+        /// </summary>
+        public async Task IngestAllSnapshotsFromS3Async()
+        {
+            // Fetch metadata sequentially (to get in-order logs)
+            int numShards = _opts.ExportNames.Length;
+            _log.Information("Ingesting database from exports: {ExportNames}", string.Join(", ", _opts.ExportNames));
+
+            // Ingest all the input per-snapshot exports in parallel
+            await Task.WhenAll(
+                Enumerable.Range(0, numShards).Select(async shardNdx =>
+                {
+                    // Fetch all the relevant files for the shard/export
+                    string s3BasePath = _opts.S3BasePaths[shardNdx];
+                    string exportName = _opts.ExportNames[shardNdx];
+                    MetaDictionary<string, List<string>> exportTableParquetFiles = await ResolveShardParquetFilesAsync(s3BasePath, exportName);
+                    _log.Information("#{ShardNdx}: Files to ingest from snapshot by table\n{Files}", shardNdx, string.Join("\n", exportTableParquetFiles.Select(kvp => Invariant($"  {kvp.Key}: {kvp.Value.Count} file(s)"))));
+
+                    // Ingest the shard
+                    await IngestShardSnapshotAsync(shardNdx, exportTableParquetFiles).ConfigureAwait(false);
+                })
+            );
+        }
+    }
+}
