@@ -0,0 +1,167 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core.Client;
+using Metaplay.Core.Config;
+using Metaplay.Core.Localization;
+using Metaplay.Core.Message;
+using Metaplay.Core.Player;
+using System;
+using System.Threading.Tasks;
+
+namespace Metaplay.Core.Session
+{
+    /// <summary>
+    /// The established game session and its resources and services.
+    /// </summary>
+    public class MetaplaySession
+    {
+        /// <summary>
+        /// The identifier for the Session. A new session token will be generated for each
+        /// Connect().
+        /// </summary>
+        public readonly SessionToken SessionToken;
+
+        /// <summary>
+        /// The ID of the current player.
+        /// </summary>
+        public readonly EntityId PlayerId;
+
+        /// <summary>
+        /// Client storage of the session.
+        /// </summary>
+        public readonly MetaplayClientStore ClientStore;
+
+        /// <summary>
+        /// The context of the Player client. The context maintains the Player Model's state and the execution model
+        /// for the game client. Context manages updating Model state based on server and client input.
+        /// </summary>
+        public readonly IPlayerClientContext PlayerContext;
+
+        /// <summary>
+        /// The GameConfig of the current player.
+        /// <para>
+        /// If you have other, non-player entities, they may have use a different GameConfig.
+        /// </para>
+        /// </summary>
+        public readonly ISharedGameConfig GameConfig;
+
+        /// <summary>
+        /// Message dispatcher of the session.
+        /// <para>
+        /// Message dispatcher allows sending messages to the server, and receiving messages from the server.
+        /// Receiving messages is performed by attaching a listener on the specific message type.
+        /// </para>
+        /// <para>
+        /// This MessageDispatcher has effect only for the duration of the current session. When this session ends,
+        /// no messages are sent and no messages are received.
+        /// </para>
+        /// </summary>
+        public readonly SessionMessageDispatcher SessionMessageDispatcher;
+
+        /// <summary>
+        /// Was maintenance mode scheduled at the start of the session.
+        /// </summary>
+        public readonly MaintenanceModeState ScheduledMaintenanceMode;
+
+        /// <summary>
+        /// True, if the server is on maintenance but session was allowed to start anyway
+        /// since the current player was marked as a Developer Player.
+        /// </summary>
+        public readonly bool DeveloperMaintenanceBypass;
+
+        /// <summary>
+        /// Custom session start data supplied by the server.
+        /// </summary>
+        public readonly ISessionStartSuccessGamePayload SessionStartGamePayload;
+
+        /// <summary>
+        /// The language the session started with.
+        /// </summary>
+        public readonly LocalizationLanguage Language;
+
+        readonly Task<ConnectionLostEvent> _sessionEndTask;
+        readonly TaskCompletionSource<int> _sessionSetupTcs;
+        readonly ConnectionStatistics _initConnStats;
+
+#if UNITY_EDITOR
+        internal bool _editorOnlyHasConnectAsyncCompleted;
+#endif
+
+        internal MetaplaySession(
+            SessionToken sessionToken,
+            EntityId playerId,
+            MetaplayClientStore clientStore,
+            SessionMessageDispatcher sessionMessageDispatcher,
+            MaintenanceModeState scheduledMaintenanceMode,
+            bool developerMaintenanceBypass,
+            ISessionStartSuccessGamePayload sessionStartGamePayload,
+            LocalizationLanguage language,
+            Task<ConnectionLostEvent> sessionEndTask,
+            TaskCompletionSource<int> sessionSetupTcs,
+            ConnectionStatistics initConnStats)
+        {
+            SessionToken = sessionToken;
+            PlayerId = playerId;
+            ClientStore = clientStore;
+            PlayerContext = clientStore.GetPlayerClientContext();
+            GameConfig = ((IPlayerModelBase)PlayerContext.Model).GameConfig;
+            SessionMessageDispatcher = sessionMessageDispatcher;
+            ScheduledMaintenanceMode = scheduledMaintenanceMode;
+            DeveloperMaintenanceBypass = developerMaintenanceBypass;
+            SessionStartGamePayload = sessionStartGamePayload;
+            Language = language;
+            _sessionEndTask = sessionEndTask;
+            _sessionSetupTcs = sessionSetupTcs;
+            _initConnStats = initConnStats;
+        }
+
+        /// <summary>
+        /// Completes when the session has terminated. Most commonly this is due to network error, app being put
+        /// in the background for a long time, or game manually ending the session.
+        /// <para>
+        /// You should inspect the <see cref="ConnectionLostEvent.AutoReconnectRecommended"/> of the result and
+        /// reconnect without user interaction if it is <c>true</c>. If the field is <c>false</c>, you should
+        /// show the error message to user and wait for their optional interaction before reconnecting.
+        /// </para>
+        /// </summary>
+        /// <remarks>
+        /// If the SDK is deinitialized, the task completes as Canceled.
+        /// </remarks>
+        public Task<ConnectionLostEvent> WaitForSessionEndAsync() => _sessionEndTask;
+
+        /// <summary>
+        /// Call this method after your client-side setup is complete. Only needed when using ConnectAsync().
+        /// <para>
+        /// Marks the session as started. This enables message processing and makes PlayerModel advance on their timeline.
+        /// </para>
+        /// </summary>
+        public void SessionStartComplete()
+        {
+#if UNITY_EDITOR
+            if (!_editorOnlyHasConnectAsyncCompleted)
+                throw new InvalidOperationException("SessionStartComplete() may only be called after ConnectAsync() completes. Calling this from IMetaplayLifecycleDelegate.OnSessionStartedAsync() is not needed and not allowed");
+#endif
+            if (!_sessionSetupTcs.TrySetResult(0))
+                throw new InvalidOperationException("SessionStartComplete() or SessionStartFailed() already called for this session");
+        }
+
+        /// <summary>
+        /// Call this method if client-side setup is fails. Only needed when using ConnectAsync().
+        /// <para>
+        /// Marks the session as failed and informs the server the session failed to start. This will
+        /// automatically send an incident report to server.
+        /// </para>
+        /// </summary>
+        public ConnectionLostEvent SessionStartFailed(Exception ex)
+        {
+#if UNITY_EDITOR
+            if (!_editorOnlyHasConnectAsyncCompleted)
+                throw new InvalidOperationException("SessionStartFailed() may only be called after ConnectAsync() completes. Calling this from IMetaplayLifecycleDelegate.OnSessionStartedAsync() is not needed and not allowed");
+#endif
+            if (!_sessionSetupTcs.TrySetException(ex))
+                throw new InvalidOperationException("SessionStartComplete() or SessionStartFailed() already called for this session");
+
+            return ConnectionLostEvent.FromConnectionError(new ConnectionStates.TerminalError.ClientSideConnectionError(ex, "OnSessionStartedAsync"), _initConnStats);
+        }
+    }
+}
