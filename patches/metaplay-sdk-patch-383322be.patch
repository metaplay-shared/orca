+function getDescendantPaths(configItems: LibraryConfigItem[], targetPath: string): string[] {
+  // Resulting paths.
+  const paths: string[] = []
+
+  /**
+   * Helper function to traverse the config items recursively.
+   * @param items Root items to traverse.
+   * @param currentPath Current path prefix.
+   */
+  function traverse(items: LibraryConfigItem[], currentPath: string): void {
+    // Only interested in traversing items with children.
+    for (const item of items.filter((item) => item.children)) {
+      const itemPath = currentPath + item.title
+      if (itemPath === targetPath || itemPath.startsWith(`${targetPath}:`)) {
+        paths.push(itemPath)
+        // eslint-disable-next-line @typescript-eslint/no-non-null-assertion -- We filtered to only items with children above.
+        traverse(item.children!, `${itemPath}:`)
+      }
+    }
+  }
+
+  // Get item and path to start from.
