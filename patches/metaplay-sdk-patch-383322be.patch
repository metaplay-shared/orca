diff --git a/MetaplaySDK/Client/Unity/MetaplayPlayerLoop.cs b/MetaplaySDK/Client/Unity/MetaplayPlayerLoop.cs
new file mode 100644
index 00000000..36032082
--- /dev/null
+++ b/MetaplaySDK/Client/Unity/MetaplayPlayerLoop.cs
@@ -0,0 +1,90 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using System;
+using UnityEngine.LowLevel;
+
+namespace Metaplay.Unity.Internal
+{
+    static class MetaplayPlayerLoop
+    {
+        static Action _updateMethod;
+
+        internal static void SetUpdateFunction(Action updateAction)
+        {
+            EnsureLoopAttachedOrDetached(updateAction != null);
+            _updateMethod = updateAction;
+        }
+
+        static void EnsureLoopAttachedOrDetached(bool attached)
+        {
+            // Insert into EarlyUpdate
+            PlayerLoopSystem loop = PlayerLoop.GetCurrentPlayerLoop();
+
+            if (loop.subSystemList == null)
+                throw new InvalidOperationException("Playerloop is missing EarlyUpdate system");
+            int earlyIndex = Array.FindIndex(loop.subSystemList, subsystem => subsystem.type == typeof(UnityEngine.PlayerLoop.EarlyUpdate));
+            if (earlyIndex == -1)
+                throw new InvalidOperationException("Playerloop is missing EarlyUpdate system");
+
+            PlayerLoopSystem earlyUpdateSubsystem = loop.subSystemList[earlyIndex];
+
+            // should never be taken but ensures non-nullability
+            if (earlyUpdateSubsystem.subSystemList == null)
+                earlyUpdateSubsystem.subSystemList = Array.Empty<PlayerLoopSystem>();
+
+            // Add or remove from the list
+            PlayerLoopSystem[] newEarlyUpdateSubsystemList;
+            if (attached)
+            {
+                // Already added?
+                if (Array.FindIndex(earlyUpdateSubsystem.subSystemList, subsystem => subsystem.type == typeof(MetaplayPlayerLoop)) != -1)
+                    return;
+
+                // Add last
+                newEarlyUpdateSubsystemList = new PlayerLoopSystem[earlyUpdateSubsystem.subSystemList.Length + 1];
+                Array.Copy(
+                    sourceArray: earlyUpdateSubsystem.subSystemList,
+                    sourceIndex: 0,
+                    destinationArray: newEarlyUpdateSubsystemList,
+                    destinationIndex: 0,
+                    length: earlyUpdateSubsystem.subSystemList.Length);
+
+                newEarlyUpdateSubsystemList[earlyUpdateSubsystem.subSystemList.Length] = new PlayerLoopSystem()
+                {
+                    subSystemList = null,
+                    type = typeof(MetaplayPlayerLoop),
+                    updateDelegate = Update
+                };
+            }
+            else
+            {
+                // Already removed?
+                int index = Array.FindIndex(earlyUpdateSubsystem.subSystemList, subsystem => subsystem.type == typeof(MetaplayPlayerLoop));
+                if (index == -1)
+                    return;
+
+                newEarlyUpdateSubsystemList = new PlayerLoopSystem[earlyUpdateSubsystem.subSystemList.Length - 1];
+                Array.Copy(sourceArray: earlyUpdateSubsystem.subSystemList, sourceIndex: 0,         destinationArray: newEarlyUpdateSubsystemList, destinationIndex: 0,     length: index);
+                Array.Copy(sourceArray: earlyUpdateSubsystem.subSystemList, sourceIndex: index + 1, destinationArray: newEarlyUpdateSubsystemList, destinationIndex: index, length: earlyUpdateSubsystem.subSystemList.Length - (index + 1));
+            }
+
+            // Apply the new loop
+            PlayerLoopSystem[] newTopLevelList = loop.subSystemList[..];
+            newTopLevelList[earlyIndex].subSystemList = newEarlyUpdateSubsystemList;
+
+            PlayerLoopSystem newLoop = new PlayerLoopSystem()
+            {
+                type = loop.type,
+                subSystemList = newTopLevelList,
+                updateDelegate = loop.updateDelegate,
+                updateFunction = loop.updateFunction,
+            };
+            PlayerLoop.SetPlayerLoop(newLoop);
+        }
+
+        static void Update()
+        {
+            _updateMethod?.Invoke();
+        }
+    }
+}
