+import { afterEach, describe, expect, test, vi } from 'vitest'
+
+import type { FilterState, SortOption, SortOptionState } from '../../src/unstable/mlistcard/MListCardTypes'
+import type { UtilitiesSummaryOptions } from '../../src/unstable/mlistcard/MListCardUtils'
+import {
+  buildUtilitiesSummaryText,
+  makeOptionsFilter,
+  makeRangeFilter,
+  makeSearchFilter,
+} from '../../src/unstable/mlistcard/MListCardUtils'
+
+// -- Test helpers --
+
+interface TestItem {
+  name: string
+  status: 'active' | 'inactive'
+  price: number
+}
+
+const searchFilter = makeSearchFilter<TestItem>((item) => [item.name])
+
+const optionsFilter = makeOptionsFilter<TestItem, TestItem['status']>('Status', (item) => item.status, [
+  { label: 'Active', value: 'active' },
+  { label: 'Inactive', value: 'inactive' },
+])
+
+const rangeFilter = makeRangeFilter<TestItem>('Price Range', (item) => item.price)
+
+const priceSortOption: SortOption<TestItem> = {
+  displayName: 'Price',
+  ascLabel: 'Low to High',
+  descLabel: 'High to Low',
+  getSortKey: (item) => item.price,
+  reverseSortOrder: false,
+}
+
+const nameSortOption: SortOption<TestItem> = {
+  displayName: 'Name',
+  ascLabel: 'A-Z',
+  descLabel: 'Z-A',
+  getSortKey: (item) => item.name,
+  reverseSortOrder: false,
+}
+
+function makeSortState(option: SortOption<TestItem>, reverse: boolean): SortOptionState<TestItem> {
+  return {
+    displayName: option.displayName,
+    getSortKey: option.getSortKey,
+    reverseSortOrder: reverse,
+  }
+}
+
+function pair(filter: typeof searchFilter, state: FilterState): { filter: typeof searchFilter; state: FilterState }
+function pair(filter: typeof optionsFilter, state: FilterState): { filter: typeof optionsFilter; state: FilterState }
+function pair(filter: typeof rangeFilter, state: FilterState): { filter: typeof rangeFilter; state: FilterState }
+function pair(
+  filter: typeof searchFilter | typeof optionsFilter | typeof rangeFilter,
+  state: FilterState
+): {
+  filter: typeof searchFilter | typeof optionsFilter | typeof rangeFilter
+  state: FilterState
+} {
+  return { filter, state }
+}
+
+/** Shorthand to build options with defaults. */
+function opts(overrides: Partial<UtilitiesSummaryOptions<TestItem>> = {}): UtilitiesSummaryOptions<TestItem> {
+  return {
+    filterStatePairs: [],
+    displayMode: 'filter',
+    filterCondition: 'and',
+    sortState: undefined,
+    sortOptions: [],
+    ...overrides,
+  }
+}
+
+afterEach(() => {
+  vi.restoreAllMocks()
+})
+
+// -- Tests --
+
+describe('buildUtilitiesSummaryText', () => {
+  // ---- No utilities active ----
+
+  test('returns empty string when no filters, no sort', () => {
+    expect(buildUtilitiesSummaryText(opts())).toBe('')
+  })
+
+  test('returns empty string when filters exist but none active', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'search', searchTerm: '' }),
+            pair(optionsFilter, { type: 'options', activeOptions: [] }),
+          ],
+        })
+      )
+    ).toBe('')
+  })
+
+  // ---- Sort only ----
+
+  test('sort only, ascending', () => {
+    const sort = makeSortState(priceSortOption, false)
+    expect(buildUtilitiesSummaryText(opts({ sortState: sort, sortOptions: [priceSortOption] }))).toBe(
+      'Sorted by Price (Low to High).'
+    )
+  })
+
+  test('sort only, descending', () => {
+    const sort = makeSortState(priceSortOption, true)
+    expect(buildUtilitiesSummaryText(opts({ sortState: sort, sortOptions: [priceSortOption] }))).toBe(
+      'Sorted by Price (High to Low).'
+    )
+  })
+
+  test('sort with no matching sort option logs error and omits sort summary', () => {
+    const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+    const sort = makeSortState(priceSortOption, false)
+
+    expect(buildUtilitiesSummaryText(opts({ sortState: sort, sortOptions: [nameSortOption] }))).toBe('')
+    expect(errorSpy).toHaveBeenCalledWith(
+      '[MListCard] No sort option found for active sort "Price" in utilities summary.'
+    )
+  })
+
+  // ---- Single filter, filter mode ----
+
+  test('search filter active, filter mode', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(searchFilter, { type: 'search', searchTerm: 'dragon' })],
+        })
+      )
+    ).toBe('Only showing items that match search "dragon".')
+  })
+
+  test('options filter active, filter mode', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(optionsFilter, { type: 'options', activeOptions: ['Active'] })],
+        })
+      )
+    ).toBe('Only showing items that match selected Status.')
+  })
+
+  test('range filter active with min only, filter mode', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(rangeFilter, { type: 'range-number', min: 10, max: undefined })],
+        })
+      )
+    ).toBe('Only showing items that match Price Range.')
+  })
+
+  test('range filter active with max only', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(rangeFilter, { type: 'range-number', min: undefined, max: 50 })],
+        })
+      )
+    ).toBe('Only showing items that match Price Range.')
+  })
+
+  test('range filter active with both min and max', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(rangeFilter, { type: 'range-number', min: 10, max: 50 })],
+        })
+      )
+    ).toBe('Only showing items that match Price Range.')
+  })
+
+  // ---- Single filter, highlight mode ----
+
+  test('search filter active, highlight mode', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(searchFilter, { type: 'search', searchTerm: 'dragon' })],
+          displayMode: 'highlight',
+        })
+      )
+    ).toBe('Highlighting items that match search "dragon".')
+  })
+
+  test('options filter active, highlight mode', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(optionsFilter, { type: 'options', activeOptions: ['Active', 'Inactive'] })],
+          displayMode: 'highlight',
+        })
+      )
+    ).toBe('Highlighting items that match selected Status.')
+  })
+
+  // ---- Multiple filters combined ----
+
+  test('search + options filters, filter mode', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'search', searchTerm: 'sword' }),
+            pair(optionsFilter, { type: 'options', activeOptions: ['Active'] }),
+          ],
+        })
+      )
+    ).toBe('Only showing items that match all filters: search "sword", selected Status.')
+  })
+
+  test('search + range filters, highlight mode', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'search', searchTerm: 'potion' }),
+            pair(rangeFilter, { type: 'range-number', min: 5, max: 100 }),
+          ],
+          displayMode: 'highlight',
+        })
+      )
+    ).toBe('Highlighting items that match all filters: search "potion", Price Range.')
+  })
+
+  test('all three filter types active', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'search', searchTerm: 'gem' }),
+            pair(optionsFilter, { type: 'options', activeOptions: ['Active'] }),
+            pair(rangeFilter, { type: 'range-number', min: 0, max: 50 }),
+          ],
+        })
+      )
+    ).toBe('Only showing items that match all filters: search "gem", selected Status, Price Range.')
+  })
+
+  test('only some of multiple filters active', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'search', searchTerm: '' }),
+            pair(optionsFilter, { type: 'options', activeOptions: ['Active'] }),
+            pair(rangeFilter, { type: 'range-number', min: undefined, max: undefined }),
+          ],
+        })
+      )
+    ).toBe('Only showing items that match selected Status.')
+  })
+
+  // ---- Filters + sort combined ----
+
+  test('search filter + sort ascending', () => {
+    const sort = makeSortState(priceSortOption, false)
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(searchFilter, { type: 'search', searchTerm: 'dragon' })],
+          sortState: sort,
+          sortOptions: [priceSortOption],
+        })
+      )
+    ).toBe('Only showing items that match search "dragon". Sorted by Price (Low to High).')
+  })
+
+  test('options filter + sort descending, highlight mode', () => {
+    const sort = makeSortState(priceSortOption, true)
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(optionsFilter, { type: 'options', activeOptions: ['Inactive'] })],
+          displayMode: 'highlight',
+          sortState: sort,
+          sortOptions: [priceSortOption],
+        })
+      )
+    ).toBe('Highlighting items that match selected Status. Sorted by Price (High to Low).')
+  })
+
+  test('all filters + sort', () => {
+    const sort = makeSortState(nameSortOption, false)
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'search', searchTerm: 'rare' }),
+            pair(optionsFilter, { type: 'options', activeOptions: ['Active'] }),
+            pair(rangeFilter, { type: 'range-number', min: 10, max: 99 }),
+          ],
+          sortState: sort,
+          sortOptions: [nameSortOption],
+        })
+      )
+    ).toBe(
+      'Only showing items that match all filters: search "rare", selected Status, Price Range. Sorted by Name (A-Z).'
+    )
+  })
+
+  test('search + options filters, OR mode', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'search', searchTerm: 'sword' }),
+            pair(optionsFilter, { type: 'options', activeOptions: ['Active'] }),
+          ],
+          filterCondition: 'or',
+        })
+      )
+    ).toBe('Only showing items that match any filter: search "sword", selected Status.')
+  })
+
+  test('search + range filters, highlight mode, OR mode, with sort', () => {
+    const sort = makeSortState(priceSortOption, true)
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'search', searchTerm: 'potion' }),
+            pair(rangeFilter, { type: 'range-number', min: 5, max: 100 }),
+          ],
+          displayMode: 'highlight',
+          filterCondition: 'or',
+          sortState: sort,
+          sortOptions: [priceSortOption],
+        })
+      )
+    ).toBe('Highlighting items that match any filter: search "potion", Price Range. Sorted by Price (High to Low).')
+  })
+
+  // ---- Edge cases ----
+
+  test('range filter with min=0 is treated as active', () => {
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(rangeFilter, { type: 'range-number', min: 0, max: undefined })],
+        })
+      )
+    ).toBe('Only showing items that match Price Range.')
+  })
+
+  test('mismatched filter/state logs error and skips invalid fragment', () => {
+    const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [
+            pair(searchFilter, { type: 'options', activeOptions: ['Active'] }),
+            pair(rangeFilter, { type: 'range-number', min: 1, max: 2 }),
+          ],
+        })
+      )
+    ).toBe('Only showing items that match Price Range.')
+
+    expect(errorSpy).toHaveBeenCalledWith(
+      '[MListCard] Mismatched filter/state types for "Search". Expected "search", got "options".'
+    )
+  })
+
+  test('invalid fragments are skipped while valid sort still renders', () => {
+    const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+    const sort = makeSortState(priceSortOption, false)
+
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(searchFilter, { type: 'options', activeOptions: ['Active'] })],
+          sortState: sort,
+          sortOptions: [priceSortOption],
+        })
+      )
+    ).toBe('Sorted by Price (Low to High).')
+
+    expect(errorSpy).toHaveBeenCalledWith(
+      '[MListCard] Mismatched filter/state types for "Search". Expected "search", got "options".'
+    )
+  })
+
+  test('returns empty string when all fragments are invalid', () => {
+    const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+    const sort = makeSortState(priceSortOption, false)
+
+    expect(
+      buildUtilitiesSummaryText(
+        opts({
+          filterStatePairs: [pair(searchFilter, { type: 'options', activeOptions: ['Active'] })],
+          sortState: sort,
+          sortOptions: [nameSortOption],
+        })
+      )
+    ).toBe('')
+
+    expect(errorSpy).toHaveBeenCalledTimes(2)
+  })
+})
