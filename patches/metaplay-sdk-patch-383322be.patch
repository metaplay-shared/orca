diff --git a/MetaplaySDK/Frontend/EslintConfig/tests/rules/prefer-datetime-utc.test.js b/MetaplaySDK/Frontend/EslintConfig/tests/rules/prefer-datetime-utc.test.js
new file mode 100644
index 00000000..ec5266c0
--- /dev/null
+++ b/MetaplaySDK/Frontend/EslintConfig/tests/rules/prefer-datetime-utc.test.js
@@ -0,0 +1,95 @@
+import { RuleTester } from 'eslint'
+import { describe, it } from 'vitest'
+import rule from '../../plugin/rules/prefer-datetime-utc.js'
+
+const ruleTester = new RuleTester({
+  languageOptions: {
+    ecmaVersion: 2022,
+    sourceType: 'module',
+  },
+})
+
+describe('prefer-datetime-utc', () => {
+  it('should enforce DateTime.utc() over DateTime.now()', () => {
+    ruleTester.run('prefer-datetime-utc', rule, {
+      valid: [
+        // Using DateTime.utc() is allowed
+        'DateTime.utc()',
+        'DateTime.utc(2024, 1, 15)',
+        'const now = DateTime.utc()',
+
+        // Other DateTime methods are allowed
+        'DateTime.fromISO("2024-01-15")',
+        'DateTime.fromMillis(1234567890)',
+        'DateTime.local()',
+
+        // Different objects with .now() are allowed
+        'Date.now()',
+        'Performance.now()',
+        'someObject.now()',
+
+        // Property access without call is allowed
+        'DateTime.now',
+        'const fn = DateTime.now',
+      ],
+
+      invalid: [
+        // Basic DateTime.now() call
+        {
+          code: 'DateTime.now()',
+          errors: [{ messageId: 'useUtcInsteadOfNow' }],
+          output: 'DateTime.utc()',
+        },
+
+        // With variable assignment
+        {
+          code: 'const now = DateTime.now()',
+          errors: [{ messageId: 'useUtcInsteadOfNow' }],
+          output: 'const now = DateTime.utc()',
+        },
+
+        // In an expression
+        {
+          code: 'const diff = DateTime.now().diff(other)',
+          errors: [{ messageId: 'useUtcInsteadOfNow' }],
+          output: 'const diff = DateTime.utc().diff(other)',
+        },
+
+        // As function argument
+        {
+          code: 'doSomething(DateTime.now())',
+          errors: [{ messageId: 'useUtcInsteadOfNow' }],
+          output: 'doSomething(DateTime.utc())',
+        },
+
+        // In template literal
+        {
+          code: '`Time: ${DateTime.now()}`',
+          errors: [{ messageId: 'useUtcInsteadOfNow' }],
+          output: '`Time: ${DateTime.utc()}`',
+        },
+
+        // In conditional
+        {
+          code: 'if (DateTime.now() > other) {}',
+          errors: [{ messageId: 'useUtcInsteadOfNow' }],
+          output: 'if (DateTime.utc() > other) {}',
+        },
+
+        // Multiple occurrences in same statement
+        {
+          code: 'const a = DateTime.now(), b = DateTime.now()',
+          errors: [{ messageId: 'useUtcInsteadOfNow' }, { messageId: 'useUtcInsteadOfNow' }],
+          output: 'const a = DateTime.utc(), b = DateTime.utc()',
+        },
+
+        // With arguments (edge case - DateTime.now() typically takes no args, but rule preserves them)
+        {
+          code: 'DateTime.now({ zone: "utc" })',
+          errors: [{ messageId: 'useUtcInsteadOfNow' }],
+          output: 'DateTime.utc({ zone: "utc" })',
+        },
+      ],
+    })
+  })
+})
