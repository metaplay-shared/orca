@@ -0,0 +1,279 @@
+<!-- This file is part of Metaplay SDK which is released under the Metaplay SDK License. -->
+
+<template lang="pug">
+MListCard(
+  title="Referenced By"
+  :item-list="decoratedReferenceList"
+  :item-key="getItemKey"
+  :filters="getCustomFilters()"
+  :sort-options="sortOptions"
+  :data-testid="dataTestid"
+  )
+  template(#icon)
+    FontAwesomeIcon(
+      icon="exchange-alt"
+      size="xs"
+      )
+  template(#item="{ item }")
+    MListItem
+      MBadge
+        template(#icon)
+          FontAwesomeIcon(
+            :icon="item.icon"
+            size="sm"
+            )
+        | {{ item.displayType }}
+      span(class="tw-ml-1") {{ item.displayName }}
+      template(#top-right)
+        MTextButton(
+          v-if="item.linkUrl"
+          :to="item.linkUrl"
+          ) View {{ `${item.linkText.toLocaleLowerCase()}` }}
+
+      template(
+        v-if="item.type === 'Activable'"
+        #bottom-right
+        )
+        //- meta-activable-phase-badge(:activable="slot.item.id") <- TODO figure this out
+</template>
+
+<script setup lang="ts">
+import { computed } from 'vue'
+
+import {
+  MBadge,
+  MListItem,
+  MTextButton,
+  MListCard,
+  makeSortOption,
+  makeCustomOptionsFilter,
+  makeSearchFilter,
+  type SortOption,
+  type Filter,
+} from '@metaplay/meta-ui-next'
+import { useSubscription } from '@metaplay/subscriptions'
+
+import { FontAwesomeIcon } from '@fortawesome/vue-fontawesome'
+
+import { useCoreStore } from '../../coreStore'
+import { getStaticConfigSubscriptionOptions } from '../../subscription_options/general'
+
+/**
+ * Interface for reference data passed to the component.
+ */
+export interface ReferenceData {
+  /**
+   * Type of the referencing entity.
+   */
+  type: string
+  /**
+   * Optional: Subtype of the referencing entity.
+   */
+  subtype?: string
+  /**
+   * ID of the referencing entity.
+   */
+  id: string
+  /**
+   * Display name of the referencing entity.
+   */
+  displayName: string
+}
+
+/**
+ * Internal interface for a single reference.
+ */
+interface ReferenceDetails {
+  /**
+   * Type of the referencing entity.
+   */
+  type: string
+  /**
+   * Display type for the referencing entity.
+   */
+  displayType: string
+  /**
+   * Display name of the referencing entity.
+   */
+  displayName: string
+  /**
+   * Icon to use for the referencing entity.
+   */
+  icon: string
+  /**
+   * Link URL to the referencing entity's detail page.
+   */
+  linkUrl: string
+  /**
+   * Link text for the referencing entity's detail page.
+   */
+  linkText: string
+}
+
+const props = defineProps<{
+  /**
+   * Reference data to display on the list.
+   */
+  referenceData: ReferenceData[]
+  /**
+   * Optional: Test id for the component.
+   */
+  dataTestid?: string
+}>()
+
+const coreStore = useCoreStore()
+
+/**
+ * Fetching static config data for activables metadata.
+ */
+const { data: staticConfigData } = useSubscription(getStaticConfigSubscriptionOptions())
+
+/**
+ * Utility computed to get the "selected" segment's metadata.
+ */
+const activablesMetadata = computed(() => {
+  return staticConfigData.value?.activablesMetadata
+})
+
+/**
+ * Unique key for each reference item.
+ */
+const getItemKey = (item: ReferenceDetails): string => {
+  return `${item.type}-${item.displayName}`
+}
+
+/**
+ * Sort options for the reference list.
+ */
+const sortOptions: Array<SortOption<ReferenceDetails>> = [
+  makeSortOption('Type', 'A-Z', 'Z-A', (item: ReferenceDetails) => item.type),
+  makeSortOption('Name', 'A-Z', 'Z-A', (item: ReferenceDetails) => item.displayName),
+]
+
+/**
+ * All possible reference types.
+ */
+const referenceTypes = computed(() => {
+  const builtinCategoryNames = ['Offer', 'Broadcast', 'Experiment', 'Notification', 'Segment', 'LiveOps Event']
+  const activableCategoryNames = Object.values(activablesMetadata.value?.categories ?? {}).map(
+    (category) => category.shortSingularDisplayName
+  )
+  return [...builtinCategoryNames, ...activableCategoryNames].sort((a, b) => a.localeCompare(b))
+})
+
+/**
+ * Generate custom filters for the reference list.
+ */
+function getCustomFilters(): Array<Filter<ReferenceDetails>> {
+  const filters: Array<Filter<ReferenceDetails>> = [
+    makeSearchFilter((item: ReferenceDetails) => [item.type, item.displayType ?? '', item.displayName]),
+    makeCustomOptionsFilter(
+      'Type',
+      referenceTypes.value.map((value) => ({
+        label: value,
+        // Use displayType for activables, type for others.
+        filterFn: (item: ReferenceDetails): boolean => item.type === value || item.displayType === value,
+      }))
+    ),
+  ]
+
+  return filters
+}
+
+/**
+ * Decorated reference list with additional metadata.
+ */
+const decoratedReferenceList = computed((): ReferenceDetails[] => {
+  return props.referenceData.map((referenceSource: ReferenceData) => {
+    switch (referenceSource.type) {
+      case 'Activable':
+        return getActivableReferenceDetails(referenceSource)
+      case 'Offer':
+        return {
+          type: referenceSource.type,
+          displayType: referenceSource.type,
+          displayName: referenceSource.displayName,
+          icon: 'tag',
+          linkUrl: `/offerGroups/offer/${referenceSource.id}`,
+          linkText: referenceSource.type,
+        }
+      case 'Broadcast':
+        return {
+          type: referenceSource.type,
+          displayType: referenceSource.type,
+          displayName: referenceSource.displayName,
+          icon: 'broadcast-tower',
+          linkUrl: `/broadcasts/${referenceSource.id}`,
+          linkText: referenceSource.type,
+        }
+      case 'Experiment':
+        return {
+          type: referenceSource.type,
+          displayType: referenceSource.type,
+          displayName: referenceSource.displayName,
+          icon: 'flask',
+          linkUrl: `/experiments/${referenceSource.id}`,
+          linkText: referenceSource.type,
+        }
+      case 'Notification':
+        return {
+          type: referenceSource.type,
+          displayType: referenceSource.type,
+          displayName: referenceSource.displayName,
+          icon: 'comment-alt',
+          linkUrl: `/notifications/${referenceSource.id}`,
+          linkText: referenceSource.type,
+        }
+      case 'Segment':
+        return {
+          type: referenceSource.type,
+          displayType: referenceSource.type,
+          displayName: referenceSource.displayName,
+          icon: 'user-tag',
+          linkUrl: `/segments/${referenceSource.id}`,
+          linkText: referenceSource.type,
+        }
+      case 'LiveOpsEvent':
+        return {
+          type: referenceSource.type,
+          displayType: 'LiveOps Event',
+          displayName: referenceSource.displayName,
+          icon: 'calendar-alt',
+          linkUrl: `/liveOpsEvents/${referenceSource.id}`,
+          linkText: 'event',
+        }
+      default:
+        return {
+          type: referenceSource.type,
+          displayType: referenceSource.type,
+          displayName: referenceSource.displayName,
+          icon: 'question-circle',
+          linkUrl: '',
+          linkText: '',
+        }
+    }
+  })
+})
+
+/**
+ * Get reference details for an activable reference.
+ */
+function getActivableReferenceDetails(referenceSource: ReferenceData): ReferenceDetails {
+  if (!referenceSource.subtype) {
+    throw new Error(`Activable reference is missing subtype information!`)
+  }
+  const kindId = referenceSource.subtype
+  const categoryId = activablesMetadata.value?.kinds?.[kindId]?.category
+  if (!categoryId) throw new Error(`Activable kind '${kindId}' is not defined in the metadata!`)
+  const categoryName = activablesMetadata.value?.categories[categoryId]?.shortSingularDisplayName
+  const urlPathName = `/${coreStore.gameSpecific.activableCustomization[categoryId]?.pathName ?? `activables/${categoryId}`}`
+  return {
+    type: categoryId,
+    displayType: categoryName ?? categoryId,
+    displayName: referenceSource.displayName,
+    icon: coreStore.gameSpecific.activableCustomization[categoryId]?.icon ?? 'calendar-alt',
+    linkUrl: `${urlPathName}/${kindId}/${referenceSource.id}`,
+    linkText: categoryName ?? categoryId,
+  }
+}
+</script>
