+<!-- This file is part of Metaplay SDK which is released under the Metaplay SDK License. -->
+
+<!--
+  Displays a standard warning/disclaimer for dangerous or irreversible actions.
+
+  Use this component to alert users before destructive operations like deleting data,
+  resetting configurations, or performing irreversible administrative actions.
+  The warning includes a bold title and optional target name highlighting.
+
+  The default slot allows you to add custom content below the warning message.
+
+  Accepts 'class' and 'style' attributes for positioning and custom styling.
+-->
+
+<template lang="pug">
+MCallout(
+  v-bind="$attrs"
+  :class="$attrs.class"
+  title="No Seatbelts!"
+  )
+  template(#icon)
+    svg(
+      xmlns="http://www.w3.org/2000/svg"
+      viewBox="0 0 20 20"
+      fill="currentColor"
+      class="tw-size-4 tw-text-orange-500"
+      aria-hidden="true"
+      )
+      path(
+        class="tw-text-orange-500"
+        fill-rule="evenodd"
+        d="M10 2L2 18h16L10 2z"
+        clip-rule="evenodd"
+        )
+      path(
+        class="tw-text-orange-50"
+        fill-rule="evenodd"
+        d="M9 6h2v6H9V6zm0 8h2v2H9v-2z"
+        clip-rule="evenodd"
+        )
+
+  p
+    slot This action can't be undone.
+  span(
+    v-if="targetName"
+    class="tw-space-x-1"
+    ) Are you sure #[MBadge(variant="warning") {{ targetName }}] is ok with this?
+</template>
+
+<script lang="ts" setup>
+import MBadge from '../primitives/MBadge.vue'
+import MCallout from '../primitives/MCallout.vue'
+
+defineOptions({
+  inheritAttrs: false,
+})
+
+defineProps<{
+  /**
+   * Optional: The name of the target that an action is being performed upon. Causes a personalized warning message to
+   * be added to the callout, e.g. "Are you sure Player123 is ok with this?".
+   */
+  targetName?: string
+}>()
+</script>
