+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+using Metaplay.Core.Config;
+using NUnit.Framework;
+using System.Text;
+
+namespace Metaplay.Core.Tests
+{
+    public class SpreadsheetTests
+    {
+        [Test]
+        public void TestParseSpreadsheet()
+        {
+            string content =
+                "A;B\n" +
+                "1;2";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells.Count == 2);
+            Assert.That(spreadsheet.Cells[0].Count == 2);
+            Assert.That(spreadsheet.Cells[1].Count == 2);
+            Assert.That(spreadsheet.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheet.Cells[0][1].Value, Is.EqualTo("B"));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo("1"));
+            Assert.That(spreadsheet.Cells[1][1].Value, Is.EqualTo("2"));
+            Assert.That(spreadsheet.Cells[0][0].Row, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[0][1].Row, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[1][0].Row, Is.EqualTo(1));
+            Assert.That(spreadsheet.Cells[1][1].Row, Is.EqualTo(1));
+            Assert.That(spreadsheet.Cells[0][0].Column, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[0][1].Column, Is.EqualTo(1));
+            Assert.That(spreadsheet.Cells[1][0].Column, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[1][1].Column, Is.EqualTo(1));
+        }
+
+        [Test]
+        public void TestQuotedCell()
+        {
+            string content =
+                "A;\"B;C\"\n" +
+                "\"1\";\"2\"";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheet.Cells[0][1].Value, Is.EqualTo("B;C"));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo("1"));
+            Assert.That(spreadsheet.Cells[1][1].Value, Is.EqualTo("2"));
+        }
+
+        [Test]
+        public void TestQuotedCellWithQuoteInside()
+        {
+            string content =
+                "A;\"B\"\"C\"\n" +
+                "\"1\"\"2\";\"3\"\n";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheet.Cells[0][1].Value, Is.EqualTo("B\"C"));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo("1\"2"));
+            Assert.That(spreadsheet.Cells[1][1].Value, Is.EqualTo("3"));
+        }
+
+        [Test]
+        public void TestCommentLine()
+        {
+            string content =
+                "A;B\n" +
+                "// This is a comment\n" +
+                "1;2\n";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells.Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[0].Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[1].Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheet.Cells[0][1].Value, Is.EqualTo("B"));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo("1"));
+            Assert.That(spreadsheet.Cells[1][1].Value, Is.EqualTo("2"));
+            Assert.That(spreadsheet.Cells[0][0].Row, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[0][1].Row, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[1][0].Row, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[1][1].Row, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[0][0].Column, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[0][1].Column, Is.EqualTo(1));
+            Assert.That(spreadsheet.Cells[1][0].Column, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[1][1].Column, Is.EqualTo(1));
+        }
+
+        [Test]
+        public void TestCommentColumn()
+        {
+            string content =
+                "A;// comment;B\n" +
+                "1;2;3\n";
+            SpreadsheetContent spreadsheet = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(content));
+
+            Assert.That(spreadsheet.Cells.Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[0].Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[1].Count, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheet.Cells[0][1].Value, Is.EqualTo("B"));
+            Assert.That(spreadsheet.Cells[1][0].Value, Is.EqualTo("1"));
+            Assert.That(spreadsheet.Cells[1][1].Value, Is.EqualTo("3"));
+            Assert.That(spreadsheet.Cells[0][0].Row, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[0][1].Row, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[1][0].Row, Is.EqualTo(1));
+            Assert.That(spreadsheet.Cells[1][1].Row, Is.EqualTo(1));
+            Assert.That(spreadsheet.Cells[0][0].Column, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[0][1].Column, Is.EqualTo(2));
+            Assert.That(spreadsheet.Cells[1][0].Column, Is.EqualTo(0));
+            Assert.That(spreadsheet.Cells[1][1].Column, Is.EqualTo(2));
+        }
+
+        [Test]
+        public void TestDifferentNewlines()
+        {
+            // Test \r\n (Windows)
+            string contentCrLf = "A;B\r\n1;2";
+            SpreadsheetContent spreadsheetCrLf = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(contentCrLf));
+
+            Assert.That(spreadsheetCrLf.Cells.Count, Is.EqualTo(2));
+            Assert.That(spreadsheetCrLf.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheetCrLf.Cells[1][0].Value, Is.EqualTo("1"));
+
+            // Test \n (Unix)
+            string contentLf = "A;B\n1;2";
+            SpreadsheetContent spreadsheetLf = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(contentLf));
+
+            Assert.That(spreadsheetLf.Cells.Count, Is.EqualTo(2));
+            Assert.That(spreadsheetLf.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheetLf.Cells[1][0].Value, Is.EqualTo("1"));
+
+            // Test \r (old Mac)
+            string contentCr = "A;B\r1;2";
+            SpreadsheetContent spreadsheetCr = SpreadsheetContent.ParseCsv("test.csv", Encoding.UTF8.GetBytes(contentCr));
+
+            Assert.That(spreadsheetCr.Cells.Count, Is.EqualTo(2));
+            Assert.That(spreadsheetCr.Cells[0][0].Value, Is.EqualTo("A"));
+            Assert.That(spreadsheetCr.Cells[1][0].Value, Is.EqualTo("1"));
+        }
