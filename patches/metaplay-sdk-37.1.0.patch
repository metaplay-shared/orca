new file mode 100644
index 0000000..7cc3505
--- /dev/null
+++ b/MetaplaySDK/Frontend/BrowserSdk/src/companyAccountsUtils.ts
@@ -0,0 +1,102 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+/**
+ * Information about player's account in the company accounts API.
+ */
+export interface CompanyAccountInfo {
+  /**
+   * Player's company account ID.
+   */
+  accountId: string
+  // TODO: add at least the following fields:
+  // - accountName
+}
+
+/**
+ * Perform a login via a redirect to the login page.
+ */
+export function loginWithRedirect (accountApiUrl: string) {
+  const url = `${accountApiUrl}/ingameLogin?return_to=${window.location.href}`
+  window.location.href = url
+}
+
+/**
+ * Perform a login via a popup window.
+ * @param accountApiUrl The URL of the company accounts API.
+ * @param width Optional: The width of the popup window. Defaults to 600.
+ * @param height Optional: The height of the popup window. Defaults to 600.
+ * @returns The popup window object.
+ */
+export function loginWithPopup (accountApiUrl: string, width?: number, height?: number) {
+  const defaultWidth = 400
+  const defaultHeight = 520
+
+  const popupLoginUrl = `${accountApiUrl}/ingameLogin?return_to=${accountApiUrl}/popupFlowCompleted`
+
+  const left = (screen.width - (width ?? defaultWidth)) / 2
+  const top = (screen.height - (height ?? defaultHeight)) / 2
+  const loginPopup = window.open(popupLoginUrl, 'loginPopupWindow', `modal=yes, left=${left}, top=${top}, width=${width ?? defaultWidth}, height=${height ?? defaultHeight}, toolbar=no, resizable=no`)
+
+  if (!loginPopup) throw Error('Unable to open the login popup window.')
+
+  loginPopup.focus()
+  loginPopup.postMessage('Metaplay:Hello', '*')
+
+  return loginPopup
+}
+
+/**
+ * Perform a logout via a redirect.
+ */
+export function logoutWithRedirect (accountApiUrl: string) {
+  const logoutUrl = `${accountApiUrl}/logout?return_to=${window.location.href}`
+  window.location.href = logoutUrl
+}
+
+/**
+ * Fetch currently logged in user's account info from the company account API.
+ * Note: This API highly likely evolve as we figure out what is the minimum amount of information we need. There might be another API for fetching the full account info.
+ */
+export async function getCompanyAccountInfo (accoutApiUrl: string): Promise<CompanyAccountInfo | undefined> {
+  try {
+    // Rely on browser cache to avoid unnecessary fetches.
+    const response = await fetch(`${accoutApiUrl}/accountInfo`, {
+      method: 'GET',
+      mode: 'cors',
+      credentials: 'include',
+      cache: 'default'
+    })
+
+    // TODO: Error handling.
+
+    const accountInfo = await response.json() as CompanyAccountInfo
+
+    // Note: The account ID property is null if the user is not logged in. We prefer to return undefined in that case.
+    if (!accountInfo.accountId) return undefined
+    return accountInfo
+  } catch (error) {
+    throw Error(`Failed to get account info from '${accoutApiUrl}/accountInfo'. Error: ${error}`)
+  }
+}
+
+/**
+ * Fetch a game server access token from the company accounts API.
+ * @returns Promise of the token ID string.
+ */
+export async function getGameServerAccessToken (accoutApiUrl: string, projectName: string, projectEnvironment: string): Promise<string> {
+  // Rely on browser cache to avoid unnecessary fetches.
+  const tokenResponse = await fetch(`${accoutApiUrl}/tokenForGameWebAccess?project=${projectName}&env=${projectEnvironment}`, {
+    method: 'GET',
+    mode: 'cors',
+    credentials: 'include',
+    cache: 'default'
+  })
+
+  // Check the response.
+  if (tokenResponse.status === 200) {
+    const token = await tokenResponse.text()
+    return token
+  } else {
+    throw Error(`Unable to get an access token from AccountApi to access the game server. AccountApi responded with code ${tokenResponse.status}`)
+  }
+}
