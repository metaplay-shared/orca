+   * @param retryCount How many times to retry clicking.
+   */
+  function clickDataTestid(dataTestId: string, retryCount: number): void {
+    if (retryCount > 0) {
+      const el = document.querySelector(`[data-testid="${dataTestId}"]`)
+      const contentContainer = document.querySelector('[data-testid="page-content-container"]')
+      if (el && contentContainer) {
+        const htmlEl = el as HTMLElement
+        htmlEl?.click()
+      } else {
+        // Try again in 500ms.
+        setTimeout(() => {
+          clickDataTestid(dataTestId, retryCount - 1)
+        }, 500)
+      }
+    }
+  }
+
+  /**
+   * Offset of an element relative to a scrollable ancestor.
+   */
+  function getRelativeOffset(parentWindow: Element, elem: HTMLElement): number {
+    let offset = 0
+
+    let childWindow = elem
+    while (childWindow !== parentWindow) {
+      offset += childWindow.offsetTop
+      childWindow = childWindow.offsetParent as HTMLElement
+    }
+
+    return offset
+  }
