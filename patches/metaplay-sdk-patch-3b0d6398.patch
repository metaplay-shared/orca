index 00000000..a1ba752a
--- /dev/null
+++ b/MetaplaySDK/Frontend/BrowserSdk/src/index.ts
@@ -0,0 +1,191 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+import {
+  type UnityRuntime,
+  type UnityRuntimeOptions,
+  type UnityRuntimeBridge,
+  type GameSpecificApiBridges,
+  initializeUnityRuntimeBridge,
+} from './unityRuntimeUtils'
+
+import {
+  type CompanyAccountInfo,
+  getCompanyAccountInfo,
+  getGameServerAccessToken,
+  loginWithPopup as internalLoginWithPopup,
+  loginWithRedirect as internalLoginWithRedirect,
+  logoutWithRedirect as internalLogoutWithRedirect,
+} from './companyAccountsUtils'
+
+export type { UnityRuntime, GameSpecificApiBridges } from './unityRuntimeUtils'
+export type { CompanyAccountInfo } from './companyAccountsUtils'
+
+/**
+ * Initialization options for the Unity runtime bridge.
+ */
+export type UnityRuntimeInitializationOptions = Omit<UnityRuntimeOptions, 'companyAccountsSelfServeUrl'> // Server url is omited here and instead we use the one from the browser sdk client to avoid typos.
+
+/**
+ * Initializes and returns the browser SDK client. Ideally you should have only one instance
+ * of the client in your web application and use your preferred state management pattern to share it between components.
+ * @param companyAccountsSelfServeUrl Full URL to the company accounts server.
+ */
+export async function initializeBrowserSdkClient (companyAccountsSelfServeUrl: string) {
+  // Local state ------------------------------------------------------------------------------------------------------
+
+  let loginPopup: Window | undefined
+
+  /**
+   * Internal instance of the current company account info. Undefined if not logged in.
+   */
+  let currentAccount: CompanyAccountInfo | undefined
+
+  /**
+   * Internal instance of the Unity runtime bridge. This is initialized manually if needed.
+   */
+  let unityRuntimeBridge: UnityRuntimeBridge<unknown> | undefined
+
+  /**
+   * Userland event handler for company account changes.
+   */
+  let onAccountChanged: ((accountInfo: CompanyAccountInfo | undefined) => void) | undefined
+
+  /**
+   * Helper function to get the Unity runtime bridge after it has been initialized. Throws an error if the bridge has not been initialized yet.
+   */
+  function getUnityRuntimeBridge () {
+    if (!unityRuntimeBridge) throw new Error('Unity runtime bridge has not been initialized yet. You need to call `initializeUnityRuntimeBridge()` first.')
+    return unityRuntimeBridge
+  }
+
+  // Initialization ---------------------------------------------------------------------------------------------------
+
+  // Add a listener for messages from the login popup.
+  window.addEventListener('message', function (event) {
+    if (event.data === 'Metaplay:LoginCompleted') {
+      loginPopup?.close()
+      loginPopup = undefined
+      void refreshCompanyAccountInfo()
+    }
+  })
+
+  // We may be already logged in here because of redirects or a previous login. Refresh immediately.
+  await refreshCompanyAccountInfo()
+
+  // Functions ----------------------------------------------------------------------------------------------------------
+
+  /**
+   * Make an authenticated fetch() request to the game server by first getting a fresh access token from the company accounts API.
+   * @param url Full path to the game server endpoint to call.
+   * @param projectName Name of the project to get the access token for.
+   * @param projectEnvironment Name of the project environment to get the access token for.
+   * @param params Optional: Parameters to pass to the `Fetch()` call.
+   * @returns Result of the fetch.
+   */
+  // Note: EsLint is disabled here because it was confused about the `RequestInit` type.
+  // eslint-disable-next-line no-undef
+  async function fetchResourceFromGameServerByUrl (url: string, projectName: string, projectEnvironment: string, userParams: RequestInit = {}): Promise<Response> {
+    // Ensure we have a fresh access token. This gets cached in the browser so it's okay to do it for each request.
+    const accessToken = await getGameServerAccessToken(companyAccountsSelfServeUrl, projectName, projectEnvironment)
+
+    // Include default params and inject the authorization token
+    // Note: EsLint is disabled here because it was confused about the `RequestInit` type.
+    // eslint-disable-next-line no-undef
+    const params: RequestInit = {
+      mode: 'cors',
+      credentials: 'include',
+      cache: 'default',
+      ...userParams,
+      headers: { ...userParams.headers ?? {}, Authorization: `Bearer ${accessToken}` }
+    }
+
+    // Make the request and return the raw result.
+    return await fetch(url, params)
+  }
+
+  /**
+   * Refresh current company account info by fetching new data from the accounts API and passing messages to listeners.
+   */
+  async function refreshCompanyAccountInfo () {
+    // Get new account info.
+    const newAccount = await getCompanyAccountInfo(companyAccountsSelfServeUrl)
+
+    // TODO: Error handling.
+
+    // If the account has changed...
+    if (newAccount?.accountId !== currentAccount?.accountId) {
+      // Save new info.
+      currentAccount = newAccount
+
+      // TODO: This is not assigned anywhere. Should it? Is this just for the cache? If so, we should not await it.
+      // await getGameServerAccessToken(companyAccountsSelfServeUrl, options.projectName, options.projectEnvironment)
+
+      // Inform the unity runtime listener.
+      if (unityRuntimeBridge) {
+        unityRuntimeBridge.CompanyAccountWebGLApiBridge.AccountChanged('')
+      }
+
+      // Inform browser listener.
+      if (onAccountChanged) {
+        onAccountChanged(currentAccount)
+      }
+    }
+
+    return currentAccount
+  }
+
+  // Event handling functions -------------------------------------------------------------------------------------------
+
+  /**
+   * Add a function that gets called on account changes. Remember to call `unsubscribeFromEvents` manually when the subscriber is no longer needed.
+   * @param eventHandler The event handler function to call when account changes occur.
+   * @returns The current state of the account at the time of subscription. Use this as the initial state in your app. Returns `undefined` if the account is not logged in.
+   */
+  function subscribeToAccountChanged (_onAccountChanged: (accountInfo: CompanyAccountInfo | undefined) => void): CompanyAccountInfo | undefined {
+    // Save the event handler.
+    onAccountChanged = _onAccountChanged
+
+    return currentAccount
+  }
+
+  /**
+   * Unsubscribe from receiving events.
+   * @param eventHandlerId ID previously returned from `subscribeToEvents`.
+   */
+  function unsubscribeFromAccountChanged () {
+    if (!onAccountChanged) {
+      console.warn('Trying to unsubscribe from account changes but no event handler was registered.')
+    } else {
+      onAccountChanged = undefined
+    }
+  }
+
+  // Public interface -------------------------------------------------------------------------------------------------
+
+  return {
+    /**
+     * Perform a login via a redirect to the login page.
+     */
+    loginWithRedirect: () => internalLoginWithRedirect(companyAccountsSelfServeUrl),
+    /**
+     * Perform a login via a popup window.
+     * @param width Optional: The width of the popup window. Defaults to 600.
+     * @param height Optional: The height of the popup window. Defaults to 600.
+     * @returns The popup window object.
+     */
+    loginWithPopup: (width?: number, height?: number) => {
+      loginPopup = internalLoginWithPopup(companyAccountsSelfServeUrl, width, height)
+    },
+    /**
+     * Perform a logout via a redirect.
+     */
+    logoutWithRedirect: () => internalLogoutWithRedirect(companyAccountsSelfServeUrl),
+    refreshCompanyAccountInfo,
+    subscribeToAccountChanged,
+    unsubscribeFromAccountChanged,
+    fetchResourceFromGameServerByUrl,
+    // Inject the company accounts server url into the unity runtime bridge initialization options to make sure they are the same.
+    initializeUnityRuntimeBridge: async <T>(unityRuntime: UnityRuntime, options: UnityRuntimeInitializationOptions, gameSpecificApiBridges: GameSpecificApiBridges): Promise<T> => await initializeUnityRuntimeBridge<T>(unityRuntime, { ...options, companyAccountsSelfServeUrl }, gameSpecificApiBridges),
+    getUnityRuntimeBridge,
+  }
+}
