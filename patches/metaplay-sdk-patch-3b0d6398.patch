@@ -0,0 +1,148 @@
+// This file is part of Metaplay SDK which is released under the Metaplay SDK License.
+
+// Types --------------------------------------------------------------------------------------------------------------
+
+/**
+ * Configuration options for the Unity runtime bridge. These options are passed to the Unity runtime and need to match
+ * the configuration in the Unity project.
+ */
+export interface UnityRuntimeOptions {
+  gameServerSelfServeUrl: string
+  companyAccountsSelfServeUrl: string
+  projectName: string
+  projectEnvironment: string
+}
+
+/**
+ * Response object for `CompanyAccountWebGLApiBridge.GetWebTokenAsync`.
+ */
+interface GetWebTokenAsyncResponse {
+  status: number
+  content: string
+}
+
+interface UnityRuntimeBridgeCore {
+  MetaplayApp: {
+    args: UnityRuntimeOptions
+    OnInitialized?: unknown
+  } | undefined
+  CompanyAccountWebGLApiBridge: {
+    GetWebTokenAsync: () => Promise<GetWebTokenAsyncResponse>
+    OpenLoginPage: (loginServiceUrl: string) => void // TODO: needed?
+    OpenManagementPage: (managementUrl: string) => void // TODO: needed?
+    AccountChanged: (dummy: string) => void
+  }
+  BrowserSdkClient: unknown
+  IsInitialized: unknown
+}
+
+/**
+ * Metaplay's Unity runtime interface that can be called from JavaScript.
+ */
+export interface UnityRuntimeBridge<T> extends UnityRuntimeBridgeCore {}
+
+/**
+ * Game-specific API methods that are callable across the JavaScript <-> C# API bridge.
+ */
+export interface GameSpecificApiBridges {
+  [key: string]: {
+    [key: string]: (...args: any[]) => any
+  }
+}
+
+/**
+ * Interface for the Unity runtime JavaScript that gets generated during Unity WebGL build.
+ * See: https://docs.unity3d.com/Manual/webgl-templates.html
+ */
+export interface UnityRuntime {
+  /**
+   * The SetFullscreen method toggles full screen mode.
+   * @param fullscreen 1 to enable fullscreen mode, 0 to disable.
+   */
+  SetFullscreen: (fullscreen: 1 | 0) => void
+  /**
+   * The SendMessage method sends messages to the GameObjects.
+   * @param objectName Name of the object in your scene.
+   * @param methodName Name of a method in the script, currently attached to the object.
+   * @param value Optional: Data to send to the method.
+   */
+  SendMessage: (objectName: string, methodName: string, value?: string | number) => void
+  /**
+   * Use this method to quit the runtime and clean up the memory used by the Unity instance.
+   * @returns A promise that completes after the build runtime has quit.
+   */
+  Quit: () => Promise<() => void>
+  /**
+   * Access to internal modules. One of which is MetaplayApiBridge.
+   * TODO: Proper typings and naming.
+   */
+  Module: {
+    MetaplayApiBridge: UnityRuntimeBridge<unknown>
+    [name: string]: unknown
+  }
+}
+
+// Functions ----------------------------------------------------------------------------------------------------------
+
+/**
+ * Initializes the MetaplayApiBridge module in the Unity runtime and returns a local client that can be used to call methods on it.
+ * @param unityRuntime The Unity runtime object to connect to.
+ */
+export async function initializeUnityRuntimeBridge<T> (unityRuntime: UnityRuntime, options: UnityRuntimeOptions, gameApiBridges: GameSpecificApiBridges) {
+  if (!unityRuntime.Module.MetaplayApiBridge) throw Error('MetaplayApiBridge module not found in Unity runtime.')
+
+  const unityRuntimeBridge: UnityRuntimeBridge<T> = unityRuntime.Module.MetaplayApiBridge // TODO: Strong typings for this.
+
+  if (unityRuntimeBridge.MetaplayApp) throw Error('MetaplayApp already exists in the Unity runtime. Duplicate initialization?')
+  if (unityRuntimeBridge.IsInitialized) throw Error('MetaplayApiBridge already initialized in Unity runtime. Duplicate initialization?')
+
+  unityRuntimeBridge.MetaplayApp = {
+    args: options // TODO: Update options namings to match. This will break currently.
+  }
+
+  // Override the default company accounts bridge methods with the ones from the browser SDK client.
+  unityRuntimeBridge.CompanyAccountWebGLApiBridge.GetWebTokenAsync = async () => await getGameTokenAsync(options)
+
+  // Register application-specific API bridges
+  if (gameApiBridges) {
+    // \todo [petri] fix type hack (needed for the write-by-string-key)
+    const gameSpecificApiBridges = unityRuntimeBridge as unknown as GameSpecificApiBridges
+    for (const bridgeName in gameApiBridges) {
+      gameSpecificApiBridges[bridgeName] = gameApiBridges[bridgeName]
+    }
+  }
+
+  // Wait for the Unity runtime bridge to become initialized.
+  // eslint-disable-next-line @typescript-eslint/no-non-null-assertion -- We know this is not null anymore.
+  await new Promise((resolve, reject) => { unityRuntimeBridge.MetaplayApp!.OnInitialized = resolve })
+
+  if (!unityRuntimeBridge.IsInitialized) throw Error('Unity runtime bridge failed to initialize.')
+
+  // TODO: is there a way to not return the whole bridge, but only the game-specific part as defined by type T?
+
+  // All done.
+  return unityRuntimeBridge as T
+}
+
+/**
+ * Replacement implementation for `CompanyAccountWebGLApiBridge.GetWebTokenAsync`.
+ * @param getWebTokenAsyncRequest Request object.
+ * @returns Response wrapped in a promise.
+ */
+async function getGameTokenAsync (options: UnityRuntimeOptions): Promise<GetWebTokenAsyncResponse> {
+  const request = `${options?.companyAccountsSelfServeUrl}/gameauthWebGameToken?project=${options?.projectName}&env=${options?.projectEnvironment}&device=none`
+  const response = await fetch(request, {
+    method: 'GET',
+    mode: 'cors',
+    credentials: 'include',
+    cache: 'default'
+  })
+
+  // TODO: Error handling.
+
+  const content = await response.text()
+  return {
+    status: response.status,
+    content,
+  }
+}
