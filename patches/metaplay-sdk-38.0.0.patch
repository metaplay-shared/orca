diff --git a/MetaplaySDK/entrypoint/moon.yml b/MetaplaySDK/entrypoint/moon.yml
new file mode 100644
index 0000000..c8b8dbb
--- /dev/null
+++ b/MetaplaySDK/entrypoint/moon.yml
@@ -0,0 +1,103 @@
+$schema: https://moonrepo.dev/schemas/project.json
+# https://moonrepo.dev/docs/config/tasks
+
+language: go
+layer: application
+
+project:
+  description: 'Container entrypoint: process supervisor and Kubernetes health-probe proxy'
+
+tasks:
+  # Run the entrypoint's Go unit and integration tests. -coverpkg=./... instruments
+  # every package in each test binary and -coverprofile merges them into a single
+  # coverage.out, so the health_probe_proxy integration tests' exercise of the
+  # tinyhttp package is attributed (not just tinyhttp's own tests). Read the combined
+  # number — or gate on it — with `go tool cover -func=coverage.out`.
+  test:
+    command:
+      - go
+      - test
+      - '-coverpkg=./...'
+      - '-coverprofile=coverage.out'
+      - ./...
+    options:
+      runInCI: true
+    inputs:
+      - '**/*.go'
+      - go.mod
+    toolchains:
+      - go
+
+  # Build the statically linked entrypoint binaries (amd64 + arm64) into output/. Shells out
+  # to Docker (buildx + QEMU for arm64), so it uses the system toolchain and runs on Linux
+  # only. moon ci runs it when an input below is affected; the Moon CI workflow then installs
+  # QEMU and commits the rebuilt binaries back, so binaries that lag the sources are fixed
+  # automatically. `runInCI: only` keeps it out of local `moon check` and `moon run :build`,
+  # which would otherwise rewrite the committed binaries; run it by hand with
+  # `CI=true moon run Entrypoint:build`. See .moon/workspace.yml, evidence 11.
+  build:
+    command: ./build.sh
+    options:
+      runInCI: only
+      os:
+        - linux
+    inputs:
+      - '**/*.go'
+      - go.mod
+      - Dockerfile
+      - build.sh
+    outputs:
+      - output/entrypoint-amd64
+      - output/entrypoint-arm64
+    toolchains:
+      - system
+
+  # Static analysis across the module.
+  vet:
+    command: go vet ./...
+    options:
+      runInCI: true
+    inputs:
+      - '**/*.go'
+      - go.mod
+    toolchains:
+      - go
+
+  # Run the tests under the race detector. The race detector needs cgo (a C
+  # toolchain), so this is limited to Linux/macOS CI and skipped on Windows.
+  test-race:
+    command: go test -race ./...
+    env:
+      CGO_ENABLED: '1'
+    options:
+      runInCI: true
+      os:
+        - linux
+        - macos
+    inputs:
+      - '**/*.go'
+      - go.mod
+    toolchains:
+      - go
+
+  # Actively fuzz the differential oracle for a bounded time: it feeds random bytes
+  # to both net/http (the reference) and tinyhttp and asserts they agree on body
+  # framing, catching request-smuggling divergences as well as parser panics. The
+  # other fuzz targets' seed corpora run as ordinary tests in `test`.
+  fuzz:
+    command:
+      - go
+      - test
+      - '-run=^$'
+      - '-fuzz=^FuzzDifferentialRequestFraming$'
+      - '-fuzztime=20s'
+      - ./tinyhttp/
+    options:
+      runInCI: true
+      os:
+        - linux
+        - macos
+    inputs:
+      - tinyhttp/**/*.go
+    toolchains:
+      - go
