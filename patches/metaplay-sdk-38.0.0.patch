+
+        // METAPLAY_CHANGED: Added custom method
+        static void CopyPreviousValuesToEmptyCells(SpreadsheetContent sheet)
+        {
+            for (int rowNdx = 1; rowNdx < sheet.Cells.Count; rowNdx++)
+            {
+                List<SpreadsheetCell> previousRow = sheet.Cells[rowNdx - 1];
+                List<SpreadsheetCell> row         = sheet.Cells[rowNdx];
+                if (previousRow.Count > 0 && row.Count > 0 && previousRow[0].Value == row[0].Value)
+                {
+                    for (int colNdx = 0; colNdx < previousRow.Count; colNdx++)
+                    {
+                        if (colNdx >= row.Count)
+                        {
+                            row.Add(new SpreadsheetCell("", rowNdx, colNdx));
+                        }
+
+                        string value = row[colNdx].Value;
+                        if (value.Length == 0 && rowNdx > 1)
+                        {
+                            // \note: this copies the source data location too
+                            row[colNdx] = colNdx < previousRow.Count ? previousRow[colNdx] : new SpreadsheetCell("", rowNdx, colNdx);
+                        }
+
+                        if (value.Equals("-"))
+                        {
+                            row[colNdx] = new SpreadsheetCell("", rowNdx, colNdx);
+                        }
+                    }
+                }
+                else
+                {
+                    for (int colNdx = 0; colNdx < row.Count; colNdx++)
+                    {
+                        string value = row[colNdx].Value;
+                        if (value.Equals("-"))
+                        {
+                            row[colNdx] = new SpreadsheetCell("", rowNdx, colNdx);
+                        }
+                    }
+                }
+            }
+        }
+
+        // METAPLAY_CHANGED: Added custom method
+        // As a result of CopyPreviousValuesToEmptyCells some rows may be left completely empty. Remove them.
+        static void RemoveEmptyRows(SpreadsheetContent sheet)
+        {
+            for (int rowNdx = 1; rowNdx < sheet.Cells.Count; )
+            {
+                List<SpreadsheetCell> row   = sheet.Cells[rowNdx];
+                bool                  empty = true;
+                foreach (SpreadsheetCell cell in row)
+                {
+                    if (cell.Value.Length > 0)
+                    {
+                        empty = false;
+                        break;
+                    }
+                }
+
+                if (empty)
+                {
+                    sheet.Cells.RemoveAt(rowNdx);
+                }
+                else
+                {
+                    rowNdx++;
+                }
+            }
         }
 
